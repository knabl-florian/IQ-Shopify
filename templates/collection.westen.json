ox-sizing:border-box}\n.iq-reward-banner{position:relative;isolation:isolate;display:block;width:100%;max-width:none;margin:16px auto;background:#fff;color:#171717;aspect-ratio:30/11;border:0;border-radius:0;overflow:hidden}\n.iq-reward-banner picture,.iq-reward-banner img{display:block;width:100%;height:100%;margin:0;border:0;border-radius:0}\n.iq-reward-banner img{object-fit:contain}\n.iq-reward-banner__copy{position:absolute;z-index:1;left:47%;right:4%;top:50%;transform:translateY(-50%);min-width:0;text-align:left}\n.iq-reward-banner h2{margin:0;font:italic 800 clamp(24px,2.4vw,32px)/1.06 Montserrat,sans-serif;letter-spacing:-.035em;text-transform:uppercase;color:#171717;overflow-wrap:normal}\n.iq-reward-banner__copy>p{margin:14px 0 4px;max-width:360px;font:400 15px/1.55 Archivo,sans-serif;color:#171717}\n.iq-reward-banner__copy>a{display:inline-flex;align-items:center;gap:9px;min-height:44px;margin:5px 0 0;padding:0;color:#A51D1B;font:700 14px/1.4 Archivo,sans-serif;text-decoration:none}\n.iq-reward-banner__copy>a:hover{text-decoration:underline;text-underline-offset:4px}\n.iq-reward-banner__copy>a:focus-visible{outline:2px solid currentColor;outline-offset:3px}\n.iq-reward-banner svg{flex:none}\n#iq-westen-funktionen{scroll-margin-top:120px}\n@media(max-width:749px){\n  .iq-reward-banner{aspect-ratio:1;max-width:none;margin:12px auto}\n  .iq-reward-banner::after{content:\"\";position:absolute;inset:0;z-index:0;pointer-events:none;background:linear-gradient(0deg,rgba(23,23,23,.78),rgba(23,23,23,.25) 28%,transparent 56%)}\n  .iq-reward-banner__copy{left:6%;right:6%;top:auto;bottom:2%;transform:none;text-shadow:0 2px 8px #17171788}\n  .iq-reward-banner h2{font-size:clamp(23px,6.3vw,35px);line-height:1.03;color:#fff}\n  .iq-reward-banner__copy>p{display:none}\n  .iq-reward-banner__copy>a{margin-top:1px;font-size:13px;color:#fff}\n}\n</style>"
