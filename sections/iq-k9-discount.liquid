{% if collection.handle == 'k9-diensthundefuehrer-ausruestung' %}
{% liquid
 assign suffix = '_de'
 if request.locale.iso_code == 'en'
  assign suffix = '_en'
 endif
 assign heading_key = 'heading' | append: suffix
 assign terms_key = 'terms' | append: suffix
 assign button_key = 'button' | append: suffix
 assign note_key = 'note' | append: suffix
 assign contact = pages['contact'].url
 if contact == blank
  assign contact = routes.root_url | append: '/pages/contact' | replace: '//', '/'
 endif
%}
<div class="iq-k9-discount-band">
<section class="iq-k9-discount-line" aria-labelledby="iq-k9-title-{{ section.id }}">
  <div class="iq-k9-discount-line__copy">
    <p class="iq-k9-discount-line__title" id="iq-k9-title-{{ section.id }}"><span class="iq-k9-discount-line__amount">{{ section.settings.amount | escape }}</span> {{ section.settings[heading_key] | escape }}</p>
  </div>
  <details class="iq-k9-discount-line__details">
    <summary>{{ section.settings[button_key] | escape }} <span aria-hidden="true">→</span></summary>
    <p class="iq-k9-discount-line__terms">{{ section.settings[terms_key] | escape }}</p>
    <p>{{ section.settings[note_key] | escape }}</p>
    <a href="{{ contact }}">{% if request.locale.iso_code == 'en' %}Request discount{% else %}Rabatt anfragen{% endif %} <span aria-hidden="true">→</span></a>
  </details>
</section>
</div>
{% endif %}
{% stylesheet %}
.iq-k9-discount-band{width:100%;background:#F3F3F1;border-bottom:1px solid #DCDBD7}
.iq-k9-discount-line,.iq-k9-discount-line *{box-sizing:border-box}
.iq-k9-discount-line{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:0 28px;max-width:1440px;margin:0 auto;padding:6px 50px;color:#171717;font:400 14px/1.45 Archivo,sans-serif}
.iq-k9-discount-line p{margin:0}.iq-k9-discount-line__title{display:flex;align-items:center;gap:10px;min-height:44px;font:700 16px/1.4 Archivo,sans-serif}.iq-k9-discount-line__amount{color:#A51D1B;white-space:nowrap;font-size:20px}
.iq-k9-discount-line__details{max-width:360px}.iq-k9-discount-line__details summary{display:flex;align-items:center;gap:10px;min-height:44px;color:#171717;font-weight:700;cursor:pointer;list-style:none}.iq-k9-discount-line__details summary::-webkit-details-marker{display:none}.iq-k9-discount-line__details[open] summary span{transform:rotate(90deg)}.iq-k9-discount-line__details p{margin:4px 0 8px}.iq-k9-discount-line__details a{display:inline-flex;align-items:center;min-height:44px;color:#A51D1B;text-decoration:underline;text-underline-offset:3px;font-weight:700}.iq-k9-discount-line summary:focus-visible,.iq-k9-discount-line a:focus-visible{outline:2px solid #A51D1B;outline-offset:3px}
@media(max-width:749px){.iq-k9-discount-line{grid-template-columns:1fr;padding:8px 20px}.iq-k9-discount-line__title{font-size:15px;min-height:36px}.iq-k9-discount-line__details{max-width:none}.iq-k9-discount-line__details summary{font-size:14px}}
{% endstylesheet %}
{% schema %}
{
  "name": "IQ K9 Dienstrabatt",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "amount",
      "label": "Rabatt-Anzeige",
      "default": "10 %"
    },
    {
      "type": "paragraph",
      "content": "Nur auf der K9-Collection sichtbar. Die Anzeige richtet keinen Rabatt ein; Bedingungen und Prüfung müssen zur tatsächlichen Aktion passen."
    },
    {
      "type": "header",
      "content": "Deutsch"
    },
    {
      "type": "text",
      "id": "thanks_de",
      "label": "Dankeszeile (aktuell nicht angezeigt) · Deutsch",
      "default": "Als Dank für Deinen Dienst."
    },
    {
      "type": "text",
      "id": "heading_de",
      "label": "Überschrift · Deutsch",
      "default": "Diensthundeführer-Rabatt auf IQ Produkte"
    },
    {
      "type": "textarea",
      "id": "body_de",
      "label": "Zusatztext (aktuell nicht angezeigt) · Deutsch",
      "default": "Als aktiver Diensthundeführer erhältst Du 10 % Rabatt auf IQ Dogsport Produkte."
    },
    {
      "type": "textarea",
      "id": "terms_de",
      "label": "Bedingungen · Deutsch",
      "default": "Für aktive Diensthundeführer bei privatem Kauf. Fremdmarken ausgeschlossen."
    },
    {
      "type": "text",
      "id": "button_de",
      "label": "Aufklapptext · Deutsch",
      "default": "Voraussetzungen & Anfrage"
    },
    {
      "type": "textarea",
      "id": "note_de",
      "label": "Hinweis zur Prüfung · Deutsch",
      "default": "Wir prüfen Deine Berechtigung persönlich."
    },
    {
      "type": "header",
      "content": "English"
    },
    {
      "type": "text",
      "id": "thanks_en",
      "label": "Dankeszeile (aktuell nicht angezeigt) · Englisch",
      "default": "Thank you for your service."
    },
    {
      "type": "text",
      "id": "heading_en",
      "label": "Überschrift · Englisch",
      "default": "service dog handler discount on IQ products"
    },
    {
      "type": "textarea",
      "id": "body_en",
      "label": "Zusatztext (aktuell nicht angezeigt) · Englisch",
      "default": "Active service dog handlers receive 10% off IQ Dogsport products."
    },
    {
      "type": "textarea",
      "id": "terms_en",
      "label": "Bedingungen · Englisch",
      "default": "For active service dog handlers making a personal purchase. Other brands excluded."
    },
    {
      "type": "text",
      "id": "button_en",
      "label": "Aufklapptext · Englisch",
      "default": "Eligibility & request"
    },
    {
      "type": "textarea",
      "id": "note_en",
      "label": "Hinweis zur Prüfung · Englisch",
      "default": "We review your eligibility personally."
    }
  ],
  "presets": [
    {
      "name": "IQ K9 Dienstrabatt"
    }
  ]
}
{% endschema %}


