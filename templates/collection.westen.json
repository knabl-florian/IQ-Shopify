        "inline_custom_liquid_yghENq": {
          "type": "inline_custom_liquid",
          "disabled": true,
          "settings": {
            "position": 2,
            "position_mobile": 2,
            "width": "full",
            "custom_liquid": "<style>\n  .iq-vgl,\n  .iq-vgl * {\n    box-sizing: border-box;\n  }\n\n  .iq-vgl {\n    background: #F3F3F1;\n    padding: clamp(20px, 3vw, 32px);\n    color: #171717;\n  }\n\n  .iq-vgl .iq-vgl__h {\n    margin: 0 0 10px;\n    font-size: clamp(20px, 2vw, 26px);\n    line-height: 1.25;\n    font-weight: 700;\n    text-transform: uppercase;\n    color: #171717;\n  }\n\n  .iq-vgl .iq-vgl__sub {\n    width: 100%;\n    max-width: none;\n    margin: 0 0 24px;\n    font-size: 15px;\n    line-height: 1.6;\n    color: #505050;\n    opacity: 1;\n  }\n\n  .iq-vgl__grid {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 18px;\n  }\n\n  .iq-vgl__col {\n    display: flex;\n    flex-direction: column;\n    min-width: 0;\n    padding: 24px;\n    background: #FFFFFF;\n    border-radius: 6px;\n  }\n\n  .iq-vgl .iq-vgl__for {\n    margin: 0 0 8px;\n    font-size: 12px;\n    line-height: 1.4;\n    font-weight: 700;\n    letter-spacing: 1px;\n    text-transform: uppercase;\n    color: #A51D1B;\n  }\n\n  .iq-vgl .iq-vgl__name {\n    margin: 0 0 16px;\n    font-size: 19px;\n    line-height: 1.3;\n    font-weight: 700;\n    color: #171717;\n  }\n\n  .iq-vgl .iq-vgl__ul {\n    margin: 0;\n    padding: 0;\n    list-style: none;\n  }\n\n  .iq-vgl__ul li {\n    position: relative;\n    margin: 0 0 10px;\n    padding-left: 16px;\n    font-size: 15px;\n    line-height: 1.55;\n    color: #171717;\n  }\n\n  .iq-vgl__ul li::before {\n    content: \"\";\n    position: absolute;\n    top: 9px;\n    left: 0;\n    width: 5px;\n    height: 5px;\n    background: #A51D1B;\n  }\n\n  .iq-vgl .iq-vgl__link {\n    display: inline-flex;\n    align-items: center;\n    align-self: flex-start;\n    min-height: 44px;\n    margin-top: auto;\n    padding: 14px 0 4px;\n    font-size: 14px;\n    line-height: 1.5;\n    font-weight: 700;\n    color: #171717;\n    text-decoration: none;\n  }\n\n  .iq-vgl__link span {\n    border-bottom: 2px solid #A51D1B;\n    padding-bottom: 3px;\n  }\n\n  .iq-vgl .iq-vgl__link:hover {\n    color: #A51D1B;\n  }\n\n  .iq-vgl__link:focus-visible {\n    outline: 2px solid #A51D1B;\n    outline-offset: 5px;\n  }\n\n  @media (max-width: 749px) {\n    .iq-vgl {\n      padding: 22px 16px;\n    }\n\n    .iq-vgl .iq-vgl__sub {\n      margin-bottom: 20px;\n      font-size: 14px;\n    }\n\n    .iq-vgl__grid {\n      grid-template-columns: minmax(0, 1fr);\n      gap: 14px;\n    }\n\n    .iq-vgl__col {\n      padding: 20px;\n    }\n\n    .iq-vgl .iq-vgl__name {\n      font-size: 18px;\n    }\n\n    .iq-vgl__ul li {\n      font-size: 14px;\n    }\n  }\n</style>\n\n<div class=\"iq-vgl\">\n  {%- if request.locale.iso_code == 'en' -%}\n\n    <h2 class=\"iq-vgl__h\">All-year or summer vest?</h2>\n\n    <p class=\"iq-vgl__sub\">\n      Both offer a patented chest pocket, a large back pocket\n      and attachment points for the IQ ball pouch.\n      Choose the fabric that suits your training.\n    </p>\n\n    <div class=\"iq-vgl__grid\">\n      <div class=\"iq-vgl__col\">\n        <p class=\"iq-vgl__for\">All year round</p>\n        <h3 class=\"iq-vgl__name\">IQ Dogsport Vest 3.0</h3>\n\n        <ul class=\"iq-vgl__ul\">\n          <li>Hard-wearing, water-repellent outer fabric</li>\n          <li>Wear over a T-shirt, sweatshirt or jacket</li>\n          <li>For regular outdoor training throughout the year</li>\n        </ul>\n\n        <a\n          class=\"iq-vgl__link\"\n          href=\"/en/products/dog-sport-vest-3-0-patented-pocket-system\"\n        >\n          <span>View vest →</span>\n        </a>\n      </div>\n\n      <div class=\"iq-vgl__col\">\n        <p class=\"iq-vgl__for\">Warm training days</p>\n        <h3 class=\"iq-vgl__name\">IQ Summer Vest 3.0</h3>\n\n        <ul class=\"iq-vgl__ul\">\n          <li>Lighter outer fabric with mesh at shoulders and back</li>\n          <li>Airy construction for warm temperatures</li>\n          <li>Same pocket layout and training functions as the Dogsport Vest 3.0</li>\n        </ul>\n\n        <a\n          class=\"iq-vgl__link\"\n          href=\"/en/products/dog-sport-summer-vest-3-0-patented-pockets\"\n        >\n          <span>View summer vest →</span>\n        </a>\n      </div>\n    </div>\n\n  {%- else -%}\n\n    <h2 class=\"iq-vgl__h\">Ganzjahres- oder Sommerweste?</h2>\n\n    <p class=\"iq-vgl__sub\">\n      Beide bieten die patentierte Brusttasche, eine große Rückentasche\n      und die Befestigung für die IQ Balltasche.\n      Du wählst das Material, das zu Deinem Training passt.\n    </p>\n\n    <div class=\"iq-vgl__grid\">\n      <div class=\"iq-vgl__col\">\n        <p class=\"iq-vgl__for\">Fürs ganze Trainingsjahr</p>\n        <h3 class=\"iq-vgl__name\">IQ Hundesportweste 3.0</h3>\n\n        <ul class=\"iq-vgl__ul\">\n          <li>Strapazierfähiger, wasserabweisender Außenstoff</li>\n          <li>Über T-Shirt, Pullover oder Jacke tragbar</li>\n          <li>Für regelmäßiges Training draußen – durchs ganze Jahr</li>\n        </ul>\n\n        <a\n          class=\"iq-vgl__link\"\n          href=\"/products/iq-hundesportweste-3-0-unisex\"\n        >\n          <span>Zur Weste →</span>\n        </a>\n      </div>\n\n      <div class=\"iq-vgl__col\">\n        <p class=\"iq-vgl__for\">Für warme Trainingstage</p>\n        <h3 class=\"iq-vgl__name\">IQ Sommerweste 3.0</h3>\n\n        <ul class=\"iq-vgl__ul\">\n          <li>Leichter Außenstoff mit Mesh an Schultern und Rücken</li>\n          <li>Luftiger Aufbau für warme Temperaturen</li>\n          <li>Gleiche Taschenanordnung und Trainingsfunktionen wie die Hundesportweste 3.0</li>\n        </ul>\n\n        <a\n          class=\"iq-vgl__link\"\n          href=\"/products/iq-sommerweste-3-0-unisex\"\n        >\n          <span>Zur Sommerweste →</span>\n        </a>\n      </div>\n    </div>\n\n  {%- endif -%}\n</div>"
