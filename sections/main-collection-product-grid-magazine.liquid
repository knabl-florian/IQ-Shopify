<style>
   .collection-inline-video {
  width: 100%;
  overflow: hidden;
  border-radius: 12px;
  background: #000;
  position: relative;
}

.collection-inline-video__media,
.collection-inline-video__poster {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: inherit;
}
.collection-inline-video--fit-contain .collection-inline-video__media {
  object-fit: cover;
}

.collection-inline-video--fit-cover .collection-inline-video__media {
  object-fit: cover;
}

.collection-inline-video__poster {
  padding: 0;
  border: 0;
  cursor: pointer;
  background: #000;
  position: relative;
  overflow: hidden;
}

.collection-inline-block--full .collection-inline-video {
  max-height: 600px;
}

.collection-inline-block--2 .collection-inline-video {
  max-height: 450px;
}

.collection-inline-block--1 .collection-inline-video {
  max-height: 320px;
}

.collection-inline-video--16-9 {
  aspect-ratio: 16 / 9;
}

.collection-inline-video--4-3 {
  aspect-ratio: 4 / 3;
}

.collection-inline-video--1-1 {
  aspect-ratio: 1 / 1;
}

.collection-inline-video--9-16 {
  aspect-ratio: 9 / 16;
}

.collection-inline-video--adapt {
  aspect-ratio: 16 / 9;
}

.collection-inline-video__play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 64px;
  height: 64px;
  border-radius: 999px;
  background: rgba(0, 0, 0, 0.65);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26px;
  line-height: 1;
}

/* Desktop fullscreen fix */
.collection-inline-block:has(.collection-inline-video),
.collection-inline-video,
.collection-inline-video__media {
  transform: none !important;
}

.collection-inline-video__media:fullscreen {
  width: 100vw !important;
  height: 100vh !important;
  max-height: none !important;
  object-fit: contain !important;
  background: #000;
  border-radius: 0 !important;
}

.collection-inline-video__media:-webkit-full-screen {
  width: 100vw !important;
  height: 100vh !important;
  max-height: none !important;
  object-fit: contain !important;
  background: #000;
  border-radius: 0 !important;
}

@media screen and (max-width: 767px) {
  #ProductsList.f-grid-1-cols .collection-inline-block {
    grid-column: 1 / -1 !important;
    width: 100% !important;
  }
  .collection-inline-block--full .collection-inline-video,
  .collection-inline-block--2 .collection-inline-video,
  .collection-inline-block--1 .collection-inline-video {
    max-height: 70vh;
  }

  .collection-inline-video__play {
    width: 52px;
    height: 52px;
    font-size: 22px;
  } #ProductsList .product-card__image-wrapper motion-element {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
}
</style>
