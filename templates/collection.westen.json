            "width": "full",
            "custom_liquid": "{% if collection.handle == 'hundesport-westen' %}\n{% liquid\n  assign base = routes.root_url\n  assign last_char = base | slice: -1\n  unless last_char == '/'\n    assign base = base | append: '/'\n  endunless\n%}\n<section class=\"iq-duty-compact\" id=\"iq-westen-dienst\" aria-labelledby=\"iq-duty-heading\">\n  <div>\n    <h2 id=\"iq-duty-heading\">{% if request.locale.iso_code == 'en' %}IQ K9 · Duty vests{% else %}IQ K9 · Diensthundeführerwesten{% endif %}</h2>\n    <p>{% if request.locale.iso_code == 'en' %}With holster access and space for your duty gear.{% else %}Mit Holster-Zugriff und Platz für Deine Einsatzausrüstung.{% endif %}</p>\n  </div>\n  <a href=\"{{ base }}collections/k9-diensthundefuehrer-ausruestung\">\n    {% if request.locale.iso_code == 'en' %}K9 equipment{% else %}K9-Ausrüstung{% endif %}\n    <svg aria-hidden=\"true\" focusable=\"false\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg>\n  </a>\n</section>\n<style>\n.iq-duty-compact,.iq-duty-compact *{box-sizing:border-box}\n.iq-duty-compact{width:100%;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:16px 20px;margin:0;background:#FFFFFF;color:#171717;scroll-margin-top:110px}\n.iq-duty-compact>div{min-width:0}\n.iq-duty-compact h2{font:700 20px/1.3 Archivo,sans-serif;font-style:normal;letter-spacing:0;text-transform:none;margin:0 0 6px;color:#171717}\n.iq-duty-compact p{font:400 14px/1.5 Archivo,sans-serif;margin:0;color:#171717}\n.iq-duty-compact a{display:inline-flex;align-items:center;gap:8px;flex-shrink:0;min-height:44px;font:700 13px/1.4 Archivo,sans-serif;color:#A51D1B;text-decoration:none}\n.iq-duty-compact a:hover{text-decoration:underline;text-underline-offset:4px}\n.iq-duty-compact a:focus-visible{outline:2px solid #A51D1B;outline-offset:4px}\n.iq-duty-compact svg{display:block;flex-shrink:0}\n@media(max-width:749px){\n.iq-duty-compact{flex-direction:column;align-items:flex-start;gap:4px;padding:14px 20px}\n.iq-duty-compact h2{font-size:18px;margin-bottom:4px}\n.iq-duty-compact p{font-size:13px}\n}\n</style>\n{% endif %}"
          }
