            assign notfor = 'Nicht für warme Übergangstage.'
            assign link_label = 'MFJ 3.0 ansehen'
            assign search_q = 'MFJ 3.0'
            assign w1 = '20.000 mm'
            assign w2 = 'winddicht'
            assign w3 = 'versiegelte Nähte'
            assign heat_dots = '●●●●'
            assign heat_label = 'warm gefüttert'
            assign f1 = 'Herausnehmbare Futtertaschen'
            assign f2 = 'Große Rückentasche'
            assign f3 = 'Geriegelte Nähte'
            assign ideal = 'Robuste Begleitung für draußen mit Hund, besonders bei Kälte und Regen.'
