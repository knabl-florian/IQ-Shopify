            assign w1 = '20.000 mm'
            assign w2 = 'winddicht'
            assign w3 = 'versiegelte Nähte'
            assign heat_dots = '●●●●'
            assign heat_label = 'warm gefüttert'
            assign f1 = 'Patchflächen'
            assign f2 = 'Bodycam-Schlaufen'
            assign f3 = 'Holsterzugriff'
            assign ideal = 'Diensthundeführer und Behörden.'
            if lang == 'en'
