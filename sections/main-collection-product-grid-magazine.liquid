        {%- if search_q == blank -%}{%- assign search_q = short_title -%}{%- endif -%}
        {%- capture jacket_link -%}{{ routes.search_url }}?q={{ search_q | url_encode }}&type=product{%- endcapture -%}
        {%- capture img -%}{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 520 | image_tag: loading: 'lazy', widths: '260,520', sizes: '(max-width: 767px) 45vw, 260px', alt: p.title, class: 'iq-jv__img' }}{%- endif -%}{%- endcapture -%}
        {%- capture badge_svg -%}{%- case badge_icon -%}{%- when 'star' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l2.9 6.26 6.84.62-5.17 4.54 1.54 6.7L12 16.98 5.89 20.66l1.54-6.7L2.26 8.88l6.84-.62L12 2z"/></svg>{%- when 'shield' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2l7.5 3v6.2c0 4.7-3.2 9.1-7.5 10.6C7.7 20.3 4.5 15.9 4.5 11.2V5L12 2zm-1.1 13.7l5-5-1.5-1.5-3.5 3.5-1.6-1.6-1.5 1.5 3.1 3.1z"/></svg>{%- endcase -%}{%- endcapture -%}
        {%- comment -%} Karte {%- endcomment -%}
        {%- capture card -%}
          <div class="f-column">
            <a class="iq-jv__card {{ card_mod }}" href="{{ jacket_link }}">
              <span class="iq-jv__media">{{ img }}</span>
              <span class="iq-jv__body">
                <span class="iq-jv__use iq-jv__accent text-sm-extra font-body-bolder text-upper">{{ use }}</span>
                <span class="iq-jv__title h5">{{ short_title }}</span>
                <span class="iq-jv__desc text-sm text-subtext">{{ desc }}</span>
                <span class="iq-jv__link text-sm font-body-bolder">{{ link_label }} <span class="iq-jv__arrow" aria-hidden="true">→</span></span>
              </span>
            </a>
          </div>
        {%- endcapture -%}
        {%- assign cards_html = cards_html | append: card -%}
        {%- comment -%} Tabelle {%- endcomment -%}
        {%- capture cell -%}<th class="iq-jv__col"><a href="{{ jacket_link }}"><span class="font-body-bolder">{{ short_title }}</span></a></th>{%- endcapture -%}
        {%- assign thead_html = thead_html | append: cell -%}
        {%- capture cell -%}<td><span class="text-sm">{{ wetter_html }}</span></td>{%- endcapture -%}
        {%- assign row_wetter = row_wetter | append: cell -%}
        {%- capture cell -%}<td><span class="iq-jv__heat iq-jv__accent">{{ heat_dots }}</span><br><span class="text-sm">{{ heat_label }}</span></td>{%- endcapture -%}
        {%- assign row_waerme = row_waerme | append: cell -%}
        {%- capture cell -%}<td><ul class="iq-jv__features text-sm">{{ features_items }}</ul>{% if notfor != blank %}<p class="text-sm text-subtext">{{ notfor }}</p>{% endif %}</td>{%- endcapture -%}
        {%- assign row_features = row_features | append: cell -%}
        {%- capture cell -%}<td><strong class="iq-jv__price text-base font-body-bolder">{{ p.price | money }}</strong><a class="iq-jv__zur iq-jv__accent text-sm font-body-bolder" href="{{ jacket_link }}">{{ tx_zur }}</a></td>{%- endcapture -%}
        {%- assign row_price = row_price | append: cell -%}
        {%- comment -%} Mobile Accordion {%- endcomment -%}
        {%- capture det -%}
          <details class="iq-jv__acc">
            <summary class="iq-jv__acc-sum">
              <span class="iq-jv__acc-title h5">{{ short_title }}</span>
              <span class="iq-jv__acc-price text-base font-body-bolder">{{ p.price | money }}</span>
            </summary>
            <div class="iq-jv__acc-body text-sm text-subtext">
              <p><strong class="iq-jv__ink font-body-bolder">{{ tx_ideal_label }}</strong> {{ ideal }}</p>
              <p><strong class="iq-jv__ink font-body-bolder">{{ tx_wetter_label }}</strong> {{ wetter_inline }}</p>
              <p><strong class="iq-jv__ink font-body-bolder">{{ tx_waerme_label }}</strong> <span class="iq-jv__accent">{{ heat_dots }}</span> {{ heat_label }}</p>
              <p><strong class="iq-jv__ink font-body-bolder">{{ tx_feat_label }}</strong> {{ features_inline }}</p>
              {% if notfor != blank %}<p>{{ notfor }}</p>{% endif %}
              <a class="iq-jv__zur iq-jv__accent text-sm font-body-bolder" href="{{ jacket_link }}">{{ link_label }}</a>
            </div>
          </details>
        {%- endcapture -%}
        {%- assign mobile_html = mobile_html | append: det -%}
        {%- assign is_first = false -%}
      {%- endunless -%}
    {%- endfor -%}
{%- capture iq_jv_markup -%}
    <section class="iq-jv" id="iq-jacken-vergleich-{{ section.id }}" aria-labelledby="iq-jacken-vergleich-title-{{ section.id }}" tabindex="-1">
      <div class="iq-jv__head">
        <h2 class="h2" id="iq-jacken-vergleich-title-{{ section.id }}">{{ tx_heading }}</h2>
      </div>
      <div class="iq-jv__grid f-grid f-grid-2-cols md:f-grid-3-cols lg:f-grid-5-cols f-grid--gap-small f-grid--row-gap-medium" style="--iq-cols:{{ card_count | at_least: 1 }}">{{ cards_html }}</div>
      <details class="iq-jv__comparison">
        <summary class="iq-jv__comparison-toggle text-base font-body-bolder">
          <span>{{ tx_cmp_eyebrow }}: {{ tx_cmp_heading }}</span>
        </summary>
        <div class="iq-jv__comparison-content">
          <p class="text-base text-subtext">{{ tx_cmp_sub }}</p>
      <div class="iq-jv__table-wrap">
        <table class="iq-jv__table">
          <thead>
            <tr><th></th>{{ thead_html }}</tr>
          </thead>
          <tbody>
            <tr><th class="text-sm-extra font-body-bolder text-upper">{{ tx_row_wetter }}</th>{{ row_wetter }}</tr>
            <tr><th class="text-sm-extra font-body-bolder text-upper">{{ tx_row_waerme }}</th>{{ row_waerme }}</tr>
            <tr><th class="text-sm-extra font-body-bolder text-upper">{{ tx_row_feat }}</th>{{ row_features }}</tr>
            <tr class="iq-jv__price-row"><th class="text-sm-extra font-body-bolder text-upper">{{ tx_row_price }}</th>{{ row_price }}</tr>
          </tbody>
        </table>
      </div>
      <div class="iq-jv__mobile">{{ mobile_html }}</div>
        </div>
      </details>
      <div class="iq-jv__footer text-sm text-subtext">
        <p>{{ tx_footer1 }}</p>
        <p>{{ tx_footer2_pre }}<a href="{{ routes.root_url }}products/iq-zip-in-shell-unisex">IQ Zip-In Shell</a>{{ tx_footer2_post }}</p>
      </div>
    </section>
{%- endcapture -%}
{%- capture iq_jv_style -%}
    <style>
      /* Nur Layout/Farben/Radius über Theme-Tokens – KEINE Schrift-Definitionen. */
      .iq-jv{ --iq-accent:#a51d1b; --iq-card-radius:var(--pcard-radius, 1rem); width:100%; }
      .iq-jv{margin-top:4rem;scroll-margin-top:140px;}
      .iq-jv-jump{margin:1rem 0 2rem;}
      .iq-jv-jump a{display:inline-block;padding:10px 0;color:inherit;text-decoration:underline;text-decoration-color:#a51d1b;text-underline-offset:4px;}
      .iq-jv-jump a:focus-visible{outline:2px solid #a51d1b;outline-offset:4px;}
      /* Karten-Grid füllt die Breite mit der gewählten Produktanzahl (Desktop) */
      @media (min-width:990px){
        .iq-jv__grid{ grid-template-columns:repeat(var(--iq-cols,5), minmax(0,1fr)) !important; }
      }
      .iq-jv *{ box-sizing:border-box; }
      .iq-jv__comparison{ margin-top:2.4rem; border-top:1px solid rgb(var(--color-border)); border-bottom:1px solid rgb(var(--color-border)); }
      .iq-jv__comparison > .iq-jv__comparison-toggle{ display:flex; align-items:center; justify-content:space-between; gap:1.6rem; padding:1.8rem 0; cursor:pointer; list-style:none; font-style:normal; text-transform:none; }
      .iq-jv__comparison-toggle::-webkit-details-marker{ display:none; }
      .iq-jv__comparison-toggle::after{ content:"+"; flex-shrink:0; color:var(--iq-accent); font-size:2.4rem; line-height:1; }
      .iq-jv__comparison[open] > .iq-jv__comparison-toggle::after{ content:"−"; }
      .iq-jv__comparison-toggle:focus-visible{ outline:2px solid var(--iq-accent); outline-offset:4px; }
      .iq-jv__comparison-content{ padding-bottom:2rem; }
      .iq-jv__comparison:not([open]) > .iq-jv__comparison-content{ display:none; }

      .iq-jv__accent{ color:var(--iq-accent); }
      .iq-jv__ink{ color:rgb(var(--color-foreground)); }
      .iq-jv__head{ max-width:76rem; margin-bottom:3.2rem; }
      .iq-jv__eyebrow{ display:block; margin-bottom:.8rem; }
      .iq-jv__intro{ margin-top:1.2rem; }
      /* Karten */
      .iq-jv__card{
        position:relative; display:flex; flex-direction:column; height:100%;
        overflow:hidden; text-decoration:none; color:inherit; cursor:pointer;
        background:rgb(var(--color-background));
        border:1px solid rgb(var(--color-border));
        border-radius:var(--iq-card-radius);
        transition:transform .3s ease, box-shadow .3s ease, border-color .3s ease;
      }
      .iq-jv__card:focus-visible{ outline:2px solid var(--iq-accent); outline-offset:2px; }
      .iq-jv__card:hover{
        transform:translateY(-.4rem);
        box-shadow:0 1.6rem 3.4rem rgba(var(--color-foreground),.08);
        border-color:rgba(var(--color-foreground),.35);
      }
      /* Featured-Karte: normaler Rahmen (kein roter/schwarzer Rand), nur Stern-Badge hebt sie hervor */
      .iq-jv__card--featured{ border-width:1px; border-color:rgb(var(--color-border)); }
      /* K9-Karte: normal (kein schwarzer Hintergrund/Rahmen) */
      .iq-jv__card--k9{ background:rgb(var(--color-background)); border-color:rgb(var(--color-border)); color:inherit; }
      .iq-jv__media{ display:block; overflow:hidden; }
      .iq-jv__img{ display:block; width:100%; aspect-ratio:1/1; object-fit:contain; background:rgb(var(--color-secondary-background)); padding:1.4rem; transition:transform .35s ease; }
      .iq-jv__card:hover .iq-jv__img{ transform:scale(1.04); }
      .iq-jv__badge{
        position:absolute; z-index:1; top:1.2rem; left:1.2rem;
        padding:.6rem 1rem; border-radius:var(--badges-radius, .5rem);
        background:var(--iq-accent); color:#fff;
      }
      /* Icon-only Badge (statt Text) */
      .iq-jv__badge--icon{ padding:0; width:3.4rem; height:3.4rem; border-radius:999px; display:inline-flex; align-items:center; justify-content:center; box-shadow:0 .2rem .6rem rgba(var(--color-foreground),.18); }
      .iq-jv__badge--icon svg{ width:1.9rem; height:1.9rem; display:block; fill:#fff; }
      .iq-jv__body{ display:flex; flex-direction:column; flex:1; padding:1.8rem; }
      .iq-jv__use{ display:block; margin-bottom:.7rem; line-height:1.4; min-height:2.8em; }
      .iq-jv__title{ display:block; margin-bottom:.9rem; line-height:1.25; min-height:2.5em; }
      .iq-jv__desc{ display:block; margin-bottom:1rem; }
      .iq-jv__not{ display:block; margin-bottom:1.8rem; }
      .iq-jv__link{ display:inline-flex; align-items:center; gap:.6rem; margin-top:auto; padding-top:.8rem; }
      .iq-jv__arrow{ transition:transform .2s ease; }
      .iq-jv__card:hover .iq-jv__arrow{ transform:translateX(.4rem); }
      /* Hinweis-Box */
      .iq-jv__shared{
        margin:1.8rem 0 4.4rem; padding:1.6rem 1.8rem;
        border-left:.4rem solid var(--iq-accent);
        background:rgb(var(--color-secondary-background));
      }
      /* Vergleichs-Kopf */
      .iq-jv__compare-head{ display:flex; align-items:flex-end; justify-content:space-between; gap:3rem; margin-bottom:2.2rem; }
      .iq-jv__compare-head > p{ max-width:36rem; text-align:right; margin:0; }
      /* Tabelle */
      .iq-jv__table-wrap{ border:1px solid rgb(var(--color-border)); }
      .iq-jv__table{ width:100%; table-layout:fixed; border-collapse:collapse; }
      .iq-jv__table th,
      .iq-jv__table td{ padding:1.4rem 1rem; border-bottom:1px solid rgb(var(--color-border)); border-right:1px solid rgb(var(--color-border)); text-align:center; vertical-align:top; word-wrap:break-word; overflow-wrap:break-word; hyphens:auto; }
      .iq-jv__table tr > *:last-child{ border-right:0; }
      .iq-jv__table thead th{ background:rgb(var(--color-foreground)); color:rgb(var(--color-background)); }
      .iq-jv__table thead th:first-child{ width:11rem; }
      .iq-jv__table thead a{ color:rgb(var(--color-background)); }
      .iq-jv__table tbody th{ background:rgb(var(--color-secondary-background)); color:var(--color-foreground-lighten-60); text-align:left; }
      .iq-jv__features{ text-align:left; }
      .iq-jv__features li{ position:relative; margin-bottom:.7rem; padding-left:1.4rem; }
      .iq-jv__features li:last-child{ margin-bottom:0; }
      .iq-jv__features li::before{ content:""; position:absolute; left:0; top:.6em; width:.5rem; height:.5rem; background:var(--iq-accent); }
      .iq-jv__price-row td{ background:rgba(var(--color-secondary-background),.55); }
      .iq-jv__price{ display:block; margin-bottom:.9rem; }
      .iq-jv__zur{ display:inline-block; padding-bottom:.2rem; border-bottom:2px solid var(--iq-accent); }
      /* Mobile Accordion */
      .iq-jv__mobile{ display:none; }
      @media (max-width:767.98px){
        .iq-jv__table-wrap{ display:none; }
        .iq-jv__mobile{ display:grid; gap:1rem; }
        .iq-jv__acc{ border:1px solid rgb(var(--color-border)); border-radius:var(--iq-card-radius); overflow:hidden; }
        .iq-jv__acc-sum{ display:flex; align-items:center; gap:1.5rem; padding:1.7rem 1.8rem; cursor:pointer; list-style:none; }
        .iq-jv__acc-sum::-webkit-details-marker{ display:none; }
        .iq-jv__acc-price{ margin-left:auto; }
        .iq-jv__acc-sum::after{ content:"+"; color:var(--iq-accent); font-size:1.8rem; line-height:1; }
        .iq-jv__acc[open] .iq-jv__acc-sum::after{ content:"–"; }
        .iq-jv__acc-body{ padding:0 1.8rem 1.8rem; }
        .iq-jv__acc-body p{ margin-bottom:.8rem; }
        .iq-jv__acc-body a{ margin-top:.4rem; }
      }
      /* Fußnoten */
      .iq-jv__footer{ display:flex; justify-content:space-between; gap:2.8rem; margin-top:2.2rem; }
      .iq-jv__footer p{ max-width:56rem; margin:0; }
      .iq-jv__footer a{ color:rgb(var(--color-foreground)); text-decoration:underline; text-decoration-color:var(--iq-accent); text-underline-offset:.3rem; }
      @media (max-width:767.98px){
        .iq-jv-cell{ margin:1.2rem 0; }
        .iq-jv__compare-head{ display:block; }
        .iq-jv__compare-head > p{ text-align:left; margin-top:.8rem; }
        .iq-jv__footer{ display:block; }
        .iq-jv__footer p + p{ margin-top:1rem; }
        /* Jacken in EINER Zeile, horizontal scrollen, halbe naechste Karte sichtbar */
        .iq-jv__grid{
          display:flex !important;
          grid-template-columns:none !important;
          flex-wrap:nowrap;
          overflow-x:auto;
          scroll-snap-type:x mandatory;
          -webkit-overflow-scrolling:touch;
          gap:1.2rem;
          padding-bottom:.6rem;
          scrollbar-width:none;
        }
        .iq-jv__grid::-webkit-scrollbar{ display:none; }
        .iq-jv__grid > *{ flex:0 0 66% !important; width:66% !important; scroll-snap-align:start; }
      }
    </style>{%- endcapture -%}

{%- endif -%}

{% render 'divider',
  show_divider: section.settings.show_section_divider,
  divider_width: section.settings.divider_width
%}

<div
  class="section--padding color-{{ section.settings.color_scheme }}"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="collection page-width">
    {%- if collection.handle == 'sale' -%}
      <div class="section-header mb-8 iq-outlet-intro">
        <h1 class="h2">{{ 'iq_outlet.title' | t }}</h1>
        <p class="text-subtext">{{ 'iq_outlet.description' | t }}</p>
      </div>
    {%- endif -%}
    {%- assign iq_products_per_page = section.settings.products_per_page -%}
    {%- if collection.handle == 'sale' -%}{%- assign iq_products_per_page = 250 -%}{%- endif -%}
    {%- paginate collection.products by iq_products_per_page -%}
      {%- assign iq_display_products = collection.products -%}
      {%- if section.settings.priority_products != blank -%}
        {%- assign iq_priority_ids = section.settings.priority_products | map: 'id' -%}
        {%- assign iq_ordered_products = '' | split: ',' -%}
        {%- for iq_priority_product in section.settings.priority_products -%}
          {%- assign iq_page_product = iq_display_products | where: 'id', iq_priority_product.id -%}
          {%- assign iq_ordered_products = iq_ordered_products | concat: iq_page_product -%}
        {%- endfor -%}
        {%- for iq_regular_product in iq_display_products -%}
          {%- unless iq_priority_ids contains iq_regular_product.id -%}
            {%- assign iq_page_product = iq_display_products | where: 'id', iq_regular_product.id -%}
            {%- assign iq_ordered_products = iq_ordered_products | concat: iq_page_product -%}
          {%- endunless -%}
        {%- endfor -%}
        {%- assign iq_display_products = iq_ordered_products -%}
      {%- endif -%}
      {%- if collection.handle == 'sale' -%}
        {%- assign iq_display_products = '' | split: ',' -%}
        {%- for iq_product in collection.products -%}
          {%- assign iq_reduced_available = false -%}
          {%- for iq_variant in iq_product.variants -%}
            {%- if iq_variant.available and iq_variant.compare_at_price > iq_variant.price -%}
              {%- assign iq_reduced_available = true -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if iq_reduced_available -%}
            {%- assign iq_one_product = collection.products | where: 'id', iq_product.id -%}
            {%- assign iq_display_products = iq_display_products | concat: iq_one_product -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      <div class="collection__content flex">
        {%- if collection.all_products_count > 0 -%}
          <div
            class="hidden{% if enable_filtering and filter_type == 'vertical' %} xl:block{% endif %}"
            id="FacetFiltersContainer"
          >
            <div class="sticky-element z-10">
              {%- render 'facets', context: 'vertical', results: collection -%}
            </div>
          </div>
        {%- endif -%}
        <div class="flex flex-col flex-grow{% if show_toolbar %} show-toolbar{% endif %}" id="ProductGridWrapper">
          <div class="sticky-element grid gap-5 z-10" style="--sticky-offset: 0px;">
            {%- if enable_filtering or enable_sorting -%}
              <div class="collection__toolbar flex items-center justify-between">
                {%- if filter_type == 'drawer' and collection.all_products_count > 0 and enable_filtering -%}
                  {%- render 'facets-drawer', results: collection, enable_sorting: enable_sorting -%}
                {%- endif -%}

                {%- if filter_type == 'vertical' and collection.all_products_count > 0 and enable_filtering -%}
                  <div class="flex xl:hidden">
                    {%- render 'facets-drawer', results: collection, enable_sorting: enable_sorting -%}
                  </div>
                {%- endif -%}

                <div class="gap-10 hidden md:flex items-center justify-between{% if filter_type == 'vertical' or enable_filtering == false %} xl:flex-grow{% endif %}">
                  {%- if collection.all_products_count > 0 -%}
                    <div data-facet-loading>
                      {%- render 'loading-spinner' -%}
                      <p id="ProductCount" class="m-0" role="status">
                        {%- liquid
                          if collection.handle == 'sale'
                            echo 'products.facets.product_count_simple' | t: count: iq_display_products.size
                          elsif collection.results_count
                            echo 'products.facets.filters_selected' | t: terms: collection.terms, count: collection.results_count
                          elsif collection.products_count == collection.all_products_count
                            echo 'products.facets.product_count_simple' | t: count: collection.products_count
                          else
                            echo 'products.facets.product_count' | t: product_count: collection.products_count, count: collection.all_products_count
                          endif
                        -%}
                      </p>
                    </div>
                  {%- endif -%}
                  {%- if enable_sorting and collection.all_products_count > 0 -%}
                    <div class="flex items-center gap-3" id="SortByContainer">
                      {%- render 'facet-short',
                        results: collection,
                        icon_size: 'extra-small',
                        label_class: 'font-body-bolder'
                      -%}
                    </div>
                  {%- endif -%}
                </div>

                <layout-switcher class="flex md:hidden gap-2" style="--buttons-width: 4rem;">
                  {%- for per_row in (1..2) -%}
                    {%- assign layout = 'f-grid-' | append: per_row | append: '-cols' -%}
                    <button
                      class="btn btn--icon{% if layout == default_grid_mobile %} btn--active{% endif %}"
                      data-layout-mode="grid-{{ per_row }}"
                      aria-label="{{ 'accessibility.layout_switcher' | t: col: per_row }}"
                    >
                      {%- render 'icon-grid-column', layout: per_row, classes: 'pointer-events-none' -%}
                    </button>
                  {%- endfor -%}
                </layout-switcher>
              </div>
            {%- endif -%}
          </div>
          {%- liquid
            if enable_filtering
              render 'facets-active', results: collection
            endif
          -%}
          <div id="ProductGridContainer">
            {% unless template.suffix == 'westen' or template.suffix == 'jacken' %}{% render 'iq-collection-product-jumps', products: iq_display_products %}{% endunless %}
            {%- if section.settings.iq_jv_enabled and card_count > 0 -%}
              {{ iq_jv_style }}
              <p class="iq-jv-jump text-sm"><a href="#iq-jacken-vergleich-{{ section.id }}">{% if lang == 'en' %}Which jacket suits you? Compare jackets{% else %}Welche Jacke passt zu Dir? Zum Vergleich{% endif %} <span aria-hidden="true">↓</span></a></p>
            {%- endif -%}

            {%- if iq_display_products.size == 0 -%}
              <div class="empty-state flex flex-col items-center justify-center gap-6 text-center">
                {%- if collection.all_products_count > 0 -%}
                  <div class="gap-3 flex flex-col items-center justify-center text-center">
                    {%- render 'icon-empty-state' -%}
                    <p class="h4">{{ 'collections.general.no_results' | t }}</p>
                    <p class="m-0">{{ 'collections.general.use_fewer_filters' | t }}</p>
                  </div>
                  <a class="btn btn--primary" href="{{ collection.url }}" is="facet-remove">
                    {{- 'products.facets.clear_all' | t -}}
                  </a>
                {%- else -%}
                  <div class="gap-3 flex flex-col items-center justify-center text-center">
                    {%- render 'icon-empty-state' -%}
                    <p class="h4">{{ 'collections.general.empty' | t }}</p>
                  </div>
                  <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">
                    {{ 'collections.general.continue_shopping' | t }}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
            <!-- DEBUG mobile columns: {{ section.settings.columns_mobile }} -->

            <grid-list
              id="ProductsList"
              {% if section.settings.use_section_column_settings %}style="--iq-grid-columns-desktop:{{ columns_desktop }};--iq-grid-columns-tablet:{{ columns_tablet }};--iq-grid-columns-mobile:{{ columns_mobile }};"{% endif %}
              class="grid-list products-list f-grid md:f-grid-{{ columns_tablet }}-cols lg:f-grid-{{ columns_tablet_large }}-cols xl:f-grid-{{ columns_desktop }}-cols {{ default_grid_mobile }} f-grid--gap-medium"
            >
              {%- for product in iq_display_products -%}
                <div class="f-column card" data-product-card{% if iq_collection_card and product.id == 10709801337096 %} id="iq-westen-dienst"{% else %} id="iq-product-{{ product.id }}"{% endif %}>
                  {%- if is_metro -%}
                    {%- render 'card-product-metro',
                      product: product,
                      image_sizes: image_sizes,
                      section_id: section.id,
                      section_index: 2,
                      index: forloop.index,
                      index0: forloop.index0,
                      desktop_breakpoint: 1280,
                      columns_desktop: columns_desktop,
                      columns_tablet: columns_tablet,
                      columns_mobile: columns_mobile
                    -%}
                  {%- else -%}
                    {%- render 'card-product',
                      iq_collection_card: iq_collection_card,
                      collection_card_titles: section.settings.collection_card_titles,
                      collection_color_swatches: section.settings.enable_color_swatch,
                      defer_primary_image: section.settings.defer_product_images,
                      product: product,
                      image_sizes: image_sizes,
                      section_id: section.id,
                      section_index: 2,
                      index: forloop.index
                    -%}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            </grid-list>

            {%- liquid
              if paginate.pages > 1
                render 'pagination', paginate: paginate, type: section.settings.pagination
              endif
            -%}
            {%- if section.settings.iq_jv_enabled and card_count > 0 -%}
              {{ iq_jv_markup }}
            {%- endif -%}


          </div>
           <div id="CollectionInlineBlocks-{{ section.id }}" hidden>
  {%- assign current_app_position = 24 -%}

  {%- for block in section.blocks -%}
{%- if block.type == 'iq_editorial' and block.settings.only_collection.handle != collection.handle -%}{%- continue -%}{%- endif -%}

    {%- if block.type == 'app_position' -%}
      {%- assign current_app_position = block.settings.position -%}
      {%- continue -%}
    {%- endif -%}

    {%- if block.type == '@app' -%}
      {%- assign block_position = current_app_position -%}
    {%- else -%}
      {%- assign block_position = block.settings.position -%}
    {%- endif -%}

    <template
        data-inline-block-template
        data-position="{{ block_position }}"
        data-position-mobile="{{ block.settings.position_mobile | default: block_position }}"
        data-block-id="{{ block.id }}"
      >
      {%- case block.type -%}
{%- when 'iq_editorial' -%}{% render 'iq-editorial-banner', block: block %}

        {%- when '@app' -%}
          <div class="f-column card collection-inline-block collection-inline-block--full" data-inline-block="{{ block.id }}" {{ block.shopify_attributes }}>
            {% render block %}
          </div>

        {%- when 'inline_rich_text' -%}
          <div class="f-column collection-inline-block collection-inline-block--{{ block.settings.width }}" data-inline-block="{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="collection-inline-block__inner collection-inline-block__inner--{{ block.settings.text_alignment }}">
              {%- if block.settings.heading != blank -%}
                <h2 class="{{ block.settings.heading_size }}">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                <a href="{{ block.settings.button_link }}" class="btn btn--{{ block.settings.button_style }}">
                  {{ block.settings.button_label }}
                </a>
              {%- endif -%}
            </div>
          </div>

        {%- when 'inline_image_text' -%}
          <div class="f-column collection-inline-block collection-inline-block--{{ block.settings.width }}" data-inline-block="{{ block.id }}" {{ block.shopify_attributes }}>
            <div class="collection-inline-image-text collection-inline-image-text--{{ block.settings.layout }}">
              {%- if block.settings.image != blank -%}
                <div class="collection-inline-image-text__media">
                  <img
                    src="{{ block.settings.image | image_url: width: 1600 }}"
                    alt="{{ block.settings.heading | escape }}"
                    width="{{ block.settings.image.width }}"
                    height="{{ block.settings.image.height }}"
                    loading="lazy"
                    class="collection-inline-block__image"
                  >
                </div>
              {%- endif -%}
              <div class="collection-inline-image-text__content collection-inline-block__inner collection-inline-block__inner--{{ block.settings.text_alignment }}">
                {%- if block.settings.heading != blank -%}
                  <h2 class="{{ block.settings.heading_size }}">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte">{{ block.settings.text | newline_to_br }}</div>
                {%- endif -%}
                {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
                  <a href="{{ block.settings.button_link }}" class="btn btn--{{ block.settings.button_style }}">
                    {{ block.settings.button_label }}
                  </a>
                {%- endif -%}
              </div>
            </div>
          </div>

        {%- when 'inline_promo_image' -%}
          <div class="f-column collection-inline-block collection-inline-block--{{ block.settings.width }}" data-inline-block="{{ block.id }}" {{ block.shopify_attributes }}>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="collection-inline-promo-image">
            {%- else -%}
              <div class="collection-inline-promo-image">
            {%- endif -%}

            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 1600 }}"
                alt="{{ block.settings.heading | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
                class="collection-inline-block__image"
              >
            {%- endif -%}

            {%- if block.settings.heading != blank or block.settings.text != blank or block.settings.button_label != blank -%}
              <div class="collection-inline-promo-image__content collection-inline-promo-image__content--{{ block.settings.text_position }}">
                {%- if block.settings.heading != blank -%}
                  <h2 class="{{ block.settings.heading_size }}">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
