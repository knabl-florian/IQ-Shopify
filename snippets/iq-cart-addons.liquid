{% doc %}
  Merchant-selected additions shared by the cart drawer and cart page.
  @param {string} section_id - Parent section identifier.
{% enddoc %}
{%- if settings.iq_cart_addons_enabled and cart.item_count > 0 -%}
  {%- assign cart_product_ids = cart.items | map: 'product_id' -%}
  {%- capture addon_items -%}
    {%- for addon in settings.iq_cart_addon_products -%}
      {%- unless cart_product_ids contains addon.id -%}
        {%- if addon.available and addon.requires_selling_plan == false -%}
          {%- liquid
            assign variant = addon.selected_or_first_available_variant
            assign form_id = 'IQCartAddon-' | append: section_id | append: '-' | append: addon.id
            assign select_id = form_id | append: '-variant'
          -%}
          <li class="iq-cart-addons__item">
            <a href="{{ addon.url }}" class="iq-cart-addons__image" tabindex="-1" aria-hidden="true">
              {%- if addon.featured_image -%}
                {{ addon.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80,160', sizes: '72px', alt: '' }}
              {%- endif -%}
            </a>
            <div class="iq-cart-addons__content">
              <a class="iq-cart-addons__title" href="{{ addon.url }}">{% capture addon_title %}{% render 'iq-card-short-title', product: addon %}{% endcapture %}{{ addon_title | strip | escape }}</a>
              {%- form 'product', addon, id: form_id, is: 'product-form', class: 'iq-cart-addons__form' -%}
                <input type="hidden" name="quantity" value="1">
                {%- if addon.variants.size > 1 -%}
                  <label class="visually-hidden" for="{{ select_id }}">{{ 'iq_cart_addons.variant' | t }}: {{ addon.title | escape }}</label>
                  <select id="{{ select_id }}" name="id" class="iq-cart-addons__select">
                    {%- for option in addon.variants -%}
                      {%- if option.available -%}
                        <option value="{{ option.id }}"{% if option.id == variant.id %} selected{% endif %}>{{ option.title | escape }} · {{ option.price | money_with_currency | escape }}</option>
                      {%- endif -%}
                    {%- endfor -%}
                  </select>
                {%- else -%}
                  <input type="hidden" name="id" value="{{ variant.id }}">
                  <span class="iq-cart-addons__price">{{ variant.price | money_with_currency }}</span>
                {%- endif -%}
                <button type="submit" name="add" class="btn btn--secondary iq-cart-addons__add" aria-label="{{ 'products.product.add_to_cart' | t }}: {{ addon.title | escape }}">
                  <span>{{ 'iq_cart_addons.add' | t }}</span>
                  {% render 'loading-spinner' %}
                </button>
                <p class="product-form__error-message" role="alert" hidden></p>
              {%- endform -%}
            </div>
          </li>
        {%- endif -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if addon_items != blank -%}
    <section class="iq-cart-addons" aria-labelledby="IQCartAddonsTitle-{{ section_id }}">
      <h2 id="IQCartAddonsTitle-{{ section_id }}" class="iq-cart-addons__heading">
        {%- if request.locale.iso_code == 'de' -%}{{ settings.iq_cart_addons_heading_de | escape }}{%- else -%}{{ settings.iq_cart_addons_heading_en | escape }}{%- endif -%}
      </h2>
      <ul class="iq-cart-addons__list" role="list">{{ addon_items }}</ul>
    </section>
  {%- endif -%}
{%- endif -%}
{% stylesheet %}
.iq-cart-addons { margin-top:24px; padding-top:20px; border-top:1px solid #DCDBD7; color:#171717; }
.iq-cart-addons__heading { margin:0 0 14px; font-family:Archivo,sans-serif; font-weight:700; font-style:normal; text-transform:none; font-size:20px; line-height:1.25; }
.iq-cart-addons__list { display:grid; gap:16px; padding:0; margin:0; list-style:none; }
.iq-cart-addons__item { display:grid; grid-template-columns:72px minmax(0,1fr); gap:12px; align-items:center; min-width:0; }
.iq-cart-addons__image { display:block; width:72px; height:72px; background:#FFFFFF; }
.iq-cart-addons__image img { width:100%; height:100%; object-fit:contain; }
.iq-cart-addons__content { min-width:0; }
.iq-cart-addons__title { display:block; margin-bottom:7px; font-family:Archivo,sans-serif; font-size:14px; line-height:1.3; font-weight:700; }
.iq-cart-addons__form { display:flex; flex-wrap:wrap; align-items:center; gap:8px; }
.iq-cart-addons__select { width:100%; min-width:0; min-height:44px; padding:8px; border:1px solid #DCDBD7; background:#FFFFFF; color:#171717; font-family:Archivo,sans-serif; font-size:14px; border-radius:0; }
.iq-cart-addons__price { font-size:14px; }
.iq-cart-addons__add { min-height:44px; padding:8px 14px; font-family:Archivo,sans-serif; font-weight:700; font-style:normal; font-size:14px; text-transform:none; }
.iq-cart-addons .product-form__error-message { width:100%; font-size:14px; color:#A51D1B; }
@media(min-width:750px) { main-cart .iq-cart-addons__list { grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; } }
{% endstylesheet %}
