{%- liquid
  assign desktop = section.settings.desktop_image
  assign mobile = section.settings.mobile_image | default: desktop
  assign title = section.settings.title_de | default: collection.title
  assign accent = section.settings.accent_de
  assign description = section.settings.description_de
  assign mobile_description = section.settings.mobile_description_de | default: description
  assign label = section.settings.label_de
  assign image_alt = section.settings.alt_de | default: desktop.alt
  assign button = section.settings.button_de
  assign button_url = section.settings.button_url | default: '#ProductsList'
  if request.locale.iso_code == 'en'
    assign title = section.settings.title_en | default: collection.title
    assign accent = section.settings.accent_en
    assign description = section.settings.description_en
    assign mobile_description = section.settings.mobile_description_en | default: description
    assign label = section.settings.label_en
    assign image_alt = section.settings.alt_en | default: desktop.alt
    assign button = section.settings.button_en
  endif
  assign heading_tag = section.settings.heading_tag | default: 'h1'
-%}
{%- if section.settings.only_collection.handle == collection.handle or section.settings.only_collection == blank and section.settings.require_collection != true -%}
{%- if desktop != blank -%}
<div class="iqcb" data-iq-collection-hero data-tone="{{ section.settings.text_tone }}" data-position="{{ section.settings.desktop_position }}" data-mobile-position="{{ section.settings.mobile_position }}" data-mobile-tone="{{ section.settings.mobile_tone }}" data-mobile-align="{{ section.settings.mobile_alignment }}" style="--iqcb-focus:{{ section.settings.focus_y }}%;">
  <picture class="iqcb__picture">
    <source media="(max-width:749px)" srcset="{{ mobile | image_url: width: 400 }} 400w, {{ mobile | image_url: width: 750 }} 750w, {{ mobile | image_url: width: 800 }} 800w, {{ mobile | image_url: width: 1000 }} 1000w, {{ mobile | image_url: width: 1200 }} 1200w" sizes="100vw" width="{{ mobile.width }}" height="{{ mobile.height }}">
    {{ desktop | image_url: width: 2560 | image_tag: widths: '800,1200,1600,1920,2560', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: image_alt, class: 'iqcb__image' }}
  </picture>
  <div class="iqcb__copy">
    {% if label != blank %}<p class="iqcb__label{% unless section.settings.show_mobile_label %} iqcb__label--desktop{% endunless %}">{{ label | escape }}</p>{% endif %}
    <{{ heading_tag }} class="iqcb__title">{{ title | escape }}{% if accent != blank %}<span>{{ accent | escape }}</span>{% endif %}</{{ heading_tag }}>
    {% if description != blank %}<p class="iqcb__description iqcb__desktop">{{ description | escape }}</p>{% endif %}
    {% if mobile_description != blank %}<p class="iqcb__description iqcb__mobile">{{ mobile_description | escape }}</p>{% endif %}
    {% if button != blank %}<a class="iqcb__button" href="{{ button_url | escape }}">{{ button | escape }}</a>{% endif %}
  </div>
</div>
{%- endif -%}
{%- elsif request.design_mode -%}<p class="iqcb-editor-note">Bitte die passende Collection auswählen. Dieser Banner erscheint nur dort.</p>
{%- endif -%}

{% stylesheet %}
.iqcb,.iqcb *{box-sizing:border-box}
.iqcb{position:relative;isolation:isolate;width:100%;aspect-ratio:16/5;max-height:550px;overflow:hidden;background:#171717;color:#fff;font-family:Archivo,sans-serif;container-type:inline-size}
.iqcb .iqcb__picture{display:block;position:absolute;inset:0;margin:0}
.iqcb .iqcb__image{display:block;width:100%;height:100%;object-fit:cover;object-position:50% var(--iqcb-focus,50%);border:0;border-radius:0;margin:0}
.iqcb .iqcb__copy{position:absolute;z-index:1;left:6%;top:50%;transform:translateY(-50%);width:43%;max-width:760px;text-align:left}
.iqcb[data-position="top"] .iqcb__copy{top:8%;transform:none}
.iqcb[data-position="bottom"] .iqcb__copy{top:auto;bottom:6%;transform:none}
.iqcb .iqcb__title{margin:0;color:#171717;font:italic 800 clamp(26px,3.6cqw,64px)/1.08 Montserrat,sans-serif;letter-spacing:-.035em;text-transform:uppercase;overflow-wrap:break-word}
.iqcb[data-tone="light"] .iqcb__title{color:#fff;text-shadow:0 1px 3px #17171780}
.iqcb .iqcb__title span{display:block;color:#A51D1B;text-shadow:none}
.iqcb .iqcb__label{font:700 clamp(10px,.8cqw,13px)/1.4 Archivo,sans-serif;letter-spacing:.06em;text-transform:uppercase;margin:0 0 12px;color:#fff;text-shadow:0 1px 3px #171717b3}
.iqcb .iqcb__description{font:400 clamp(14px,1.05cqw,17px)/1.5 Archivo,sans-serif;margin:20px 0 0;max-width:470px;color:#fff;text-shadow:0 1px 3px #171717b3}
.iqcb .iqcb__mobile{display:none}
.iqcb .iqcb__button{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:12px 24px;margin-top:20px;background:#FFFFFF;color:#171717;border:1px solid #FFFFFF;border-radius:var(--buttons-radius,2px);font:700 14px/1.4 Archivo,sans-serif;letter-spacing:.03em;text-transform:uppercase;text-decoration:none;text-shadow:none;text-align:center}
.iqcb .iqcb__button:hover{background:#F3F3F1}
.iqcb .iqcb__button:focus-visible{outline:3px solid #A51D1B;outline-offset:4px}
.iqcb-editor-note{padding:20px;background:#F3F3F1;color:#171717;font:400 15px/1.5 Archivo,sans-serif}
@media(min-width:750px){.iqcb[data-tone="dark"] .iqcb__description,.iqcb[data-tone="dark"] .iqcb__label{color:#171717;text-shadow:none}}
@media(max-width:749px){
.iqcb{aspect-ratio:4/5;max-height:none}
.iqcb .iqcb__image{object-position:50% 50%}
.iqcb .iqcb__copy{top:auto;bottom:4%;left:5%;width:90%;max-width:none;transform:none;text-align:center}
.iqcb[data-position="top"] .iqcb__copy,.iqcb[data-position="bottom"] .iqcb__copy{top:auto;bottom:4%;transform:none}
.iqcb[data-mobile-position="top"] .iqcb__copy{top:4%;bottom:auto}
.iqcb[data-mobile-align="left"] .iqcb__copy{text-align:left}
.iqcb .iqcb__title{font-size:clamp(25px,7cqw,46px);color:#fff;text-shadow:0 1px 3px #17171780}
.iqcb[data-mobile-tone="dark"] .iqcb__title{color:#171717;text-shadow:none}
.iqcb .iqcb__title span{color:#A51D1B}
.iqcb .iqcb__desktop,.iqcb .iqcb__label--desktop{display:none}
.iqcb .iqcb__mobile{display:block}
.iqcb .iqcb__description{font-size:14px;margin:12px auto 0;max-width:520px}
.iqcb .iqcb__label{font-size:10px;margin-bottom:8px}
.iqcb[data-mobile-tone="dark"] .iqcb__description,.iqcb[data-mobile-tone="dark"] .iqcb__label{color:#171717;text-shadow:none}
.iqcb .iqcb__button{margin-top:12px}
}
{% endstylesheet %}

{% schema %}
{
  "name": "IQ Collection Banner",
  "tag": "section",
  "class": "iq-collection-hero-section",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "collection",
      "id": "only_collection",
      "label": "Nur für diese Collection",
      "info": "Eine Collection auswählen. Der Banner wird nur in dieser Collection angezeigt."
    },
    {
      "type": "checkbox",
      "id": "require_collection",
      "label": "Collection-Auswahl erforderlich",
      "default": false,
      "info": "Bei neuen Bannern eingeschaltet lassen. Aus = ohne Auswahl auf der gesamten Vorlage (nur für bestehende Einzelvorlagen)."
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktopbild – 1920 × 600",
      "info": "Einheitliches Querformat 16:5, maximal 550 px hoch. Text im Editor eingeben."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobilbild – 1200 × 1500",
      "info": "Seitenverhältnis 4:5. Ohne Auswahl wird das Desktopbild verwendet."
    },
    {
      "type": "select",
      "id": "text_tone",
      "label": "Schrift auf Desktopbild",
      "options": [
        {
          "value": "dark",
          "label": "Dunkel"
        },
        {
          "value": "light",
          "label": "Hell"
        }
      ],
      "default": "dark"
    },
    {
      "type": "select",
      "id": "desktop_position",
      "label": "Textposition Desktop",
      "options": [
        {
          "value": "center",
          "label": "Mittig links"
        },
        {
          "value": "top",
          "label": "Oben links"
        },
        {
          "value": "bottom",
          "label": "Unten links"
        }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_label",
      "label": "Kategorie mobil zeigen",
      "default": true
    },
    {
      "type": "range",
      "id": "focus_y",
      "label": "Bildfokus vertikal (Desktop)",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 75,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Deutsch"
    },
    {
      "type": "text",
      "id": "title_de",
      "label": "Überschrift"
    },
    {
      "type": "text",
      "id": "accent_de",
      "label": "Rote Zeile"
    },
    {
      "type": "textarea",
      "id": "description_de",
      "label": "Erklärung"
    },
    {
      "type": "textarea",
      "id": "mobile_description_de",
      "label": "Erklärung mobil"
    },
    {
      "type": "text",
      "id": "label_de",
      "label": "Kategorie"
    },
    {
      "type": "text",
      "id": "alt_de",
      "label": "Bildbeschreibung"
    },
    {
      "type": "header",
      "content": "English"
    },
    {
      "type": "text",
      "id": "title_en",
      "label": "Überschrift"
    },
    {
      "type": "text",
      "id": "accent_en",
      "label": "Rote Zeile"
    },
    {
      "type": "textarea",
      "id": "description_en",
      "label": "Erklärung"
    },
    {
      "type": "textarea",
      "id": "mobile_description_en",
      "label": "Erklärung mobil"
    },
    {
      "type": "text",
      "id": "label_en",
      "label": "Kategorie"
    },
    {
      "type": "text",
      "id": "alt_en",
      "label": "Bildbeschreibung"
    },
    {
      "type": "select",
      "id": "mobile_position",
      "label": "Textposition mobil",
      "options": [
        {
          "value": "bottom",
          "label": "Unten"
        },
        {
          "value": "top",
          "label": "Oben"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "label": "Textausrichtung mobil",
      "options": [
        {
          "value": "center",
          "label": "Mittig"
        },
        {
          "value": "left",
          "label": "Links"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_tone",
      "label": "Schrift mobil",
      "options": [
        {
          "value": "light",
          "label": "Hell"
        },
        {
          "value": "dark",
          "label": "Dunkel"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Überschriftsebene",
      "options": [
        {
          "value": "h1",
          "label": "H1 – Hauptbanner"
        },
        {
          "value": "h2",
          "label": "H2 – weiterer Banner"
        }
      ],
      "default": "h1"
    },
    {
      "type": "header",
      "content": "Optionaler Button"
    },
    {
      "type": "text",
      "id": "button_de",
      "label": "Button Deutsch"
    },
    {
      "type": "text",
      "id": "button_en",
      "label": "Button Englisch"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Linkziel",
      "info": "Leer lassen = zum Produktraster dieser Seite."
    }
  ],
  "presets": [
    {
      "name": "IQ Collection Banner",
      "settings": {
        "require_collection": true
      }
    }
  ]
}
{% endschema %}
