    "custom_liquid_knjKwD": {
      "type": "custom-liquid",
      "name": "testimonials neu ",
      "settings": {
        "custom_liquid": "{%- comment -%}\n============================================================\nIQ DOGSPORT – REVIEWS EDITORIAL\nCustom Liquid · Mobile First · Fassung 5\n\nTYPOGRAFIE:\n- Section-Headline: Montserrat 800 Italic\n- Review-Zitate: Archivo 500, NICHT italic\n- Namen: Archivo 700\n- Kontext: Archivo 400\n\nZIEL:\nDie Kundenstimmen sollen nach echten Stimmen aussehen,\nnicht nach sechs zusätzlichen Werbe-Headlines.\n\nINHALTE:\nAlle sechs gelieferten Bewertungen unverändert übernommen.\n\nLAYOUT:\nMobile:\n- horizontal wischbar\n- ca. 86vw\n- nächste Bewertung angeschnitten sichtbar\n\nDesktop:\n- 3 Spalten × 2 Reihen\n\nKeine Rundungen.\nKeine Schatten.\nKeine Slider-Library.\nKein Review-Schema.\n============================================================\n{%- endcomment -%}\n\n\n<style>\n\n  .iq-review-editorial {\n    width: 100%;\n    background: rgb(var(--color-background));\n    color: rgb(var(--color-foreground));\n    font-family: var(--font-body-family, Archivo, Arial, sans-serif);\n  }\n\n\n  .iq-review-editorial__inner {\n    width: 100%;\n    box-sizing: border-box;\n    padding: 58px 0 66px;\n  }\n\n\n  /* =========================================================\n     HEADER\n     ========================================================= */\n\n  .iq-review-editorial__head {\n    padding: 0 20px;\n  }\n\n\n  .iq-review-editorial__eyebrow {\n    margin: 0;\n\n    font-family: var(--font-body-family, Archivo, Arial, sans-serif);\n    font-size: 11px;\n    line-height: 1.2;\n    font-weight: 700;\n\n    letter-spacing: 2.8px;\n    text-transform: uppercase;\n\n    color: #A51D1B;\n  }\n\n\n  .iq-review-editorial__heading {\n    margin: 10px 0 0;\n\n    max-width: 760px;\n\n    font-family: var(--font-heading-family, Montserrat, Arial, sans-serif);\n    font-style: italic;\n    font-weight: 800;\n\n    font-size: clamp(31px, 8vw, 44px);\n    line-height: 1.01;\n    letter-spacing: -.4px;\n\n    text-transform: uppercase;\n  }\n\n\n  /* =========================================================\n     OVERALL RATING\n     ========================================================= */\n\n  .iq-review-editorial__summary {\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n\n    gap: 8px;\n\n    margin-top: 18px;\n  }\n\n\n  .iq-review-editorial__score {\n    font-family: var(--font-heading-family, Montserrat, Arial, sans-serif);\n    font-size: 28px;\n    line-height: 1;\n    font-weight: 700;\n  }\n\n\n  .iq-review-editorial__summary-stars,\n  .iq-review-editorial__stars {\n    display: inline-flex;\n    align-items: center;\n    gap: 2px;\n  }\n\n\n  .iq-review-editorial__summary-stars svg {\n    width: 17px;\n    height: 17px;\n\n    color: #FFB400;\n    fill: #FFB400;\n  }\n\n\n  .iq-review-editorial__count {\n    width: 100%;\n    margin-top: 2px;\n\n    font-family: var(--font-body-family, Archivo, Arial, sans-serif);\n    font-size: 13.5px;\n    line-height: 1.35;\n    font-weight: 400;\n\n    color: rgba(var(--color-foreground), .64);\n  }\n\n\n  /* =========================================================\n     MOBILE SWIPE\n     ========================================================= */\n\n  .iq-review-editorial__track {\n    display: grid;\n    grid-auto-flow: column;\n    grid-auto-columns: 86vw;\n\n    gap: 14px;\n\n    overflow-x: auto;\n\n    scroll-snap-type: x mandatory;\n    scroll-padding-inline: 20px;\n\n    padding: 28px 20px 4px;\n\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n  }\n\n\n  .iq-review-editorial__track::-webkit-scrollbar {\n    display: none;\n  }\n\n\n  /* =========================================================\n     REVIEW CARD\n     ========================================================= */\n\n  .iq-review-editorial__card {\n    scroll-snap-align: start;\n\n    min-height: 250px;\n\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n\n    box-sizing: border-box;\n\n    padding: 24px 22px 21px;\n\n    background: rgba(var(--color-foreground), .04);\n\n    border: 0;\n    border-radius: 0;\n    box-shadow: none;\n  }\n\n\n  .iq-review-editorial__stars svg {\n    width: 16px;\n    height: 16px;\n\n    color: #FFB400;\n    fill: #FFB400;\n  }\n\n\n  /*\n    ENTSCHEIDENDE ÄNDERUNG:\n\n    Zitate nicht mehr Montserrat Bold.\n    Stattdessen Archivo Medium / 500.\n  */\n\n  .iq-review-editorial__quote {\n    margin: 18px 0 0;\n    padding: 0;\n\n    border: 0;\n\n    font-family: var(--font-body-family, Archivo, Arial, sans-serif);\n\n    font-size: 18px;\n    line-height: 1.48;\n\n    font-style: normal;\n    font-weight: 500;\n\n    letter-spacing: 0;\n\n    color: rgb(var(--color-foreground));\n  }\n\n\n  .iq-review-editorial__meta {\n    margin-top: 27px;\n\n    font-family: var(--font-body-family, Archivo, Arial, sans-serif);\n  }\n\n\n  .iq-review-editorial__name {\n    font-size: 12.5px;\n    line-height: 1.3;\n    font-weight: 700;\n\n    text-transform: uppercase;\n    letter-spacing: .35px;\n  }\n\n\n  .iq-review-editorial__context {\n    margin-top: 5px;\n\n    font-size: 12.5px;\n    line-height: 1.42;\n    font-weight: 400;\n\n    color: rgba(var(--color-foreground), .66);\n  }\n\n\n  /* =========================================================\n     DESKTOP\n     ========================================================= */\n\n  @media (min-width: 990px) {\n\n    .iq-review-editorial__inner {\n      max-width: 1360px;\n\n      margin-inline: auto;\n\n      padding:\n        82px\n        32px\n        90px;\n\n      box-sizing: border-box;\n    }\n\n\n    .iq-review-editorial__head {\n      padding: 0;\n    }\n\n\n    .iq-review-editorial__heading {\n      font-size: clamp(42px, 3.4vw, 56px);\n    }\n\n\n    .iq-review-editorial__count {\n      width: auto;\n      margin-top: 0;\n      margin-left: 2px;\n    }\n\n\n    .iq-review-editorial__track {\n      display: grid;\n\n      grid-template-columns:\n        repeat(3, minmax(0, 1fr));\n\n      grid-auto-flow: row;\n      grid-auto-columns: auto;\n\n      gap: 22px;\n\n      overflow: visible;\n      scroll-snap-type: none;\n\n      padding: 36px 0 0;\n    }\n\n\n    .iq-review-editorial__card {\n      min-height: 290px;\n\n      padding:\n        28px\n        26px\n        24px;\n    }\n\n\n    .iq-review-editorial__quote {\n      font-size: 18px;\n      line-height: 1.48;\n      font-weight: 500;\n    }\n\n  }\n\n</style>\n\n\n{%- capture iq_review_star -%}\n\n  <svg\n    viewBox=\"0 0 24 24\"\n    fill=\"currentColor\"\n    stroke=\"currentColor\"\n    stroke-width=\"1.4\"\n    stroke-linejoin=\"round\"\n    aria-hidden=\"true\"\n  >\n    <path d=\"M12 3l2.7 5.6 6.1.8-4.4 4.3 1.1 6.1L12 17l-5.5 2.8 1.1-6.1L3.2 9.4l6.1-.8z\"/>\n  </svg>\n\n{%- endcapture -%}\n\n\n{%- capture iq_review_stars -%}\n\n  <span class=\"iq-review-editorial__stars\">\n\n    {{ iq_review_star }}\n    {{ iq_review_star }}\n    {{ iq_review_star }}\n    {{ iq_review_star }}\n    {{ iq_review_star }}\n\n  </span>\n\n{%- endcapture -%}\n\n\n\n<section class=\"iq-review-editorial\">\n\n  <div class=\"iq-review-editorial__inner\">\n\n\n    {%- if request.locale.iso_code == 'en' -%}\n\n\n      <!-- ===================================================\n           ENGLISH\n           =================================================== -->\n\n      <header class=\"iq-review-editorial__head\">\n\n        <p class=\"iq-review-editorial__eyebrow\">\n          REAL EXPERIENCES\n        </p>\n\n\n        <h2 class=\"iq-review-editorial__heading\">\n          What handlers say\n        </h2>\n\n\n        <div class=\"iq-review-editorial__summary\">\n\n          <span class=\"iq-review-editorial__score\">\n            4.9 / 5\n          </span>\n\n\n          <span class=\"iq-review-editorial__summary-stars\">\n\n            {{ iq_review_star }}\n            {{ iq_review_star }}\n            {{ iq_review_star }}\n            {{ iq_review_star }}\n            {{ iq_review_star }}\n\n          </span>\n\n\n          <span class=\"iq-review-editorial__count\">\n            2,800+ reviews\n          </span>\n\n        </div>\n\n      </header>\n\n\n\n      <div class=\"iq-review-editorial__track\">\n\n\n        <!-- ROBERT CABRAL -->\n\n        <article class=\"iq-review-editorial__card\">\n\n          <div>\n\n            {{ iq_review_stars }}\n\n            <blockquote class=\"iq-review-editorial__quote\">\n              “Finally a harness that really works in dog sport – support for barking without pressure on the neck. No risk of rolling over during leash work.”\n            </blockquote>\n\n          </div>\n\n\n          <div class=\"iq-review-editorial__meta\">\n\n            <div class=\"iq-review-editorial__name\">\n              Robert Cabral\n            </div>\n\n            <div class=\"iq-review-editorial__context\">\n              Performance Pro Harness · IQ Athlete\n            </div>\n\n          </div>\n\n        </article>\n\n\n        <!-- URSULA -->\n\n        <article class=\"iq-review-editorial__card\">\n\n          <div>\n\n            {{ iq_review_stars }}\n\n            <blockquote class=\"iq-review-editorial__quote\">\n              “Two pouches turn into one big reward bag – brilliant for the front sit and retrieves.”\n            </blockquote>\n\n          </div>\n\n\n          <div class=\"iq-review-editorial__meta\">\n\n            <div class=\"iq-review-editorial__name\">\n              Ursula H.\n            </div>\n\n            <div class=\"iq-review-editorial__context\">\n              Dogsport Vest 3.0 · Verified purchase\n            </div>\n\n          </div>\n\n        </article>\n\n\n        <!-- NORMEN -->\n\n        <article class=\"iq-review-editorial__card\">\n\n          <div>\n\n            {{ iq_review_stars }}\n\n            <blockquote class=\"iq-review-editorial__quote\">\n              “My first one is seven years old and still has no holes or tears from training.”\n            </blockquote>\n\n          </div>\n\n\n          <div class=\"iq-review-editorial__meta\">\n\n            <div class=\"iq-review-editorial__name\">\n              Normen G.\n            </div>\n\n            <div class=\"iq-review-editorial__context\">\n              Multifunction Jacket · Verified purchase\n            </div>\n\n          </div>\n\n        </article>\n\n\n        <!-- STEFFI -->\n\n        <article class=\"iq-review-editorial__card\">\n\n          <div>\n\n            {{ iq_review_stars }}\n\n            <blockquote class=\"iq-review-editorial__quote\">\n              “Functionality in training that genuinely delivers – especially the big back pocket.”\n            </blockquote>\n\n          </div>\n\n\n          <div class=\"iq-review-editorial__meta\">\n\n            <div class=\"iq-review-editorial__name\">\n              Steffi P.\n            </div>\n\n            <div class=\"iq-review-editorial__context\">\n              Train Hard Hoodie · Verified purchase\n            </div>\n\n          </div>\n\n        </article>\n\n\n        <!-- ANDRE -->\n\n        <article class=\"iq-review-editorial__card\">\n\n          <div>\n\n            {{ iq_review_stars }}\n\n            <blockquote class=\"iq-review-editorial__quote\">\n              “Patented chest pocket design, smart details and innovative features.”\n            </blockquote>\n\n          </div>\n\n\n          <div class=\"iq-review-editorial__meta\">\n\n            <div class=\"iq-review-editorial__name\">\n              Andre\n            </div>\n\n            <div class=\"iq-review-editorial__context\">\n              Training Jacket 2.0 · Verified purchase\n            </div>\n\n          </div>\n\n        </article>\n\n\n        <!-- BRUNO -->\n\n        <article class=\"iq-review-editorial__card\">\n\n          <div>\n\n            {{ iq_review_stars }}\n\n            <blockquote class=\"iq-review-editorial__quote\">\n              “You have written another work that moves us dog sport people forward.”\n            </blockquote>\n\n          </div>\n\n\n          <div class=\"iq-review-editorial__meta\">\n\n            <div class=\"iq-review-editorial__name\">\n              Bruno Thalmann\n            </div>\n\n            <div class=\"iq-review-editorial__context\">\n              Successful Together: Protection Work · Reader review\n            </div>\n\n          </div>\n\n        </article>\n\n\n      </div>\n\n\n    {%- else -%}\n\n\n      <!-- ===================================================\n           DEUTSCH\n           =================================================== -->\n\n      <header class=\"iq-review-editorial__head\">\n\n        <p class=\"iq-review-editorial__eyebrow\">\n          ECHTE ERFAHRUNGEN\n        </p>\n\n\n        <h2 class=\"iq-review-editorial__heading\">\n          Das sagen Hundesportler\n        </h2>\n\n\n        <div class=\"iq-review-editorial__summary\">\n\n          <span class=\"iq-review-editorial__score\">\n            4,9 / 5\n          </span>\n\n\n          <span class=\"iq-review-editorial__summary-stars\">\n\n            {{ iq_review_star }}\n            {{ iq_review_star }}\n            {{ iq_review_star }}\n            {{ iq_review_star }}\n            {{ iq_review_star }}\n\n          </span>\n\n\n          <span class=\"iq-review-editorial__count\">\n            über 2.800 Bewertungen\n          </span>\n\n        </div>\n\n      </header>\n\n\n\n      <div class=\"iq-review-editorial__track\">\n\n\n        <!-- ROBERT CABRAL -->\n\n        <article class=\"iq-review-editorial__card\">\n\n          <div>\n\n            {{ iq_review_stars }}\n\n            <blockquote class=\"iq-review-editorial__quote\">\n              „Endlich ein Geschirr, das im Hundesport wirklich funktioniert – Unterstützung beim Verbellen ohne Druck auf den Hals. Kein Überschlagsrisiko bei Leinenarbeit.“\n            </blockquote>\n\n          </div>\n\n\n          <div class=\"iq-review-editorial__meta\">\n\n            <div class=\"iq-review-editorial__name\">\n              Robert Cabral\n            </div>\n\n            <div class=\"iq-review-editorial__context\">\n              Performance Pro Geschirr · IQ Athlete\n            </div>\n\n          </div>\n\n        </article>\n\n\n        <!-- URSULA H. -->\n\n        <article class=\"iq-review-editorial__card\">\n\n          <div>\n\n            {{ iq_review_stars }}\n\n            <blockquote class=\"iq-review-editorial__quote\">\n              „Aus zwei Taschen wird eine große Belohnungstasche – genial für Vorsitz und Apportieren.“\n            </blockquote>\n\n          </div>\n\n\n          <div class=\"iq-review-editorial__meta\">\n\n            <div class=\"iq-review-editorial__name\">\n              Ursula H.\n            </div>\n\n            <div class=\"iq-review-editorial__context\">\n              Hundesportweste 3.0 · Verifizierter Kauf\n            </div>\n\n          </div>\n\n        </article>\n\n\n        <!-- NORMEN G. -->\n\n        <article class=\"iq-review-editorial__card\">\n\n          <div>\n\n            {{ iq_review_stars }}\n\n            <blockquote class=\"iq-review-editorial__quote\">\n              „Meine erste ist sieben Jahre alt und hat weder Löcher noch Risse vom Training.“\n            </blockquote>\n\n          </div>\n\n\n          <div class=\"iq-review-editorial__meta\">\n\n            <div class=\"iq-review-editorial__name\">\n              Normen G.\n            </div>\n\n            <div class=\"iq-review-editorial__context\">\n              Multifunktionsjacke · Verifizierter Kauf\n            </div>\n\n          </div>\n\n        </article>\n\n\n        <!-- STEFFI P. -->\n\n        <article class=\"iq-review-editorial__card\">\n\n          <div>\n\n            {{ iq_review_stars }}\n\n            <blockquote class=\"iq-review-editorial__quote\">\n              „Funktionalität im Training, die wirklich überzeugt – besonders die große Rückentasche.“\n            </blockquote>\n\n          </div>\n\n\n          <div class=\"iq-review-editorial__meta\">\n\n            <div class=\"iq-review-editorial__name\">\n              Steffi P.\n            </div>\n\n            <div class=\"iq-review-editorial__context\">\n              Train Hard Hoodie · Verifizierter Kauf\n            </div>\n\n          </div>\n\n        </article>\n\n\n        <!-- ANDRE -->\n\n        <article class=\"iq-review-editorial__card\">\n\n          <div>\n\n            {{ iq_review_stars }}\n\n            <blockquote class=\"iq-review-editorial__quote\">\n              „Patentiertes Design der Brusttaschen, clevere Details und innovative Features.“\n            </blockquote>\n\n          </div>\n\n\n          <div class=\"iq-review-editorial__meta\">\n\n            <div class=\"iq-review-editorial__name\">\n              Andre\n            </div>\n\n            <div class=\"iq-review-editorial__context\">\n              Trainingsjacke 2.0 · Verifizierter Kauf\n            </div>\n\n          </div>\n\n        </article>\n\n\n        <!-- BRUNO THALMANN -->\n\n        <article class=\"iq-review-editorial__card\">\n\n          <div>\n\n            {{ iq_review_stars }}\n\n            <blockquote class=\"iq-review-editorial__quote\">\n              „Ihr habt wieder ein Werk verfasst, das uns Hundesportler weiterbringt.“\n            </blockquote>\n\n          </div>\n\n\n          <div class=\"iq-review-editorial__meta\">\n\n            <div class=\"iq-review-editorial__name\">\n              Bruno Thalmann\n            </div>\n\n            <div class=\"iq-review-editorial__context\">\n              Gemeinsam erfolgreich: Schutzdienst · Leserstimme\n            </div>\n\n          </div>\n\n        </article>\n\n\n      </div>\n\n\n    {%- endif -%}\n\n\n  </div>\n\n</section>",
