{% if section.settings.only_collection == blank or section.settings.only_collection.handle == collection.handle or section.settings.additional_collection.handle == collection.handle %}
{% unless template.suffix == 'jacken' %}{{ 'iq-collection-finder.css' | asset_url | stylesheet_tag }}{% endunless %}
{% unless section.settings.compact_compare %}<script src="{{ 'iq-collection-finder.js' | asset_url }}" defer="defer"></script>{% endunless %}
{% liquid
  assign lang = 'de'
  if request.locale.iso_code == 'en'
    assign lang = 'en'
  endif
  assign eyebrow_key = 'eyebrow_' | append: lang
  assign heading_key = 'heading_' | append: lang
  assign intro_key = 'intro_' | append: lang
  assign extra_key = 'extra_' | append: lang
%}
<section class="iq-jacket-finder iq-collection-container{% if section.settings.compact_compare %} iq-jacket-finder--compact{% endif %}" id="iq-jacken-vergleich" data-iq-finder aria-labelledby="finder-heading-{{ section.id }}">
  <header class="iq-jacket-finder__header">
    <p class="iq-jacket-finder__eyebrow">{{ section.settings[eyebrow_key] | escape }}</p>
    <h2 id="finder-heading-{{ section.id }}">{{ section.settings[heading_key] | escape | newline_to_br }}</h2>
    {% if section.settings[intro_key] != blank %}<p class="iq-jacket-finder__intro">{{ section.settings[intro_key] | escape }}</p>{% endif %}
  </header>

  {% if section.settings.compact_compare %}
  <p class="iq-jacket-finder__swipe">{% if lang == 'de' %}Wische für alle fünf Gruppen →{% else %}Swipe to see all five groups →{% endif %}</p>
  <div class="iq-jacket-finder__compact-grid" tabindex="0" role="region" aria-label="{% if lang == 'de' %}Jackenvergleich{% else %}Jacket comparison{% endif %}">
    {% assign seen_groups = '|' %}
    {% for block in section.blocks %}
      {% if block.settings.only_collection != blank and block.settings.only_collection.handle != collection.handle %}{% continue %}{% endif %}
      {% assign group = block.settings.compare_group | default: block.id %}
      {% assign group_token = '|' | append: group | append: '|' %}
      {% if seen_groups contains group_token %}{% continue %}{% endif %}
      {% assign seen_groups = seen_groups | append: group | append: '|' %}
      {% assign title_key = 'title_' | append: lang %}
      {% assign text_key = 'intro_' | append: lang %}
      {% assign benefits_key = 'benefits_' | append: lang %}
      <article class="iq-jacket-finder__compact-card" {{ block.shopify_attributes }}>
        <h3>{{ block.settings[title_key] | escape }}</h3>
        <p class="iq-jacket-finder__use">{{ block.settings[text_key] | escape }}</p>
        <div class="iq-jacket-finder__facts">{{ block.settings[benefits_key] }}</div>
        <div class="iq-jacket-finder__model-links">
          {% for model in section.blocks %}
            {% if model.settings.only_collection != blank and model.settings.only_collection.handle != collection.handle %}{% continue %}{% endif %}
            {% assign model_group = model.settings.compare_group | default: model.id %}
            {% unless model_group == group %}{% continue %}{% endunless %}
            {% assign primary = model.settings.primary_product %}
            {% assign secondary = model.settings.secondary_product %}
            {% assign primary_label_key = 'link_primary_' | append: lang %}
            {% assign secondary_label_key = 'link_secondary_' | append: lang %}
            {% if primary != blank %}
              <a href="{{ primary.url }}">{{ model.settings[primary_label_key] | escape }} <span aria-hidden="true">→</span>{% unless primary.available %}<small>{% if lang == 'de' %}Zurzeit ausverkauft{% else %}Currently sold out{% endif %}</small>{% endunless %}</a>
            {% endif %}
            {% if secondary != blank %}
              <a href="{{ secondary.url }}">{{ model.settings[secondary_label_key] | escape }} <span aria-hidden="true">→</span>{% unless secondary.available %}<small>{% if lang == 'de' %}Zurzeit ausverkauft{% else %}Currently sold out{% endif %}</small>{% endunless %}</a>
            {% endif %}
          {% endfor %}
        </div>
        <details class="iq-jacket-finder__compact-details">
          <summary>{% if lang == 'de' %}Details & Zubehör{% else %}Details & accessories{% endif %}</summary>
          {% for model in section.blocks %}
            {% if model.settings.only_collection != blank and model.settings.only_collection.handle != collection.handle %}{% continue %}{% endif %}
            {% assign model_group = model.settings.compare_group | default: model.id %}
            {% unless model_group == group %}{% continue %}{% endunless %}
            {% assign name_key = 'name_' | append: lang %}
            {% assign details_key = 'details_' | append: lang %}
            <h4>{{ model.settings[name_key] | escape }}</h4>
            {{ model.settings[details_key] }}
            {% if model.settings.show_zip_in %}
              <p>{% if lang == 'de' %}Die optionale Zip-In Shell ergänzt die Trainingsjacke 2.0 um eine Wärmeschicht. Auch einzeln tragbar; nicht als Regenschutz gedacht.{% else %}The optional Zip-In Shell adds warmth to the Training Jacket 2.0. Also wearable on its own; not designed as rain protection.{% endif %}</p>
              <p><a href="{{ routes.root_url | append: '/' | replace: '//', '/' }}products/iq-zip-in-shell-damen">{% if lang == 'de' %}Zip-In Damen{% else %}Women’s Zip-In{% endif %} →</a> · <a href="{{ routes.root_url | append: '/' | replace: '//', '/' }}products/iq-zip-in-shell-unisex">Zip-In Unisex →</a></p>
            {% endif %}
          {% endfor %}
        </details>
      </article>
    {% endfor %}
  </div>
  {% else %}
  <div class="iq-jacket-finder__choices" role="group" aria-label="{{ section.settings[eyebrow_key] | escape }}">
    {% assign first_choice = true %}
    {% for block in section.blocks %}
      {% if block.settings.only_collection != blank and block.settings.only_collection.handle != collection.handle %}{% continue %}{% endif %}
      {% assign tab_key = 'tab_' | append: lang %}
      <button type="button" data-finder-button aria-controls="finder-{{ section.id }}-{{ block.id }}" aria-pressed="{% if first_choice %}true{% else %}false{% endif %}">{{ block.settings[tab_key] | escape }}</button>
      {% assign first_choice = false %}
    {% endfor %}
  </div>
  {% assign first_panel = true %}
  {% for block in section.blocks %}
    {% if block.settings.only_collection != blank and block.settings.only_collection.handle != collection.handle %}{% continue %}{% endif %}
    {% liquid
      assign name_key = 'name_' | append: lang
      assign title_key = 'title_' | append: lang
      assign text_key = 'intro_' | append: lang
      assign alt_key = 'alt_' | append: lang
      assign benefits_key = 'benefits_' | append: lang
      assign details_key = 'details_' | append: lang
      assign cta_key = 'cta_' | append: lang
      assign primary = block.settings.primary_product
      assign secondary = block.settings.secondary_product
      assign loading = 'lazy'
    %}
    <article class="iq-jacket-finder__panel" id="finder-{{ section.id }}-{{ block.id }}" data-finder-panel{% unless first_panel %} hidden{% endunless %} {{ block.shopify_attributes }}>
      <div class="iq-jacket-finder__photo">
        {% if block.settings.photo != blank %}
          {{ block.settings.photo | image_url: width: 1200 | image_tag: loading: loading, sizes: '(min-width: 750px) 600px, 100vw', widths: '400,600,800,1000,1200', alt: block.settings[alt_key] }}
        {% else %}
          <img src="{{ block.settings.photo_url | escape }}" alt="{{ block.settings[alt_key] | escape }}" width="{{ block.settings.photo_width }}" height="{{ block.settings.photo_height }}" loading="lazy" decoding="async">
        {% endif %}
      </div>
      <div class="iq-jacket-finder__copy">
        <h3>{{ block.settings[name_key] | escape }}</h3>
        <p>{{ block.settings[text_key] | escape }}</p>
        <div class="iq-jacket-finder__benefits">{{ block.settings[benefits_key] }}</div>
        <div class="iq-jacket-finder__actions">
          {% if primary != blank %}<a href="{{ primary.url }}" class="iq-jacket-finder__cta">{% if secondary != blank %}{% if lang == 'de' %}Damenmodell{% else %}Women’s model{% endif %}{% else %}{{ block.settings[cta_key] | escape }}{% endif %} →</a>{% endif %}
          {% if secondary != blank %}<a href="{{ secondary.url }}" class="iq-jacket-finder__cta">{% if lang == 'de' %}Unisexmodell{% else %}Unisex model{% endif %} →</a>{% endif %}
        </div>
        {% if block.settings[details_key] != blank or block.settings.show_zip_in %}
        <details class="iq-jacket-finder__extra"><summary>{% if lang == 'de' %}Details & Zubehör{% else %}Details & accessories{% endif %}</summary>
          {{ block.settings[details_key] }}
        {% if block.settings.show_zip_in %}
    <p><strong>{{ section.settings[extra_key] | escape }}</strong></p>
    {% if lang == 'de' %}<p>Die Zip-in-Shell ergänzt die Trainingsjacke 2.0 um eine Wärmeschicht. Auch einzeln tragbar; nicht als Regenschutz gedacht.</p>{% else %}<p>The Zip-in Shell adds warmth to the Training Jacket 2.0. It can also be worn on its own; it is not designed as rain protection.</p>{% endif %}
    <a href="{{ routes.root_url | append: '/' | replace: '//', '/' }}products/iq-zip-in-shell-damen">{% if lang == 'de' %}Damenmodell{% else %}Women’s model{% endif %} →</a> · <a href="{{ routes.root_url | append: '/' | replace: '//', '/' }}products/iq-zip-in-shell-unisex">{% if lang == 'de' %}Unisexmodell{% else %}Unisex model{% endif %} →</a>
        {% endif %}
        </details>
        {% endif %}
      </div>
    </article>
    {% assign first_panel = false %}
  {% endfor %}

  {% endif %}
</section>
<noscript><style>.iq-jacket-finder__panel[hidden]{display:grid}</style></noscript>
{% endif %}
{% schema %}
{
  "name": "IQ Modellauswahl",
  "settings": [
    {
      "type": "checkbox",
      "id": "compact_compare",
      "label": "Kompakten Vergleich anzeigen",
      "default": false,
      "info": "Modellgruppen nebeneinander, mobil wischbar. Bestehende Modelllinks bleiben erhalten."
    },
    {
      "type": "collection",
      "id": "only_collection",
      "label": "Nur für diese Collection",
      "info": "Leer lassen: auf der gesamten Vorlage anzeigen."
    },
    {
      "type": "collection",
      "id": "additional_collection",
      "label": "Zusätzliche Collection",
      "info": "Modelle über die Collection-Auswahl im jeweiligen Modellblock zuordnen."
    },
    {
      "type": "textarea",
      "id": "eyebrow_de",
      "label": "eyebrow DE"
    },
    {
      "type": "textarea",
      "id": "heading_de",
      "label": "heading DE"
    },
    {
      "type": "textarea",
      "id": "intro_de",
      "label": "intro DE"
    },
    {
      "type": "textarea",
      "id": "extra_de",
      "label": "extra DE"
    },
    {
      "type": "textarea",
      "id": "eyebrow_en",
      "label": "eyebrow EN"
    },
    {
      "type": "textarea",
      "id": "heading_en",
      "label": "heading EN"
    },
    {
      "type": "textarea",
      "id": "intro_en",
      "label": "intro EN"
    },
    {
      "type": "textarea",
      "id": "extra_en",
      "label": "extra EN"
    }
  ],
  "blocks": [
    {
      "type": "model",
      "name": "Modell",
      "settings": [
        {
          "type": "select",
          "id": "compare_group",
          "label": "Vergleichsgruppe",
          "options": [
            {
              "value": "winter",
              "label": "Wintermantel / Parka"
            },
            {
              "value": "mfj",
              "label": "Multifunktion"
            },
            {
              "value": "training",
              "label": "Training"
            },
            {
              "value": "allround",
              "label": "Allround"
            },
            {
              "value": "softshell",
              "label": "Softshell"
            }
          ],
          "default": "mfj"
        },
        {
          "type": "collection",
          "id": "only_collection",
          "label": "Modell nur in dieser Collection",
          "info": "Leer: Modell überall in diesem Vergleich zeigen."
        },
        {
          "type": "textarea",
          "id": "name_de",
          "label": "name DE"
        },
        {
          "type": "textarea",
          "id": "tab_de",
          "label": "tab DE"
        },
        {
          "type": "textarea",
          "id": "title_de",
          "label": "title DE"
        },
        {
          "type": "textarea",
          "id": "intro_de",
          "label": "intro DE"
        },
        {
          "type": "textarea",
          "id": "alt_de",
          "label": "alt DE"
        },
        {
          "type": "textarea",
          "id": "cta_de",
          "label": "cta DE"
        },
        {
          "type": "richtext",
          "id": "benefits_de",
          "label": "Vorteile DE"
        },
        {
          "type": "textarea",
          "id": "name_en",
          "label": "name EN"
        },
        {
          "type": "textarea",
          "id": "tab_en",
          "label": "tab EN"
        },
        {
          "type": "textarea",
          "id": "title_en",
          "label": "title EN"
        },
        {
          "type": "textarea",
          "id": "intro_en",
          "label": "intro EN"
        },
        {
          "type": "textarea",
          "id": "alt_en",
          "label": "alt EN"
        },
        {
          "type": "textarea",
          "id": "cta_en",
          "label": "cta EN"
        },
        {
          "type": "richtext",
          "id": "benefits_en",
          "label": "Vorteile EN"
        },
        {
          "type": "image_picker",
          "id": "photo",
          "label": "Bild (optional)"
        },
        {
          "type": "text",
          "id": "photo_url",
          "label": "Bild-URL als Alternative"
        },
        {
          "type": "number",
          "id": "photo_width",
          "label": "Bildbreite"
        },
        {
          "type": "number",
          "id": "photo_height",
          "label": "Bildhöhe"
        },
        {
          "type": "product",
          "id": "primary_product",
          "label": "Produkt / Damenmodell"
        },
        {
          "type": "product",
          "id": "secondary_product",
          "label": "Unisexmodell (optional)"
        },
        {
          "type": "checkbox",
          "id": "show_zip_in",
          "label": "Zip-in-Shell Hinweis (nur Trainingsjacke 2.0)",
          "default": false
        },
        {
          "type": "richtext",
          "id": "details_de",
          "label": "Details & Zubehör DE"
        },
        {
          "type": "richtext",
          "id": "details_en",
          "label": "Details & accessories EN"
        },
        {
          "type": "text",
          "id": "link_primary_de",
          "label": "Linktext Damen/Einzelmodell DE"
        },
        {
          "type": "text",
          "id": "link_primary_en",
          "label": "Linktext Damen/Einzelmodell EN"
        },
        {
          "type": "text",
          "id": "link_secondary_de",
          "label": "Linktext Unisex DE"
        },
        {
          "type": "text",
          "id": "link_secondary_en",
          "label": "Linktext Unisex EN"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "IQ Modellauswahl"
    }
  ]
}
{% endschema %}
