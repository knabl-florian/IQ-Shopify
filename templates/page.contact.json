            "content": "<p>&nbsp;</p>",
            "custom_liquid": "{% if request.locale.iso_code == 'de' %}\n<div class=\"payment-overview\">\n  <div class=\"payment-overview__grid\">\n\n    <div class=\"payment-overview__item\">\n      <h6>Bestellstatus</h6>\n      <p>Den Status Deiner Bestellung findest Du im Kundenkonto.</p>\n      <p>Du erhältst E-Mails zu Änderungen Deiner Bestellung.</p>\n      <p>Falls Du keine E-Mail erhalten hast, überprüfe bitte auch Deinen Spam-Ordner.</p>\n    </div>\n\n    <div class=\"payment-overview__item\">\n      <h6>Versandkosten</h6>\n      <p>Innerhalb Deutschlands ist der Versand ab 150 € kostenlos (bis 30 kg, ausgenommen Sperrgut).</p>\n      <p>Unter 150 € berechnen wir 5,90 € Versandkosten.</p>\n      <p>Innerhalb der EU kostet der Versand ab 150 € nur 5,90 €.</p>\n    </div>\n\n    <div class=\"payment-overview__item\">\n      <h6>Versand / Bearbeitung</h6>\n      <p>Deine Bestellung wird spätestens am nächsten Werktag nach Zahlungseingang bearbeitet und versendet.</p>\n      <p>Bitte beachte, dass es je nach Zahlungsart 2–3 Werktage dauern kann, bis Deine Zahlung bei uns eingeht.</p>\n    </div>\n\n    <div class=\"payment-overview__item\">\n      <h6>Lieferzeit</h6>\n      <p>Innerhalb Deutschlands beträgt die Lieferzeit in der Regel 1–2 Werktage nach Zahlungseingang.</p>\n      <p>In Stoßzeiten kann es zu Verzögerungen kommen.</p>\n    </div>\n\n    <div class=\"payment-overview__item\">\n      <h6>Sendungsverfolgung</h6>\n      <p>Nach dem Versand erhältst Du eine E-Mail mit einer Sendungsverfolgungsnummer.</p>\n      <p>Damit kannst Du Dein Paket jederzeit verfolgen.</p>\n    </div>\n\n    <div class=\"payment-overview__item\">\n      <h6>Versanddienstleister</h6>\n      <p>Innerhalb Deutschlands versenden wir mit GLS.</p>\n      <p>International nutzen wir GLS, DPD oder FedEx.</p>\n    </div>\n\n    <div class=\"payment-overview__item\">\n      <h6>Lieferländer</h6>\n      <p>Wir liefern weltweit in viele Länder. Die genauen Versandkosten werden Dir im Checkout angezeigt.</p>\n      <p>Bei Lieferungen außerhalb der EU können zusätzliche Zölle und Gebühren anfallen.</p>\n    </div>\n\n    <div class=\"payment-overview__item\">\n      <h6>Bestellung ändern oder stornieren</h6>\n      <p>Sende eine E-Mail an mail@iq-dogsport.de, solange die Bestellung noch nicht versendet wurde.</p>\n    </div>\n\n  </div>\n\n  <div class=\"site-card__actions\">\n    <a href=\"/pages/zahlungs-und-versandinformation\" class=\"button\">\n      Zahlungs- und Versandinformation\n    </a>\n\n    <a href=\"/pages/contact#contact-form\" class=\"button button--secondary\">\n      Kontaktformular\n    </a>\n  </div>\n</div>\n\n{% elsif request.locale.iso_code == 'en' %}\n\n<div class=\"payment-overview\">\n  <div class=\"payment-overview__grid\">\n\n    <div class=\"payment-overview__item\">\n      <h6>Order status</h6>\n      <p>You can find your order status in your customer account.</p>\n      <p>You will receive emails about changes to your order.</p>\n      <p>If you have not received an email, please also check your spam folder.</p>\n    </div>\n\n    <div class=\"payment-overview__item\">\n      <h6>Shipping costs</h6>\n      <p>Within Germany, shipping is free from €150 (up to 40 kg, excluding bulky goods).</p>\n      <p>Below €150, we charge €5.90 shipping.</p>\n      <p>Within the EU, shipping is only €5.90 from €150.</p>\n    </div>\n\n    <div class=\"payment-overview__item\">\n      <h6>Shipping / processing</h6>\n      <p>Your order will be processed and shipped no later than the next business day after payment is received.</p>\n      <p>Please note that depending on the payment method, it can take 2–3 business days for your payment to reach us.</p>\n    </div>\n\n    <div class=\"payment-overview__item\">\n      <h6>Delivery time</h6>\n      <p>Within Germany, delivery usually takes 1–2 business days after payment is received.</p>\n      <p>Delays may occur during peak periods.</p>\n    </div>\n\n    <div class=\"payment-overview__item\">\n      <h6>Tracking</h6>\n      <p>After shipping, you will receive an email with a tracking number.</p>\n      <p>You can use it to track your package at any time.</p>\n    </div>\n\n    <div class=\"payment-overview__item\">\n      <h6>Shipping providers</h6>\n      <p>Within Germany, we ship with GLS.</p>\n      <p>Internationally, we use GLS, DPD or FedEx.</p>\n    </div>\n\n    <div class=\"payment-overview__item\">\n      <h6>Shipping countries</h6>\n      <p>We deliver worldwide to many countries. Exact shipping costs are shown at checkout.</p>\n      <p>Additional customs duties and fees may apply outside the EU.</p>\n    </div>\n\n    <div class=\"payment-overview__item\">\n      <h6>Change or cancel order</h6>\n      <p>Send an email to mail@iq-dogsport.de as long as the order has not been shipped yet.</p>\n    </div>\n\n  </div>\n\n  <div class=\"site-card__actions\">\n    <a href=\"/pages/zahlungs-und-versandinformation\" class=\"button\">\n      Payment & shipping information\n    </a>\n\n    <a href=\"/pages/contact#contact-form\" class=\"button button--secondary\">\n      Contact form\n    </a>\n  </div>\n</div>\n\n{% endif %}",
            "page": "",
            "open": true
          }
