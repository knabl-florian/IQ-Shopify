              # EN: offizielle Übersetzung (translationsRegister) hier eintragen
              assign use = 'Rugged & warm'
              assign desc = 'A rugged bestseller since 2011. Warmly lined, with removable treat pockets and a large rear pocket.'
              assign notfor = 'Not for warm transitional days.'
              assign link_label = 'View MFJ 3.0'
              assign w1 = '20,000 mm'
              assign w2 = 'windproof'
              assign w3 = 'sealed seams'
              assign heat_label = 'warmly lined'
              assign f1 = 'Removable treat pockets'
              assign f2 = 'Large rear pocket'
              assign f3 = 'Reinforced stitching'
              assign ideal = 'Outdoor life with your dog, especially in cold and wet weather.'
            endif
          endif
          # Wetterschutz mehrzeilig (Tabelle)
          assign wetter_html = w1
          if w2 != blank
            assign wetter_html = wetter_html | append: '<br>' | append: w2
          endif
          if w3 != blank
            assign wetter_html = wetter_html | append: '<br>' | append: w3
          endif
          # Wetterschutz inline (mobil)
          assign wetter_inline = ''
          if w1 != blank
            assign wetter_inline = w1
          endif
          if w2 != blank
            if wetter_inline != blank
              assign wetter_inline = wetter_inline | append: ', '
            endif
            assign wetter_inline = wetter_inline | append: w2
          endif
          if w3 != blank
            if wetter_inline != blank
              assign wetter_inline = wetter_inline | append: ', '
            endif
            assign wetter_inline = wetter_inline | append: w3
          endif
          # Features (li-Elemente, ul kommt im Markup)
          assign features_items = ''
          if f1 != blank
            assign features_items = features_items | append: '<li>' | append: f1 | append: '</li>'
          endif
          if f2 != blank
            assign features_items = features_items | append: '<li>' | append: f2 | append: '</li>'
          endif
          if f3 != blank
            assign features_items = features_items | append: '<li>' | append: f3 | append: '</li>'
          endif
          # Features inline (mobil)
          assign features_inline = ''
          if f1 != blank
            assign features_inline = f1
          endif
          if f2 != blank
            if features_inline != blank
              assign features_inline = features_inline | append: ', '
            endif
            assign features_inline = features_inline | append: f2
          endif
          if f3 != blank
            if features_inline != blank
              assign features_inline = features_inline | append: ', '
            endif
