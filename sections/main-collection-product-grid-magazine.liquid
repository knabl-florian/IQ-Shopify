<script>
const grid = document.getElementById('ProductsList');

grid.addEventListener('scroll', function(event) {
  const slider = event.target.closest('motion-element');
  if (!slider) return;

  const wrapper = slider.closest('.product-card__image-wrapper');
  if (!wrapper) return;

  wrapper.classList.toggle(
    'is-second-image',
    slider.scrollLeft > slider.offsetWidth / 2
  );
}, true);
  (function () {
    var timer = null;
    var lastProductCount = -1;

    function getCurrentPosition(template) {
      var isMobile = window.matchMedia('(max-width: 767px)').matches;

      var desktopPosition = parseInt(template.getAttribute('data-position'), 10);
      var mobilePosition = parseInt(template.getAttribute('data-position-mobile'), 10);

      if (isMobile && mobilePosition) {
        return mobilePosition;
      }

      return desktopPosition;
    }

   function placeCollectionInlineBlocks() {
      var grid = document.getElementById('ProductsList');
      var holder = document.getElementById('CollectionInlineBlocks-{{ section.id }}');

      if (!grid || !holder) return;

      var products = grid.querySelectorAll('[data-product-card]');
      var templates = Array.prototype.slice.call(
        holder.querySelectorAll('template[data-inline-block-template]')
      );

      if (!products.length || !templates.length) return;

      templates.sort(function (a, b) {
        return getCurrentPosition(a) - getCurrentPosition(b);
      });

      var lastInsertedByIndex = {};

      templates.forEach(function (template) {
        var position = getCurrentPosition(template);
        var blockId = template.getAttribute('data-block-id');

        if (!position || !blockId) return;

        var targetIndex = products.length < position
          ? products.length - 1
          : position - 1;

        var targetProduct = products[targetIndex];

        if (!targetProduct) return;

        var existingBlock = grid.querySelector('[data-inline-block="' + blockId + '"]');
        var block = existingBlock || template.content.firstElementChild.cloneNode(true);

        if (!block) return;

        var insertAfter = lastInsertedByIndex[targetIndex] || targetProduct;
        insertAfter.insertAdjacentElement('afterend', block);
        lastInsertedByIndex[targetIndex] = block;

        if (!existingBlock && block.innerHTML.indexOf('jdgm') !== -1 && window.jdgm && window.jdgm.initializeWidgets) {
          window.jdgm.initializeWidgets();
        }
      });

      lastProductCount = products.length;
    }
    function schedulePlacement() {
      clearTimeout(timer);
      timer = setTimeout(placeCollectionInlineBlocks, 150);
    }

    document.addEventListener('DOMContentLoaded', placeCollectionInlineBlocks);
    document.addEventListener('shopify:section:load', placeCollectionInlineBlocks);
    window.addEventListener('resize', schedulePlacement);

    var container = document.getElementById('ProductGridContainer');

    if (container) {
      new MutationObserver(function () {
        var grid = document.getElementById('ProductsList');
        if (!grid) return;

        var count = grid.querySelectorAll('[data-product-card]').length;

        if (count !== lastProductCount) {
          schedulePlacement();
        }
      }).observe(container, {
        childList: true,
        subtree: true
      });
    }
    document.addEventListener('fullscreenchange', function () {
  if (document.fullscreenElement) {
    clearTimeout(timer);
  }
});

document.addEventListener('webkitfullscreenchange', function () {
  if (document.webkitFullscreenElement) {
    clearTimeout(timer);
  }
});
  })();
  document.addEventListener('click', function (event) {
    var button = event.target.closest('[data-inline-video-play]');
    if (!button) return;

    var wrapper = button.closest('.collection-inline-video');
    var template = wrapper.querySelector('template[data-inline-video-template]');
    if (!template) return;

    var video = template.content.firstElementChild.cloneNode(true);
    button.replaceWith(video);

    if (video && video.play) {
      video.play();
    }
  });
</script>
        </div>
      </div>
    {%- endpaginate -%}
  </div>
