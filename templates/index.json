      "name": "wissen",
      "settings": {
        "custom_liquid": "{%- assign en = false -%}\n{%- if request.locale.iso_code == 'en' -%}{%- assign en = true -%}{%- endif -%}\n\n{%- comment -%} Bild-Dateinamen (Shopify Files). buch_foto bitte hochladen. {%- endcomment -%}\n{%- assign blog_foto = 'startseite-bilder.jpg' -%}\n{%- assign buch_foto = 'B_cher_IQ_dogsport.jpg' -%}\n\n<style>\n  .iqw{ background:rgb(var(--color-background)); color:rgb(var(--color-foreground)); font-family:Archivo,Arial,sans-serif; padding-bottom:8px; }\n  .iqw__head{ padding:16px 20px 0; box-sizing:border-box; }\n  .iqw__eyebrow{ margin:0; font-size:11px; font-weight:700; letter-spacing:2.8px; text-transform:uppercase; color:#A51D1B; }\n  .iqw__title{ margin:9px 0 0; font-family:Montserrat,Arial,sans-serif; font-style:italic; font-weight:800; text-transform:uppercase; font-size:clamp(30px,7.5vw,36px); line-height:1.02; letter-spacing:-.3px; }\n\n  .iqw a{ text-decoration:none; color:inherit; display:block; }\n  .iqw__cat{ font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#A51D1B; }\n  .iqw__h{ font-family:Archivo,Arial,sans-serif; font-weight:700; font-style:normal; text-transform:none; line-height:1.1; margin-top:4px; font-size:22px; }\n  .iqw__t{ font-size:14.5px; line-height:1.45; color:rgba(var(--color-foreground),.74); margin:6px 0 0; }\n  .iqw__link{ display:inline-block; margin-top:12px; font-size:13px; font-weight:700; letter-spacing:.4px; text-transform:uppercase; color:rgb(var(--color-foreground)); border-bottom:2px solid transparent; padding-bottom:2px; transition:color .2s ease,border-color .2s ease; }\n  .iqw a:hover .iqw__link, .iqw a:focus-visible .iqw__link{ color:#A51D1B; border-color:#A51D1B; }\n  .iqw a:focus-visible{ outline:3px solid #A51D1B; outline-offset:3px; }\n\n  /* Zwei grosse Einstiege – Bild + Text als EIN Beitrag */\n  .iqw__grid{ display:block; padding-top:22px; }\n  .iqw__feat + .iqw__feat{ margin-top:34px; }\n  .iqw__media{ position:relative; width:100%; aspect-ratio:3/2; overflow:hidden; background:#111; }\n  .iqw__media img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }\n  .iqw__feat .iqw__cat{ margin-top:16px; }\n  .iqw__feat .iqw__cat, .iqw__feat .iqw__h, .iqw__feat .iqw__t, .iqw__feat .iqw__link{ padding-inline:20px; }\n\n  /* Was ist IGP? – kompakter, klar gerahmter dritter Einstieg */\n  .iqw__igp{ margin-top:32px; padding:16px 20px; border-top:1px solid rgba(var(--color-foreground),.16); border-bottom:1px solid rgba(var(--color-foreground),.16); }\n  .iqw__igp-eyebrow{ display:block; font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#A51D1B; }\n  .iqw__igp-title{ display:inline-flex; align-items:baseline; gap:8px; margin-top:4px; font-family:Archivo,Arial,sans-serif; font-weight:700; font-style:normal; font-size:19px; }\n  .iqw__igp:hover .iqw__igp-title, .iqw__igp:focus-visible .iqw__igp-title{ color:#A51D1B; }\n\n  @media (min-width:750px){\n    .iqw__head{ padding:22px 24px 0; }\n    .iqw__grid{ padding:24px 24px 0; display:grid; grid-template-columns:1fr 1fr; gap:26px; align-items:start; }\n    .iqw__feat + .iqw__feat{ margin-top:0; }\n    .iqw__feat .iqw__cat{ margin-top:14px; }\n    .iqw__feat .iqw__cat, .iqw__feat .iqw__h, .iqw__feat .iqw__t, .iqw__feat .iqw__link{ padding-inline:0; }\n    .iqw__igp{ margin:30px 24px 0; }\n  }\n  @media (min-width:990px){\n    .iqw__head{ max-width:1360px; margin:0 auto; padding:24px 32px 0; }\n    .iqw__grid{ max-width:1360px; margin:0 auto; padding:26px 32px 0; gap:30px; }\n    .iqw__feat .iqw__h{ font-size:24px; }\n    .iqw__igp{ max-width:1360px; margin:30px auto 0; padding:16px 32px; }\n  }\n  @media (prefers-reduced-motion:reduce){ .iqw__link{ transition:none; } }\n.iqw__igp-inline{margin:12px 20px 0;font:400 14px/1.5 Archivo,Arial,sans-serif;text-decoration:underline!important;text-underline-offset:4px}.iqw__grid{padding-bottom:32px}.iqw__head,.iqw__title{border:0!important}.iqw__head:after,.iqw__title:after{display:none!important}@media(min-width:750px){.iqw__igp-inline{margin-inline:0}}\n@media(max-width:749px){.iqw__blog{padding-bottom:24px}}\n</style>\n\n<section class=\"iqw color-scheme-2\">\n  <div class=\"iqw__head\">\n    <p class=\"iqw__eyebrow\">{% if en %}IQ Knowledge{% else %}IQ Wissen{% endif %}</p>\n    <h2 class=\"iqw__title\">{% if en %}Knowledge from world-class experience{% else %}Wissen aus Weltklasse-Erfahrung{% endif %}</h2>\n  </div>\n\n  <div class=\"iqw__grid\">\n\n    {%- comment -%} BLOG {%- endcomment -%}\n    <div class=\"iqw__blog\"><a class=\"iqw__feat\" href=\"{% if en %}/en/blogs/news{% else %}/blogs/news{% endif %}\">\n      <div class=\"iqw__media\">\n        <img src=\"{{ blog_foto | file_url }}&width=1000\" srcset=\"{{ blog_foto | file_url }}&width=400 400w, {{ blog_foto | file_url }}&width=600 600w, {{ blog_foto | file_url }}&width=750 750w, {{ blog_foto | file_url }}&width=800 800w, {{ blog_foto | file_url }}&width=1000 1000w, {{ blog_foto | file_url }}&width=1280 1280w, {{ blog_foto | file_url }}&width=1400 1400w\" sizes=\"(min-width:1360px) 633px, (min-width:990px) calc((100vw - 94px) / 2), (min-width:750px) calc((100vw - 74px) / 2), 100vw\" width=\"1400\" height=\"933\" loading=\"lazy\"\n             alt=\"{{ 'iq_translation.home.knowledge_training_alt' | t | escape }}\">\n      </div>\n      <div class=\"iqw__cat\">Blog</div>\n      <div class=\"iqw__h\">{% if en %}Knowledge for life with your dog{% else %}Wissen für Dein Leben mit Hund{% endif %}</div>\n      <p class=\"iqw__t\">{% if en %}Knowledge, experience and practical tips for life with your dog.{% else %}Wissen, Erfahrungen und praktische Tipps rund um Deinen Hund.{% endif %}</p>\n      <span class=\"iqw__link\">{% if en %}To the blog &rarr;{% else %}Zum Blog &rarr;{% endif %}</span>\n    </a><a class=\"iqw__igp-inline\" href=\"{% if en %}/en/pages/igp-hundesport{% else %}/pages/igp-hundesport{% endif %}\">{% if en %}New to dog sport? What is IGP?{% else %}Neu im Hundesport? Was ist IGP?{% endif %} →</a></div>\n\n    {%- comment -%} BÜCHER {%- endcomment -%}\n    <a class=\"iqw__feat\" href=\"{% if en %}/en/collections/bucher-deutsch{% else %}/collections/bucher-deutsch{% endif %}\">\n      <div class=\"iqw__media\">\n        <img src=\"{{ buch_foto | file_url }}&width=1000\" srcset=\"{{ buch_foto | file_url }}&width=400 400w, {{ buch_foto | file_url }}&width=600 600w, {{ buch_foto | file_url }}&width=750 750w, {{ buch_foto | file_url }}&width=800 800w, {{ buch_foto | file_url }}&width=1000 1000w, {{ buch_foto | file_url }}&width=1280 1280w, {{ buch_foto | file_url }}&width=1400 1400w\" sizes=\"(min-width:1360px) 633px, (min-width:990px) calc((100vw - 94px) / 2), (min-width:750px) calc((100vw - 74px) / 2), 100vw\" width=\"1400\" height=\"933\" loading=\"lazy\"\n             alt=\"{{ 'iq_translation.home.knowledge_book_alt' | t | escape }}\">\n      </div>\n      <div class=\"iqw__cat\">{% if en %}Books{% else %}Bücher{% endif %}</div>\n      <div class=\"iqw__h\">{% if en %}Obedience, protection, BH{% else %}Unterordnung, Schutzdienst, BH{% endif %}</div>\n      <p class=\"iqw__t\">{% if en %}Three books from decades of competition practice.{% else %}Drei Bücher aus jahrzehntelanger Wettkampfpraxis.{% endif %}</p>\n      <span class=\"iqw__link\">{% if en %}Discover books &rarr;{% else %}Bücher entdecken &rarr;{% endif %}</span>\n    </a>\n\n  </div>\n\n  {%- comment -%} WAS IST IGP? – dritter, kompakter Einstieg (bestehende URL) {%- endcomment -%}\n\n</section>",
        "color_scheme": "scheme-2",
        "padding_top": 0,
        "padding_bottom": 0,
        "custom_class": ""
      }
    },
    "custom_liquid_XLrBYx": {
      "type": "custom-liquid",
      "name": "SEO",
      "settings": {
        "custom_liquid": "{%- assign en = false -%}\n{%- if request.locale.iso_code == 'en' -%}\n  {%- assign en = true -%}\n{%- endif -%}\n\n<style>\n.iqseo,.iqseo *{box-sizing:border-box}\n.iqseo{width:100%;background:#000000;color:#F5F4F2;font-family:Archivo,Arial,sans-serif;border-top:0}\n.iqseo .iqseo__wrap.page-width{width:100%;max-width:1360px;margin:0 auto;padding:24px 20px}\n.iqseo .iqseo__h2{margin:0;color:#F5F4F2;font:700 18px/1.4 Archivo,Arial,sans-serif;letter-spacing:0;text-transform:none}\n.iqseo .iqseo__intro{margin:8px 0 0;max-width:none;color:#BDBDB9;font-size:14px;line-height:1.6}\n.iqseo .iqseo__more{margin:14px 0 0;border:0}\n.iqseo .iqseo__toggle{display:flex;align-items:center;gap:12px;width:fit-content;max-width:100%;min-height:44px;padding:8px 0;list-style:none;cursor:pointer;color:#F5F4F2;font:400 14px/1.5 Archivo,Arial,sans-serif}\n.iqseo .iqseo__toggle::-webkit-details-marker{display:none}\n.iqseo .iqseo__toggle::marker{content:\"\"}\n.iqseo .iqseo__toggle:hover{color:#F5F4F2}\n.iqseo .iqseo__toggle:focus-visible,.iqseo a:focus-visible{outline:2px solid #F5F4F2;outline-offset:4px}\n.iqseo .iqseo__icon{position:relative;width:12px;height:12px;flex:0 0 12px}\n.iqseo .iqseo__icon::before,.iqseo .iqseo__icon::after{content:\"\";position:absolute;left:0;top:5px;width:12px;height:1px;background:currentColor}\n.iqseo .iqseo__icon::after{transform:rotate(90deg)}\n.iqseo .iqseo__more[open]>.iqseo__toggle .iqseo__icon::after{display:none}\n.iqseo .iqseo__expanded{padding-top:16px}\n.iqseo .iqseo__t p,.iqseo .iqseo__details-content p{max-width:none;margin:0 0 12px;color:#BDBDB9;font-size:14px;line-height:1.7}\n.iqseo .iqseo__t p:last-child,.iqseo .iqseo__details-content p:last-child{margin-bottom:0}\n.iqseo .iqseo__h3{margin:0 0 8px;color:#F5F4F2;font:700 15px/1.5 Archivo,Arial,sans-serif;text-transform:none;letter-spacing:0}\n.iqseo .iqseo__cats-block{margin-top:24px}\n.iqseo .iqseo__cats{display:flex;flex-wrap:wrap;gap:10px 20px;margin:0;font-size:13.5px;line-height:1.6}\n.iqseo .iqseo__cats a{color:#BDBDB9;text-decoration:underline;text-underline-offset:3px;white-space:normal}\n.iqseo .iqseo__cats a:hover{color:#F5F4F2}\n.iqseo .iqseo__sep{display:none}\n.iqseo .iqseo__accordions{display:grid;gap:24px;margin-top:28px}\n.iqseo .iqseo__topic{min-width:0}\n@media(min-width:750px){\n.iqseo .iqseo__wrap.page-width{padding:28px 32px}\n.iqseo .iqseo__accordions{grid-template-columns:minmax(0,1fr);gap:20px}\n}\n</style>\n\n<section class=\"iqseo\">\n  <div class=\"iqseo__wrap page-width\">\n    <div class=\"iqseo__col\">\n\n<h2 class=\"iqseo__h2\">{% if en %}IQ Dogsport – Your Dog Sport Shop{% else %}IQ Dogsport - Dein Hundesport Shop{% endif %}</h2>\n\n      <p class=\"iqseo__intro\">{% if en %}Dog sport clothing and training equipment for IGP, competition and everyday life with your dog.{% else %}Hundesportbekleidung und Trainingsausrüstung für IGP, Wettkampf und den Alltag mit Deinem Hund.{% endif %}</p>\n      <details class=\"iqseo__more\">\n        <summary class=\"iqseo__toggle\">\n          <span>{% if en %}More about IQ Dogsport{% else %}Mehr über IQ Dogsport{% endif %}</span>\n          <span class=\"iqseo__icon\" aria-hidden=\"true\"></span>\n        </summary>\n        <div class=\"iqseo__expanded\">\n      <div class=\"iqseo__t iqseo__lead\">\n        {% if en %}\n          <p>IQ Dogsport stands for functional dog sport clothing, training accessories and equipment for IGP and service dog work. Our vests, jackets, trousers, harnesses and training products come from real training practice – for training, competition and everyday use.</p>\n          <p>Thoughtfully designed, hard-wearing and in use worldwide by dog sport competitors and service dog handlers.</p>\n        {% else %}\n          <p>IQ Dogsport steht für funktionale Hundesportbekleidung, Trainingszubehör und Ausrüstung für IGP und Diensthundearbeit. Unsere Westen, Jacken, Hosen, Geschirre und Trainingsprodukte entstehen aus echter Praxis – für Training, Wettkampf und Alltag.</p>\n          <p>Durchdacht, langlebig und weltweit im Einsatz bei Hundesportlern und Diensthundeführern.</p>\n        {% endif %}\n      </div>\n\n      <div class=\"iqseo__cats-block\">\n        <h3 class=\"iqseo__h3\">{% if en %}Popular categories{% else %}Beliebte Kategorien{% endif %}</h3>\n        {%- if en -%}\n          <p class=\"iqseo__cats\"><a href=\"/en/collections/hundesport-jacken\">Dog Sport Jackets</a><span class=\"iqseo__sep\">&middot;</span><a href=\"/en/collections/hundesport-westen\">Dog Sport Vests</a><span class=\"iqseo__sep\">&middot;</span><a href=\"/en/collections/hundesport-hosen\">Dog Training Pants</a><span class=\"iqseo__sep\">&middot;</span><a href=\"/en/collections/hundesport-trainingszubehoer\">Dog Sport Training Equipment</a><span class=\"iqseo__sep\">&middot;</span><a href=\"/en/collections/dog-training-toys\">Dog Training Toys</a><span class=\"iqseo__sep\">&middot;</span><a href=\"/en/collections/hundesportbekleidung-damen\">Women&rsquo;s Dog Sport Clothing</a><span class=\"iqseo__sep\">&middot;</span><a href=\"/en/collections/hundesportbekleidung-herren\">Men&rsquo;s Dog Training Clothing</a><span class=\"iqseo__sep\">&middot;</span><a href=\"/en/collections/hundesport-zubehoer-damen\">Dog Sport Accessories</a></p>\n        {%- else -%}\n          <p class=\"iqseo__cats\"><a href=\"/collections/hundesport-jacken\">Hundesportjacken</a><span class=\"iqseo__sep\">&middot;</span><a href=\"/collections/hundesport-westen\">Hundesportwesten</a><span class=\"iqseo__sep\">&middot;</span><a href=\"/collections/hundesport-hosen\">Hundesporthosen</a><span class=\"iqseo__sep\">&middot;</span><a href=\"/collections/hundesport-trainingszubehoer\">Hundesport Trainingszubeh&ouml;r</a><span class=\"iqseo__sep\">&middot;</span><a href=\"/collections/hundesport-spielzeug\">Hundespielzeug</a><span class=\"iqseo__sep\">&middot;</span><a href=\"/collections/hundesportbekleidung-damen\">Hundesportbekleidung Damen</a><span class=\"iqseo__sep\">&middot;</span><a href=\"/collections/hundesportbekleidung-herren\">Hundesportbekleidung Herren</a><span class=\"iqseo__sep\">&middot;</span><a href=\"/collections/hundesport-zubehoer-damen\">Zubeh&ouml;r f&uuml;r Hundesport</a></p>\n        {%- endif -%}\n      </div>\n\n<div class=\"iqseo__accordions\">\n\n        <div class=\"iqseo__topic\">\n          <h3 class=\"iqseo__h3\">{% if en %}Dog sport equipment for IGP, training and professional use{% else %}Ausrüstung für Hundesport und Diensthund{% endif %}</h3>\n          <div class=\"iqseo__details-content\">\n            {% if en %}<p>Designed for working dogs in training and operational environments. Built for precision in IGP obedience, tracking, protection work and everyday handling.</p>\n            {% else %}<p>Entwickelt für Gebrauchshunde im Training und Einsatz. Durchdachte Ausrüstung für präzises Arbeiten in IGP, Unterordnung, Fährte und Schutzdienst.</p>{% endif %}\n          </div>\n        </div>\n\n        <div class=\"iqseo__topic\">\n          <h3 class=\"iqseo__h3\">{% if en %}A training system built for precision{% else %}Trainingssystem für präzises Arbeiten{% endif %}</h3>\n          <div class=\"iqseo__details-content\">\n            {% if en %}<p>Patented solutions for cleaner front positions and more precise heelwork. Hidden rewards, perfect timing and repeatable training routines that produce reliable results.</p>\n            {% else %}<p>Patentierte Lösungen für sauberen Vorsitz und kontrolliertes Fußlaufen. Versteckte Bestätigung, klares Timing und reproduzierbare Abläufe im Training.</p>{% endif %}\n          </div>\n        </div>\n\n        <div class=\"iqseo__topic\">\n          <h3 class=\"iqseo__h3\">{% if en %}Handler training jackets for every condition{% else %}Jacken für jedes Wetter{% endif %}</h3>\n          <div class=\"iqseo__details-content\">\n            {% if en %}<p>Durable materials, a 20,000 mm waterproof rating and purpose-built pocket systems. Large rear storage pocket for leashes and toys, plus removable food pockets for efficient training sessions.</p>\n            {% else %}<p>Robuste Materialien, 20.000 mm Wassersäule und durchdachte Taschenlösungen. Große Rückentasche für Leinen und Spielzeug. Herausnehmbare Futtertaschen für sauberes Arbeiten im Training.</p>{% endif %}\n          </div>\n        </div>\n\n        <div class=\"iqseo__topic\">\n          <h3 class=\"iqseo__h3\">{% if en %}Harnesses for protection work and pulling sports{% else %}Geschirre für Schutzdienst und Zugarbeit{% endif %}</h3>\n          <div class=\"iqseo__details-content\">\n            {% if en %}<p>Engineered for unrestricted breathing under load and maximum control. Suitable for protection training, and pulling activities without limiting the dog&rsquo;s movement.</p>\n            {% else %}<p>Konstruiert für freie Atmung unter Zug und maximale Kontrolle. Für Leinenarbeit, Schutzdienst, Fährte und Zugarbeit ohne Einschränkung.</p>{% endif %}\n          </div>\n        </div>\n\n      </div>\n\n        </div>\n      </details>\n    </div>\n  </div>\n</section>",
        "color_scheme": "scheme-2",
        "padding_top": 0,
        "padding_bottom": 0,
        "custom_class": ""
      }
    },
