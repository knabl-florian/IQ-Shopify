      "settings": {
        "custom_liquid": "{% assign is_en = false %}\n{% if request.locale.iso_code contains 'en' %}\n  {% assign is_en = true %}\n{% endif %}\n\n{% if is_en %}\n  {% assign shop_url = '/en/collections/all' %}\n  {% assign vest_url = '/en/products/iq-sommerweste-3-0-unisex' %}\n  {% assign magnet_url = '/en/products/iq-magnettasche' %}\n{% else %}\n  {% assign shop_url = '/collections/all' %}\n  {% assign vest_url = '/products/iq-sommerweste-3-0-unisex' %}\n  {% assign magnet_url = '/products/iq-magnettasche' %}\n{% endif %}\n\n<style>\n.section:has(.gw-wrap){\n  padding-top:0 !important;\n  padding-bottom:0 !important;\n  margin-top:0 !important;\n  margin-bottom:0 !important;\n}\n\n.section:has(.gw-wrap) .section--padding,\n.section:has(.gw-wrap) .section__wrapper,\n.section:has(.gw-wrap) .page-width{\n  padding-top:0 !important;\n  padding-bottom:0 !important;\n}\n\n.gw-wrap{\n  font-family:var(--font-body-family);\n  color:rgb(var(--color-foreground));\n  background:rgb(var(--color-background));\n}\n\n.gw-section{\n  padding:56px 20px;\n  background:rgb(var(--color-background));\n  color:rgb(var(--color-foreground));\n}\n\n.gw-section--soft{\n  background:rgb(var(--color-secondary-background));\n}\n\n.gw-section--dark{\n  background:#000;\n  color:#fff;\n}\n\n.gw-section--primary{\n  background:rgb(var(--color-primary));\n  color:#fff;\n}\n\n.gw-container{\n  max-width:980px;\n  margin:auto;\n}\n\n.gw-center{\n  text-align:center;\n}\n\n.gw-badge{\n  display:inline-block;\n  background:rgb(var(--color-primary));\n  color:#fff;\n  padding:7px 15px;\n  border-radius:var(--badges-radius);\n  font-family:var(--font-button-family);\n  font-weight:var(--font-button-weight);\n  text-transform:var(--buttons-transform);\n  font-size:12px;\n  line-height:1;\n  margin-bottom:16px;\n}\n\n.gw-section--primary .gw-badge,\n.gw-section--dark .gw-badge{\n  background:rgb(var(--color-background));\n  color:rgb(var(--color-foreground));\n}\n\n.gw-title{\n  font-family:var(--font-heading-family);\n  font-style:var(--font-heading-style);\n  font-weight:var(--font-heading-weight);\n  letter-spacing:var(--font-heading-letter-spacing);\n  text-transform:var(--font-heading-transform);\n  font-size:var(--font-hd2-size);\n  line-height:.95;\n  margin:0 0 18px;\n  color:inherit;\n}\n\n.gw-text{\n  font-family:var(--font-body-family);\n  font-size:var(--font-body-size);\n  line-height:var(--font-body-line-height);\n  max-width:680px;\n  margin:0 auto 24px;\n  color:inherit;\n}\n\n.gw-btn{\n  display:inline-flex;\n  align-items:center;\n  justify-content:center;\n  min-height:var(--buttons-height);\n  padding:0 28px;\n  border-radius:var(--buttons-radius);\n  background:rgb(var(--color-button));\n  color:rgb(var(--color-button-text));\n  font-family:var(--font-button-family);\n  font-weight:var(--font-button-weight);\n  letter-spacing:var(--buttons-letter-spacing);\n  text-transform:var(--buttons-transform);\n  text-decoration:none;\n}\n\n.gw-section--primary .gw-btn,\n.gw-section--dark .gw-btn{\n  background:#000;\n  color:#fff;\n}\n\n.gw-btn:hover{\n  background:rgb(var(--color-button-hover-background));\n  color:rgb(var(--color-button-hover-text));\n}\n\n.gw-count{\n  display:flex;\n  justify-content:center;\n  gap:12px;\n  flex-wrap:wrap;\n  margin:26px 0;\n}\n\n.gw-time{\n  background:rgb(var(--color-background));\n  color:rgb(var(--color-foreground));\n  border:1px solid rgb(var(--color-border));\n  border-radius:var(--pcard-radius);\n  padding:14px 18px;\n  min-width:90px;\n}\n\n.gw-time strong{\n  display:block;\n  font-family:var(--font-heading-family);\n  font-style:var(--font-heading-style);\n  font-weight:var(--font-heading-weight);\n  font-size:28px;\n  line-height:1;\n}\n\n.gw-products{\n  display:grid;\n  grid-template-columns:repeat(2,1fr);\n  gap:22px;\n  margin-top:34px;\n}\n\n.gw-product{\n  background:rgb(var(--color-background));\n  border:1px solid rgb(var(--color-border));\n  border-radius:var(--pcard-radius);\n  padding:32px;\n  text-align:left;\n  text-decoration:none;\n  color:rgb(var(--color-foreground));\n  transition:transform .25s ease, box-shadow .25s ease;\n}\n\n.gw-product:hover{\n  transform:translateY(-3px);\n  box-shadow:0 12px 32px rgba(0,0,0,.08);\n}\n\n.gw-product h3{\n  font-family:var(--font-heading-family);\n  font-style:var(--font-heading-style);\n  font-weight:var(--font-heading-weight);\n  text-transform:var(--font-heading-transform);\n  font-size:var(--font-h3-size);\n  line-height:1;\n  margin:0 0 12px;\n  color:inherit;\n}\n\n.gw-product p{\n  margin:0 0 24px;\n  color:inherit;\n}\n\n.gw-product span{\n  font-family:var(--font-button-family);\n  font-weight:var(--font-button-weight);\n  text-transform:var(--buttons-transform);\n  color:rgb(var(--color-primary));\n}\n\n.gw-benefits{\n  display:grid;\n  grid-template-columns:repeat(3,1fr);\n  gap:18px;\n  margin-top:34px;\n}\n\n.gw-benefit{\n  background:rgb(var(--color-background));\n  border:1px solid rgb(var(--color-border));\n  border-radius:var(--pcard-radius);\n  padding:24px;\n}\n\n.gw-benefit h3{\n  font-family:var(--font-heading-family);\n  font-style:var(--font-heading-style);\n  font-weight:var(--font-heading-weight);\n  text-transform:var(--font-heading-transform);\n  font-size:var(--font-h4-size);\n  line-height:1;\n  margin:0 0 10px;\n}\n\n.gw-benefit p{\n  margin:0;\n}\n\n.gw-faq details{\n  border-bottom:1px solid rgb(var(--color-border));\n  padding:16px 0;\n}\n\n.gw-faq summary{\n  cursor:pointer;\n  font-family:var(--font-button-family);\n  font-weight:var(--font-button-weight);\n  text-transform:var(--buttons-transform);\n}\n\n.gw-faq p{\n  margin:12px 0 0;\n}\n\n@media(max-width:749px){\n  .gw-section{\n    padding:38px 16px;\n  }\n\n  .gw-title{\n    font-size:clamp(3rem,11vw,4.4rem);\n    line-height:.95;\n  }\n\n  .gw-text{\n    font-size:1.5rem;\n    line-height:1.55;\n  }\n\n  .gw-btn{\n    width:100%;\n    max-width:320px;\n  }\n\n  .gw-count{\n    display:grid;\n    grid-template-columns:repeat(2,1fr);\n    gap:10px;\n  }\n\n  .gw-time{\n    min-width:0;\n    padding:12px 8px;\n  }\n\n  .gw-products,\n  .gw-benefits{\n    grid-template-columns:1fr;\n  }\n\n  .gw-product{\n    padding:24px;\n  }\n}\n</style>\n\n<div class=\"gw-wrap\">\n\n  <section class=\"gw-section gw-center\">\n    <div class=\"gw-container\">\n      <div class=\"gw-badge\">\n        {% if is_en %}Entry confirmed{% else %}Teilnahme bestätigt{% endif %}\n      </div>\n\n      <h1 class=\"gw-title\">\n        {% if is_en %}You are in.{% else %}Du bist dabei.{% endif %}\n      </h1>\n\n      <p class=\"gw-text\">\n        {% if is_en %}\n          Your entry for the Summer Giveaway has been successfully registered.\n          You are now in the draw for 1× IQ Summer Vest + IQ Ball Pocket.\n        {% else %}\n          Deine Teilnahme am Sommer-Gewinnspiel wurde erfolgreich registriert.\n          Du bist jetzt im Lostopf für 1× IQ Sommerweste + IQ Balltasche.\n        {% endif %}\n      </p>\n\n      <p class=\"gw-text\">\n        {% if is_en %}\n          The winner will be notified by email after 27 July 2026.\n        {% else %}\n          Der Gewinner wird nach dem 27.07.2026 per E-Mail benachrichtigt.\n        {% endif %}\n      </p>\n\n      <a class=\"gw-btn\" href=\"{{ vest_url }}\">\n        {% if is_en %}View summer vest{% else %}Sommerweste ansehen{% endif %}\n      </a>\n    </div>\n  </section>\n\n  <section class=\"gw-section gw-section--primary gw-center\">\n    <div class=\"gw-container\">\n      <h2 class=\"gw-title\">\n        {% if is_en %}Ends soon.{% else %}Endet bald.{% endif %}\n      </h2>\n\n      <p class=\"gw-text\">\n        {% if is_en %}\n          Entry closes on 27 July 2026 at 23:59.\n        {% else %}\n          Teilnahmeschluss ist der 27.07.2026 um 23:59 Uhr.\n        {% endif %}\n      </p>\n\n      <div class=\"gw-count\">\n        <div class=\"gw-time\"><strong id=\"gw-days\">--</strong>{% if is_en %}Days{% else %}Tage{% endif %}</div>\n        <div class=\"gw-time\"><strong id=\"gw-hours\">--</strong>{% if is_en %}Hours{% else %}Stunden{% endif %}</div>\n        <div class=\"gw-time\"><strong id=\"gw-mins\">--</strong>{% if is_en %}Minutes{% else %}Minuten{% endif %}</div>\n        <div class=\"gw-time\"><strong id=\"gw-secs\">--</strong>{% if is_en %}Seconds{% else %}Sekunden{% endif %}</div>\n      </div>\n\n      <a class=\"gw-btn\" href=\"{{ shop_url }}\">\n        {% if is_en %}Shop now{% else %}Jetzt shoppen{% endif %}\n      </a>\n    </div>\n  </section>\n\n  <section class=\"gw-section gw-section--dark gw-center\">\n    <div class=\"gw-container\">\n      <div class=\"gw-badge\">Hidden Reward</div>\n\n      <h2 class=\"gw-title\">\n        {% if is_en %}\n          Reward at the right moment.\n        {% else %}\n          Belohnung im richtigen Moment.\n        {% endif %}\n      </h2>\n\n      <p class=\"gw-text\">\n        {% if is_en %}\n          The toy stays invisible until you release it. Your dog works for you — not for the visible reward.\n        {% else %}\n          Das Spielzeug bleibt unsichtbar, bis du es freigibst. So arbeitet dein Hund für dich — nicht für die sichtbare Belohnung.\n        {% endif %}\n      </p>\n    </div>\n  </section>\n\n  <section class=\"gw-section gw-section--soft\">\n    <div class=\"gw-container gw-center\">\n      <div class=\"gw-badge\">\n        {% if is_en %}The setup{% else %}Das Setup{% endif %}\n      </div>\n\n      <h2 class=\"gw-title\">\n        {% if is_en %}\n          Two products. One goal.\n        {% else %}\n          Zwei Produkte. Ein Ziel.\n        {% endif %}\n      </h2>\n\n      <p class=\"gw-text\">\n        {% if is_en %}\n          More precise reward timing, cleaner heelwork and a training system that works when it matters.\n        {% else %}\n          Präzisere Bestätigung, klarere Fußarbeit und ein Trainingssystem, das im richtigen Moment funktioniert.\n        {% endif %}\n      </p>\n\n      <div class=\"gw-products\">\n        <a class=\"gw-product\" href=\"{{ vest_url }}\">\n          <h3>\n            {% if is_en %}IQ Summer Vest{% else %}IQ Sommerweste{% endif %}\n          </h3>\n          <p>\n            {% if is_en %}\n              Lightweight, functional and made for warm training days.\n            {% else %}\n              Leicht, funktional und gemacht für warme Trainingstage.\n            {% endif %}\n          </p>\n          <span>{% if is_en %}View now →{% else %}Jetzt ansehen →{% endif %}</span>\n        </a>\n\n        <a class=\"gw-product\" href=\"{{ magnet_url }}\">\n          <h3>\n            {% if is_en %}IQ Magnet Pocket{% else %}IQ Magnettasche{% endif %}\n          </h3>\n          <p>\n            {% if is_en %}\n              Practical for rewards, food and training accessories.\n            {% else %}\n              Praktisch für Belohnung, Futter und Zubehör im Training.\n            {% endif %}\n          </p>\n          <span>{% if is_en %}View now →{% else %}Jetzt ansehen →{% endif %}</span>\n        </a>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"gw-section\">\n    <div class=\"gw-container gw-center\">\n      <div class=\"gw-badge\">\n        {% if is_en %}Why it works{% else %}Warum es funktioniert{% endif %}\n      </div>\n\n      <h2 class=\"gw-title\">\n        {% if is_en %}\n          Less visible. More focus.\n        {% else %}\n          Weniger sichtbar. Mehr Fokus.\n        {% endif %}\n      </h2>\n\n      <div class=\"gw-benefits\">\n        <div class=\"gw-benefit\">\n          <h3>Hidden Reward</h3>\n          <p>\n            {% if is_en %}\n              The reward stays invisible until you release it.\n            {% else %}\n              Die Belohnung bleibt unsichtbar, bis du sie bewusst freigibst.\n            {% endif %}\n          </p>\n        </div>\n\n        <div class=\"gw-benefit\">\n          <h3>\n            {% if is_en %}Summer material{% else %}Sommermaterial{% endif %}\n          </h3>\n          <p>\n            {% if is_en %}\n              Lightweight material for warm training days.\n            {% else %}\n              Leichtes Material für Trainingstage bei warmem Wetter.\n            {% endif %}\n          </p>\n        </div>\n\n        <div class=\"gw-benefit\">\n          <h3>\n            {% if is_en %}Clear reward{% else %}Klare Bestätigung{% endif %}\n          </h3>\n          <p>\n            {% if is_en %}\n              Helps your dog focus more on you.\n            {% else %}\n              Hilft deinem Hund, sich stärker auf dich zu konzentrieren.\n            {% endif %}\n          </p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"gw-section gw-section--soft\">\n    <div class=\"gw-container gw-faq\">\n      <div class=\"gw-center\">\n        <div class=\"gw-badge\">FAQ</div>\n        <h2 class=\"gw-title\">\n          {% if is_en %}Questions{% else %}Fragen{% endif %}\n        </h2>\n      </div>\n\n      <details>\n        <summary>{% if is_en %}Do I have to buy something?{% else %}Muss ich etwas kaufen?{% endif %}</summary>\n        <p>{% if is_en %}No. Entry is free.{% else %}Nein. Die Teilnahme ist kostenlos.{% endif %}</p>\n      </details>\n\n      <details>\n        <summary>{% if is_en %}When does the giveaway end?{% else %}Wann endet das Gewinnspiel?{% endif %}</summary>\n        <p>{% if is_en %}On 27 July 2026 at 23:59.{% else %}Am 27.07.2026 um 23:59 Uhr.{% endif %}</p>\n      </details>\n\n      <details>\n        <summary>{% if is_en %}How will I be notified?{% else %}Wie werde ich informiert?{% endif %}</summary>\n        <p>{% if is_en %}The winner will be notified by email.{% else %}Der Gewinner wird per E-Mail benachrichtigt.{% endif %}</p>\n      </details>\n\n      <details>\n        <summary>{% if is_en %}What can I win?{% else %}Was wird verlost?{% endif %}</summary>\n        <p>{% if is_en %}1× IQ Summer Vest including IQ Ball Pocket.{% else %}1× IQ Sommerweste inklusive IQ Balltasche.{% endif %}</p>\n      </details>\n    </div>\n  </section>\n\n  <section class=\"gw-section gw-section--primary gw-center\">\n    <div class=\"gw-container\">\n      <h2 class=\"gw-title\">\n        {% if is_en %}Good luck.{% else %}Viel Glück.{% endif %}\n      </h2>\n\n      <p class=\"gw-text\">\n        {% if is_en %}\n          Until the draw, you can discover our training setup.\n        {% else %}\n          Bis zur Auslosung kannst du unser Trainings-Setup entdecken.\n        {% endif %}\n      </p>\n\n      <a class=\"gw-btn\" href=\"{{ shop_url }}\">\n        {% if is_en %}Continue shopping{% else %}Weiter shoppen{% endif %}\n      </a>\n    </div>\n  </section>\n\n</div>\n\n<script>\n(function(){\n  var endDate = new Date(\"2026-07-27T23:59:00\").getTime();\n\n  function updateCountdown(){\n    var diff = endDate - new Date().getTime();\n\n    if(diff < 0){\n      diff = 0;\n    }\n\n    var days = Math.floor(diff / (1000 * 60 * 60 * 24));\n    var hours = Math.floor((diff / (1000 * 60 * 60)) % 24);\n    var mins = Math.floor((diff / (1000 * 60)) % 60);\n    var secs = Math.floor((diff / 1000) % 60);\n\n    var daysEl = document.getElementById(\"gw-days\");\n    var hoursEl = document.getElementById(\"gw-hours\");\n    var minsEl = document.getElementById(\"gw-mins\");\n    var secsEl = document.getElementById(\"gw-secs\");\n\n    if(daysEl) daysEl.innerHTML = days;\n    if(hoursEl) hoursEl.innerHTML = hours;\n    if(minsEl) minsEl.innerHTML = mins;\n    if(secsEl) secsEl.innerHTML = secs;\n  }\n\n  updateCountdown();\n  setInterval(updateCountdown, 1000);\n})();\n</script>",
