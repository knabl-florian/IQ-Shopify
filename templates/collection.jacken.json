            "width": "full",
            "custom_liquid": "<style>\n  .iq-jrev3{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;align-items:stretch;}\n  .iq-jrev3__c{background:#FFFFFF;border:1px solid #DCDBD7;padding:18px 18px 16px;\n               display:flex;flex-direction:column;}\n  .iq-jrev3__stars{display:flex;gap:2px;margin:0 0 10px;}\n  .iq-jrev3__stars svg{width:16px;height:16px;color:#FFB400;fill:#FFB400;}\n  .iq-jrev3__q{margin:0 0 12px;font-size:14.5px;line-height:1.5;color:#171717;}\n  .iq-jrev3__m{margin:auto 0 0;font-size:12.5px;line-height:1.4;color:#171717;opacity:.55;}\n  .iq-jrev3__m b{opacity:1;}\n\n  /* MOBIL: eine Reihe zum Wischen, Block auf voller Fensterbreite,\n     letzte Karte angeschnitten als Wisch-Hinweis. */\n  @media (max-width:749px){\n    .iq-jrev3{display:flex;gap:8px;\n              width:100vw;margin-left:50%;transform:translateX(-50%);\n              padding:0 16px 4px;overflow-x:auto;\n              scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch;\n              scrollbar-width:none;}\n    .iq-jrev3::-webkit-scrollbar{display:none;}\n    .iq-jrev3__c{flex:0 0 82%;scroll-snap-align:start;padding:15px 15px 14px;}\n  }\n</style>\n\n{%- capture j3star -%}<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3l2.7 5.6 6.1.8-4.4 4.3 1.1 6.1L12 17l-5.5 2.8 1.1-6.1L3.2 9.4l6.1-.8z\"/></svg>{%- endcapture -%}\n{%- capture j3stars -%}<div class=\"iq-jrev3__stars\">{{ j3star }}{{ j3star }}{{ j3star }}{{ j3star }}{{ j3star }}</div>{%- endcapture -%}\n\n<div class=\"iq-jrev3\">\n\n{%- if request.locale.iso_code == 'en' -%}\n  <div class=\"iq-jrev3__c\">\n    {{ j3stars }}\n    <p class=\"iq-jrev3__q\">&bdquo;Keeps me warm, shrugs off rain and snow, and takes every jump from my Mali.&ldquo;</p>\n    <p class=\"iq-jrev3__m\">Multifunction Jacket 3.0 &middot; Verified purchase</p>\n  </div>\n  <div class=\"iq-jrev3__c\">\n    {{ j3stars }}\n    <p class=\"iq-jrev3__q\">&bdquo;Brilliantly designed side pockets for treats and a big back pocket.&ldquo;</p>\n    <p class=\"iq-jrev3__m\">Multifunction Jacket 3.0 &middot; Verified purchase</p>\n  </div>\n  <div class=\"iq-jrev3__c\">\n    {{ j3stars }}\n    <p class=\"iq-jrev3__q\">&bdquo;I used to carry several jackets and pull a vest over them. With this jacket, that's finally over. Highly recommended!&ldquo;</p>\n    <p class=\"iq-jrev3__m\"><b>Dirk</b> &middot; Training Jacket 2.0 &middot; Verified purchase</p>\n  </div>\n\n{%- else -%}\n  <div class=\"iq-jrev3__c\">\n    {{ j3stars }}\n    <p class=\"iq-jrev3__q\">&bdquo;H&auml;lt warm, vertr&auml;gt Regen und Schnee, h&auml;lt jeden Sprung vom Mali stand.&ldquo;</p>\n    <p class=\"iq-jrev3__m\">Multifunktionsjacke 3.0 &middot; Verifizierter Kauf</p>\n  </div>\n  <div class=\"iq-jrev3__c\">\n    {{ j3stars }}\n    <p class=\"iq-jrev3__q\">&bdquo;Mega durchdachte Seitentaschen f&uuml;r Leckerlies und gro&szlig;e R&uuml;ckentasche.&ldquo;</p>\n    <p class=\"iq-jrev3__m\">Multifunktionsjacke 3.0 &middot; Verifizierter Kauf</p>\n  </div>\n  <div class=\"iq-jrev3__c\">\n    {{ j3stars }}\n    <p class=\"iq-jrev3__q\">&bdquo;Fr&uuml;her habe ich immer mehrere Jacken dabei gehabt und dann ne Weste dr&uuml;ber gezogen. Das ist mit dieser Jacke endlich vorbei. Nur zu empfehlen!&ldquo;</p>\n    <p class=\"iq-jrev3__m\"><b>Dirk</b> &middot; Trainingsjacke 2.0 &middot; Verifizierter Kauf</p>\n  </div>\n{%- endif -%}\n\n</div>"
