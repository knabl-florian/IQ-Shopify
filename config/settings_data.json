      "h4,h5,h6,.h4:not(h1),.h5:not(h1),.h6:not(h1) {text-transform: none;}",
      "@media (min-width: 1024px) {.iq-athletes > .page-width, .footer .footer__top.page-width, .footer .footer__bottom.page-width {box-sizing: border-box; width: 100%; max-width: 1360px; margin-left: auto; margin-right: auto; padding-left: 32px !important; padding-right: 32px !important; }}",
      "/* Filterbereich nicht in den Collection-Banner ziehen */body.collection-template #ProductGridWrapper.show-toolbar {margin-block-start: 0 !important; margin-top: 0 !important;}"
