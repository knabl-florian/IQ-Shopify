{{ 'iq-home-refresh.css' | asset_url | stylesheet_tag }}
{% liquid
 assign en = false
 if request.locale.iso_code == 'en'
 assign en = true
 endif
%}
<section class="iqh iqh-categories"><div class="iqh-wrap"><h2 class="iqh-heading">{% if en and section.settings.heading_en != blank %}{{ section.settings.heading_en | escape }}{% else %}{{ section.settings.heading | escape }}{% endif %}</h2><div class="iqh-category-grid">{% for block in section.blocks %}{% assign category = block.settings.collection %}{% if category != blank %}<a class="iqh-category" style="--iqh-category-desktop-y:{{ block.settings.position_y | default: 0 }}%;--iqh-category-mobile-y:{{ block.settings.mobile_position_y | default: 0 }}%" href="{{ category.url }}" {{ block.shopify_attributes }}>{% assign photo = block.settings.image | default: category.image %}{% if photo != blank %}<picture>{% if block.settings.mobile_image != blank %}<source media="(max-width:749px)" srcset="{{ block.settings.mobile_image | image_url: width: 540 }}">{% endif %}{% assign alt = block.settings.alt %}{% if en and block.settings.alt_en != blank %}{% assign alt = block.settings.alt_en %}{% endif %}{{ photo | image_url: width: 1000 | image_tag: widths: '240,360,540,720,1000', sizes: '(min-width:1360px) 416px, (min-width:750px) 31vw, 44vw', loading: 'lazy', alt: alt, style: 'object-position:50% var(--iqh-category-current-y,0%)' }}</picture>{% endif %}<span class="iqh-category-label"><span>{% if en and block.settings.title_en != blank %}{{ block.settings.title_en | escape }}{% else %}{{ block.settings.title | escape }}{% endif %}</span><span class="iqh-category-arrow" aria-hidden="true">↗</span></span></a>{% endif %}{% endfor %}</div></div></section>
{% schema %}
{
  "name": "IQ Start · Kategorien",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift · DE"
    },
    {
      "type": "text",
      "id": "heading_en",
      "label": "Überschrift · EN"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "category",
      "name": "Kategorie",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Kollektion"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobilfoto (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel · DE"
        },
        {
          "type": "text",
          "id": "title_en",
          "label": "Titel · EN"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Bildbeschreibung · DE"
        },
        {
          "type": "text",
          "id": "alt_en",
          "label": "Bildbeschreibung · EN"
        },
        {
          "type": "range",
          "id": "position_y",
          "label": "Bildausschnitt vertikal · Desktop",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 0,
          "info": "0 = oben, 50 = mittig, 100 = unten. Köpfe und Ohren sichtbar halten."
        },
        {
          "type": "range",
          "id": "mobile_position_y",
          "label": "Bildausschnitt vertikal · Mobil",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IQ Start · Kategorien"
    }
  ]
}
{% endschema %}
