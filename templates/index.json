        "custom_liquid": "{%- comment -%}\nNEWSLETTER-ABSCHNITT „IQ INSIDER\"\nStartseite > Abschnitt hinzufügen > Custom Liquid\nzwischen Instagram-Feed und SEO-Text ziehen\n{%- endcomment -%}\n\n{%- if request.locale.iso_code == 'en' -%}\n  {%- assign nl_kicker = 'IQ INSIDER' -%}\n  {%- assign nl_head = '10% off your first order' -%}\n  {%- assign nl_sub = 'New gear, training knowledge and early access. Straight to your inbox.' -%}\n  {%- assign nl_label = 'Email address' -%}\n  {%- assign nl_ph = 'your@email.com' -%}\n  {%- assign nl_btn = 'Get my code' -%}\n  {%- assign nl_consent = 'By signing up you accept our' -%}\n  {%- assign nl_consent_link = 'privacy policy' -%}\n  {%- assign nl_err = 'Please enter a valid email address.' -%}\n  {%- assign nl_ok_h = 'Almost there.' -%}\n  {%- assign nl_ok_t = 'Check your inbox and confirm the link &mdash; your code follows right after.' -%}\n{%- else -%}\n  {%- assign nl_kicker = 'IQ INSIDER' -%}\n  {%- assign nl_head = '10 % auf deine erste Bestellung' -%}\n  {%- assign nl_sub = 'Neue Produkte, Trainingswissen und Aktionen. Direkt ins Postfach.' -%}\n  {%- assign nl_label = 'E-Mail-Adresse' -%}\n  {%- assign nl_ph = 'deine@email.de' -%}\n  {%- assign nl_btn = 'Code sichern' -%}\n  {%- assign nl_consent = 'Mit deiner Anmeldung akzeptierst du unsere' -%}\n  {%- assign nl_consent_link = 'Datenschutzbestimmungen' -%}\n  {%- assign nl_err = 'Bitte gib eine gültige E-Mail-Adresse ein.' -%}\n  {%- assign nl_ok_h = 'Fast geschafft.' -%}\n  {%- assign nl_ok_t = 'Wir haben dir eine Mail geschickt. Bestätige den Link darin, dann kommt dein Code.' -%}\n{%- endif -%}\n\n<style>\n  .iq-nl{background:#FFFFFF;padding:72px 20px;}\n  .iq-nl__in{max-width:760px;margin:0 auto;text-align:center;color:#171717;}\n  .iq-nl__k{font-size:13px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;opacity:.55;}\n  .iq-nl__h{margin:12px 0 0;font-size:34px;text-wrap:balance;line-height:1.12;font-weight:700;letter-spacing:-.015em;}\n  .iq-nl__s{margin:10px 0 0;font-size:15px;line-height:1.5;opacity:.68;text-wrap:pretty;}\n  .iq-nl__f{margin-top:26px;display:flex;gap:8px;align-items:flex-start;max-width:520px;margin-left:auto;margin-right:auto;}\n  .iq-nl__fw{flex:1 1 auto;text-align:left;}\n  .iq-nl__lab{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;}\n  .iq-nl__i{height:48px;box-sizing:border-box;width:100%;padding:0 14px;font:inherit;font-size:15px;\n            color:#171717;background:#FFFFFF;border:1px solid #DCDBD7;border-radius:999px;}\n  .iq-nl__i:focus{border-color:#171717;outline:2px solid #171717;outline-offset:2px;}\n  .iq-nl__i[aria-invalid=\"true\"]{border-color:#A51D1B;}\n  .iq-nl__b{height:48px;flex:0 0 auto;padding:0 22px;font:inherit;font-size:14.5px;font-weight:600;\n            color:#FFFFFF;background:#A51D1B;border:0;border-radius:var(--buttons-radius,2px);cursor:pointer;\n            white-space:nowrap;transition:background-color .16s ease;}\n  .iq-nl__b:hover{background:#171717;}\n  .iq-nl__b:focus-visible{outline:2px solid #171717;outline-offset:3px;}\n  .iq-nl__e{margin-top:6px;font-size:12.5px;line-height:1.4;color:#A51D1B;}\n  .iq-nl__c{margin-top:14px;font-size:12px;line-height:1.5;opacity:.55;}\n  .iq-nl__c a{color:inherit;text-decoration:underline;}\n  .iq-nl__ok{margin-top:26px;padding:22px 24px;border:1px solid #DCDBD7;border-radius:16px;text-align:left;}\n  .iq-nl__ok b{display:block;font-size:19px;font-weight:700;letter-spacing:-.01em;}\n  .iq-nl__ok span{display:block;margin-top:8px;font-size:14.5px;line-height:1.5;opacity:.68;}\n\n  @media (max-width:749px){\n    .iq-nl{padding:48px 20px;}\n    .iq-nl__h{font-size:24px;}\n    .iq-nl__s{font-size:14px;}\n    .iq-nl__f{flex-direction:column;gap:10px;}\n    .iq-nl__b{width:100%;}\n    .iq-nl__k{font-size:12.5px;}\n    .iq-nl__c{font-size:11.5px;}\n  }\n</style>\n\n<section class=\"iq-nl\">\n  <div class=\"iq-nl__in\">\n    <div class=\"iq-nl__k\">{{ nl_kicker }}</div>\n    <h2 class=\"iq-nl__h\">{{ nl_head }}</h2>\n    <p class=\"iq-nl__s\">{{ nl_sub }}</p>\n\n    {%- form 'customer', id: 'iq-newsletter' -%}\n      <input type=\"hidden\" name=\"contact[tags]\" value=\"newsletter,homepage\">\n      <input type=\"hidden\" name=\"contact[accepts_marketing]\" value=\"true\">\n\n      {%- if form.posted_successfully? -%}\n        <div class=\"iq-nl__ok\" role=\"status\">\n          <b>{{ nl_ok_h }}</b>\n          <span>{{ nl_ok_t }}</span>\n        </div>\n      {%- else -%}\n        <div class=\"iq-nl__f\">\n          <div class=\"iq-nl__fw\">\n            <label class=\"iq-nl__lab\" for=\"iq-nl-mail\">{{ nl_label }}</label>\n            <input class=\"iq-nl__i\" id=\"iq-nl-mail\" type=\"email\" name=\"contact[email]\"\n                   placeholder=\"{{ nl_ph }}\" autocomplete=\"email\" required\n                   {% if form.errors %}aria-invalid=\"true\" aria-describedby=\"iq-nl-err\"{% endif %}\n                   value=\"{{ form.email }}\">\n            {%- if form.errors -%}\n              <div class=\"iq-nl__e\" id=\"iq-nl-err\">{{ nl_err }}</div>\n            {%- endif -%}\n          </div>\n          <button class=\"iq-nl__b\" type=\"submit\">{{ nl_btn }}</button>\n        </div>\n        <div class=\"iq-nl__c\">{{ nl_consent }} <a href=\"/policies/privacy-policy\">{{ nl_consent_link }}</a>.</div>\n      {%- endif -%}\n    {%- endform -%}\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0,
        "custom_class": ""
      }
