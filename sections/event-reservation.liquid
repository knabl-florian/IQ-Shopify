    },
    {
      "type": "text",
      "id": "pickup_text_en",
      "label": "Pickup text (English)",
      "default": "Sunday at the IQ Dogsport stand in Petersaurach"
    }
  ],
  "presets": [
    {
      "name": "Event reservation"
    }
  ]
}
