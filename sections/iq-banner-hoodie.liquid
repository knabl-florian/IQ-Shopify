{%- liquid
  assign iq_en = false
  if request.locale.iso_code == 'en'
    assign iq_en = true
  endif
  assign iq_photo = images['iq-01-hauptbanner.webp']
  assign iq_photo = section.settings.image | default: iq_photo
  if iq_en
    assign iq_alt = 'Two women in an IQ T-shirt and hoodie with their dogs'
  else
    assign iq_alt = 'Zwei Frauen in IQ T-Shirt und Hoodie mit ihren Hunden auf einer Wiese'
  endif
-%}
<section class="iq-hs-1">
<div class="copy">{% if iq_en %}<p class="kicker">Hoodies & T-shirts</p><h1 class="title">Your everyday.<br><span>Your dog. Your IQ.</span></h1><p>Hoodies, zip hoodies and T-shirts for everyday life with your dog.</p>{% else %}<p class="kicker">Hoodies & T-Shirts</p><h1 class="title">Dein Alltag.<br><span>Dein Hund. Dein IQ.</span></h1><p>Hoodies, Zip-Hoodies und T-Shirts für Euren Alltag mit Hund.</p>{% endif %}</div>
<div class="photo">
{% if iq_photo != blank %}
{{ iq_photo | image_url: width: 1600 | image_tag: widths: '360, 480, 640, 800, 1000, 1200, 1600', sizes: '(min-width: 1800px) 1010px, (min-width: 750px) 56vw, 100vw', loading: 'eager', decoding: 'async', alt: iq_alt, fetchpriority: 'high' }}
{% endif %}
</div></section>
<style>
.iq-hs-1{display:grid;grid-template-columns:.8fr 1.2fr;align-items:center;gap:20px;width:100%;max-width:1800px;margin:12px auto;padding:20px 3%;box-sizing:border-box;background:transparent;color:#18191b}
.iq-hs-1 .copy{max-width:540px;padding:28px 20px;min-width:0}
.iq-hs-1 .kicker{font-family:Archivo,Arial,sans-serif;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#a51d1b}
.iq-hs-1 .title{font-family:Montserrat,Arial,sans-serif;font-size:clamp(30px,3vw,50px);font-weight:800;font-style:italic;text-transform:uppercase;line-height:1.08;letter-spacing:-.035em;margin:22px 0}
.iq-hs-1 .title span{color:#a51d1b}
.iq-hs-1 .copy p:not(.kicker){font-family:Archivo,Arial,sans-serif;font-size:15px;line-height:1.7}
.iq-hs-1 .photo{width:100%;max-width:none;justify-self:center;min-width:0}
.iq-hs-1 img{display:block;width:100%;height:auto;mask-image:linear-gradient(to right,transparent,#000 12%,#000 94%,transparent),linear-gradient(to bottom,transparent,#000 5%,#000 95%,transparent);mask-composite:intersect}
@media(max-width:749px){.iq-hs-1{display:flex;flex-direction:column;gap:0;margin:12px auto;padding:12px 5%}.iq-hs-1 .copy{padding:20px 0;max-width:none}.iq-hs-1 .title{font-size:32px}.iq-hs-1 .copy p:not(.kicker){font-size:14px}}

@media(max-width:749px){
.iq-hs-1{display:flex;flex-direction:column;margin:0 auto;padding:0;gap:0}
.iq-hs-1 .photo{order:-1;width:100%;max-width:none}
.iq-hs-1 .photo img{width:100%;aspect-ratio:3/2;height:auto;object-fit:cover;object-position:65% center;mask-image:linear-gradient(to bottom,#000 92%,transparent);mask-composite:add}
.iq-hs-1 .copy{padding:16px 20px 22px;max-width:none;width:100%;box-sizing:border-box}
.iq-hs-1 .kicker{font-size:10px;margin:0 0 10px;letter-spacing:.1em}
.iq-hs-1 .title{font-size:clamp(25px,6.5vw,30px);line-height:1.1;margin:0 0 12px}
.iq-hs-1 .copy p:not(.kicker){font-size:14px;line-height:1.5;margin:0}
}
</style>
{% schema %}
{
  "name": "IQ Hoodies Hauptbanner",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bannerfoto",
      "info": "Empfehlung: iq-01-hauptbanner.webp"
    }
  ],
  "presets": [
    {
      "name": "IQ Hoodies Hauptbanner"
    }
  ]
}
{% endschema %}
