{{ 'iq-responsive-collection-video.css' | asset_url | stylesheet_tag }}
<script src="{{ 'iq-responsive-collection-video.js' | asset_url }}" defer></script>
{% render 'iq-responsive-collection-video', settings: section.settings, video_id: section.id %}
{% schema %}
{
  "name": "IQ Video DE/EN Mobil/Desk",
  "tag": "div",
  "settings": [
    {
      "type": "collection",
      "id": "only_collection",
      "label": "Nur in dieser Collection anzeigen"
    },
    {
      "type": "header",
      "content": "Videos Deutsch"
    },
    {
      "type": "video",
      "id": "video_desktop_de",
      "label": "Desktop – Deutsch"
    },
    {
      "type": "video",
      "id": "video_mobile_de",
      "label": "Mobil – Deutsch"
    },
    {
      "type": "image_picker",
      "id": "poster_desktop_de",
      "label": "Titelbild Desktop – Deutsch"
    },
    {
      "type": "image_picker",
      "id": "poster_mobile_de",
      "label": "Titelbild Mobil – Deutsch"
    },
    {
      "type": "header",
      "content": "Videos Englisch"
    },
    {
      "type": "video",
      "id": "video_desktop_en",
      "label": "Desktop – Englisch"
    },
    {
      "type": "video",
      "id": "video_mobile_en",
      "label": "Mobil – Englisch"
    },
    {
      "type": "image_picker",
      "id": "poster_desktop_en",
      "label": "Titelbild Desktop – Englisch"
    },
    {
      "type": "image_picker",
      "id": "poster_mobile_en",
      "label": "Titelbild Mobil – Englisch"
    },
    {
      "type": "header",
      "content": "Text Deutsch"
    },
    {
      "type": "text",
      "id": "heading_de",
      "label": "Überschrift Deutsch"
    },
    {
      "type": "richtext",
      "id": "intro_de",
      "label": "Einleitung Deutsch"
    },
    {
      "type": "richtext",
      "id": "benefits_de",
      "label": "Vorteile Deutsch"
    },
    {
      "type": "text",
      "id": "button_de",
      "label": "Button Deutsch"
    },
    {
      "type": "header",
      "content": "Text Englisch"
    },
    {
      "type": "text",
      "id": "heading_en",
      "label": "Überschrift Englisch"
    },
    {
      "type": "richtext",
      "id": "intro_en",
      "label": "Einleitung Englisch"
    },
    {
      "type": "richtext",
      "id": "benefits_en",
      "label": "Vorteile Englisch"
    },
    {
      "type": "text",
      "id": "button_en",
      "label": "Button Englisch"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button-Ziel"
    },
    {
      "type": "text",
      "id": "eyebrow_de",
      "label": "Dachzeile · DE",
      "default": "IQ PERFORMANCE PRO"
    },
    {
      "type": "text",
      "id": "eyebrow_en",
      "label": "Dachzeile · EN",
      "default": "IQ PERFORMANCE PRO"
    },
    {
      "type": "select",
      "id": "mobile_ratio",
      "label": "Videoformat Mobil",
      "options": [
        {
          "value": "portrait",
          "label": "Hochformat 9:16"
        },
        {
          "value": "landscape",
          "label": "Querformat 16:9"
        }
      ],
      "default": "portrait"
    }
  ],
  "presets": [
    {
      "name": "IQ Video DE/EN Mobil/Desk"
    }
  ]
}
{% endschema %}
