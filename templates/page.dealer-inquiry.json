      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% assign lang = request.locale.iso_code | downcase %}\n\n<div class=\"dealer-inquiry-center rte\">\n  {% if lang == 'de' %}\n    <h2>Händleranfrage</h2>\n\n    <p>\n      Vielen Dank für Ihr Interesse an einer Zusammenarbeit mit IQ Dogsport.\n      Bitte füllen Sie das folgende Formular vollständig aus, damit wir Ihre Anfrage prüfen können.\n    </p>\n\n    <p>\n      Nach dem Absenden wird Ihre Anfrage intern geprüft. Bitte haben Sie Verständnis,\n      dass wir Händleranfragen sorgfältig bewerten und nicht in jedem Land oder jeder Region\n      zusätzliche Vertriebspartner aufnehmen können.\n    </p>\n\n    <h3>Wichtige Hinweise</h3>\n    <ul>\n      <li>Bitte geben Sie vollständige und korrekte Unternehmensdaten an.</li>\n      <li>Falls vorhanden, tragen Sie bitte Ihre Website und Social-Media-Kanäle ein.</li>\n      <li>Unter <strong>Zielgruppe</strong> können Sie angeben, in welchem Bereich Sie tätig sind.</li>\n      <li>Nach erfolgreicher Prüfung melden wir uns schnellstmöglich bei Ihnen zurück.</li>\n    </ul>\n\n    <p>\n      Bei Rückfragen kontaktieren Sie uns bitte per E-Mail oder Telefon.\n    </p>\n  {% else %}\n    <h2>Dealer Inquiry</h2>\n\n    <p>\n      Thank you for your interest in working with IQ Dogsport.\n      Please complete the form below in full so that we can review your request properly.\n    </p>\n\n    <p>\n      After submission, your request will be reviewed internally. Please understand\n      that we carefully assess dealer applications and may not be able to accept\n      additional sales partners in every country or region.\n    </p>\n\n    <h3>Important information</h3>\n    <ul>\n      <li>Please provide complete and accurate company details.</li>\n      <li>If available, include your website and social media channels.</li>\n      <li>Under <strong>Target Group</strong>, you can specify the area in which you operate.</li>\n      <li>Once your request has been reviewed, we will get back to you as soon as possible.</li>\n    </ul>\n\n    <p>\n      If you have any questions, please contact us by email or phone.\n    </p>\n  {% endif %}\n</div>",
        "color_scheme": "",
