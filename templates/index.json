    "custom_liquid_zNkD6Y": {
      "type": "custom-liquid",
      "custom_css": [],
      "name": "wissen",
      "settings": {
        "custom_liquid": "{%- assign en = false -%}\n{%- if request.locale.iso_code == 'en' -%}{%- assign en = true -%}{%- endif -%}\n\n{%- comment -%} Bild-Dateinamen (Shopify Files). buch_foto bitte hochladen. {%- endcomment -%}\n{%- assign blog_foto = 'startseite-bilder.jpg' -%}\n{%- assign buch_foto = 'B_cher_IQ_dogsport.jpg' -%}\n\n<style>\n  .iqw{ background:rgb(var(--color-background)); color:rgb(var(--color-foreground)); font-family:Archivo,Arial,sans-serif; padding-bottom:8px; }\n  .iqw__head{ padding:16px 20px 0; box-sizing:border-box; }\n  .iqw__eyebrow{ margin:0; font-size:11px; font-weight:700; letter-spacing:2.8px; text-transform:uppercase; color:rgba(var(--color-foreground),.55); }\n  .iqw__title{ margin:9px 0 0; font-family:Montserrat,Arial,sans-serif; font-style:italic; font-weight:800; text-transform:uppercase; font-size:clamp(30px,7.5vw,36px); line-height:1.02; letter-spacing:-.3px; }\n\n  .iqw a{ text-decoration:none; color:inherit; display:block; }\n  .iqw__cat{ font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#A51D1B; }\n  .iqw__h{ font-family:Montserrat,Arial,sans-serif; font-weight:800; line-height:1.1; margin-top:4px; font-size:22px; }\n  .iqw__t{ font-size:14.5px; line-height:1.45; color:rgba(var(--color-foreground),.74); margin:6px 0 0; }\n  .iqw__link{ display:inline-block; margin-top:12px; font-size:13px; font-weight:700; letter-spacing:.4px; text-transform:uppercase; color:rgb(var(--color-foreground)); border-bottom:2px solid transparent; padding-bottom:2px; transition:color .2s ease,border-color .2s ease; }\n  .iqw a:hover .iqw__link, .iqw a:focus-visible .iqw__link{ color:#A51D1B; border-color:#A51D1B; }\n  .iqw a:focus-visible{ outline:3px solid #A51D1B; outline-offset:3px; }\n\n  /* Zwei grosse Einstiege – Bild + Text als EIN Beitrag */\n  .iqw__grid{ display:block; padding-top:22px; }\n  .iqw__feat + .iqw__feat{ margin-top:34px; }\n  .iqw__media{ position:relative; width:100%; aspect-ratio:3/2; overflow:hidden; background:#111; }\n  .iqw__media img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }\n  .iqw__feat .iqw__cat{ margin-top:16px; }\n  .iqw__feat .iqw__cat, .iqw__feat .iqw__h, .iqw__feat .iqw__t, .iqw__feat .iqw__link{ padding-inline:20px; }\n\n  /* Was ist IGP? – kompakter, klar gerahmter dritter Einstieg */\n  .iqw__igp{ margin-top:32px; padding:16px 20px; border-top:1px solid rgba(var(--color-foreground),.16); border-bottom:1px solid rgba(var(--color-foreground),.16); }\n  .iqw__igp-eyebrow{ display:block; font-size:11px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:rgba(var(--color-foreground),.55); }\n  .iqw__igp-title{ display:inline-flex; align-items:baseline; gap:8px; margin-top:4px; font-family:Montserrat,Arial,sans-serif; font-weight:800; font-size:19px; }\n  .iqw__igp:hover .iqw__igp-title, .iqw__igp:focus-visible .iqw__igp-title{ color:#A51D1B; }\n\n  @media (min-width:750px){\n    .iqw__head{ padding:22px 24px 0; }\n    .iqw__grid{ padding:24px 24px 0; display:grid; grid-template-columns:1fr 1fr; gap:26px; align-items:start; }\n    .iqw__feat + .iqw__feat{ margin-top:0; }\n    .iqw__feat .iqw__cat{ margin-top:14px; }\n    .iqw__feat .iqw__cat, .iqw__feat .iqw__h, .iqw__feat .iqw__t, .iqw__feat .iqw__link{ padding-inline:0; }\n    .iqw__igp{ margin:30px 24px 0; }\n  }\n  @media (min-width:990px){\n    .iqw__head{ max-width:1360px; margin:0 auto; padding:24px 32px 0; }\n    .iqw__grid{ max-width:1360px; margin:0 auto; padding:26px 32px 0; gap:30px; }\n    .iqw__feat .iqw__h{ font-size:24px; }\n    .iqw__igp{ max-width:1360px; margin:30px auto 0; padding:16px 32px; }\n  }\n  @media (prefers-reduced-motion:reduce){ .iqw__link{ transition:none; } }\n</style>\n\n<section class=\"iqw color-scheme-2\">\n  <div class=\"iqw__head\">\n    <p class=\"iqw__eyebrow\">{% if en %}IQ Knowledge{% else %}IQ Wissen{% endif %}</p>\n    <h2 class=\"iqw__title\">{% if en %}Knowledge from world-class experience{% else %}Wissen aus Weltklasse-Erfahrung{% endif %}</h2>\n  </div>\n\n  <div class=\"iqw__grid\">\n\n    {%- comment -%} BLOG {%- endcomment -%}\n    <a class=\"iqw__feat\" href=\"{% if en %}/en/blogs/news{% else %}/blogs/news{% endif %}\">\n      <div class=\"iqw__media\">\n        <img src=\"{{ blog_foto | file_url }}&width=1400\" width=\"1400\" height=\"933\" loading=\"lazy\"\n             alt=\"{{ 'iq_translation.home.knowledge_training_alt' | t | escape }}\">\n      </div>\n      <div class=\"iqw__cat\">Blog</div>\n      <div class=\"iqw__h\">{% if en %}Training from real practice{% else %}Training aus der Praxis{% endif %}</div>\n      <p class=\"iqw__t\">{% if en %}Articles, guides and experience from dog sport.{% else %}Fachbeiträge, Anleitungen und Erfahrungen aus dem Hundesport.{% endif %}</p>\n      <span class=\"iqw__link\">{% if en %}To the blog &rarr;{% else %}Zum Blog &rarr;{% endif %}</span>\n    </a>\n\n    {%- comment -%} BÜCHER {%- endcomment -%}\n    <a class=\"iqw__feat\" href=\"{% if en %}/en/collections/bucher-deutsch{% else %}/collections/bucher-deutsch{% endif %}\">\n      <div class=\"iqw__media\">\n        <img src=\"{{ buch_foto | file_url }}&width=1400\" width=\"1400\" height=\"933\" loading=\"lazy\"\n             alt=\"{{ 'iq_translation.home.knowledge_book_alt' | t | escape }}\">\n      </div>\n      <div class=\"iqw__cat\">{% if en %}Books{% else %}Bücher{% endif %}</div>\n      <div class=\"iqw__h\">{% if en %}Obedience, protection, BH{% else %}Unterordnung, Schutzdienst, BH{% endif %}</div>\n      <p class=\"iqw__t\">{% if en %}Three books from decades of competition practice.{% else %}Drei Bücher aus jahrzehntelanger Wettkampfpraxis.{% endif %}</p>\n      <span class=\"iqw__link\">{% if en %}Discover books &rarr;{% else %}Bücher entdecken &rarr;{% endif %}</span>\n    </a>\n\n  </div>\n\n  {%- comment -%} WAS IST IGP? – dritter, kompakter Einstieg (bestehende URL) {%- endcomment -%}\n  <a class=\"iqw__igp\" href=\"{% if en %}/en/pages/igp-hundesport{% else %}/pages/igp-hundesport{% endif %}\">\n    <span class=\"iqw__igp-eyebrow\">{% if en %}Training knowledge{% else %}Trainingswissen{% endif %}</span>\n    <span class=\"iqw__igp-title\">{% if en %}What is IGP?{% else %}Was ist IGP?{% endif %} <span aria-hidden=\"true\">&rarr;</span></span>\n  </a>\n</section>",
        "color_scheme": "scheme-2",
        "padding_top": 0,
        "padding_bottom": 0,
        "custom_class": ""
      }
    },
