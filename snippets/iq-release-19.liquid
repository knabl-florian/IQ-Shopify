{% doc %}
  Editor-managed content preserving the existing collection layout.
  @param {block} block - Content block.
{% enddoc %}
{% liquid
  assign base = routes.root_url
  assign last_char = base | slice: -1
  unless last_char == '/'
    assign base = base | append: '/'
  endunless
%}
{% assign mesh_image = block.settings.bild_1 %}
{% assign mesh_image = block.settings.bild_2 %}
<div class="iq-mesh-feature">
  <div class="iq-mesh-feature__photo">
    {% capture mesh_alt %}{% if request.locale.iso_code == 'en' %}{{ block.settings.text_5 | escape }}{% else %}{{ block.settings.text_6 | escape }}{% endif %}{% endcapture %}
    {% if mesh_image != blank %}
      {{ mesh_image | image_url: width: 1000 | image_tag: widths: '400,600,800,1000', sizes: '(min-width:750px) 53vw, 100vw', loading: 'lazy', alt: mesh_alt }}
    {% elsif request.design_mode %}
      <p>Bitte iq-westen-innenleben.webp unter Inhalte → Dateien hochladen.</p>
      <p>Bitte weste_innenleben.webp unter Inhalte → Dateien hochladen.</p>
    {% endif %}
  </div>
  <div class="iq-mesh-feature__copy">
    {% if request.locale.iso_code == 'en' %}
      <p class="iq-mesh-feature__kicker">{{ block.settings.text_7 | escape }}</p>
      <h2>{{ block.settings.text_8 | escape }}<br>{{ block.settings.text_9 | escape }}</h2>
      <p>{{ block.settings.text_10 | escape }}</p>
      <a class="iq-mesh-feature__button" href="{% if request.locale.iso_code == 'en' %}{{ block.settings.link_4 }}{% else %}{{ block.settings.link_3 }}{% endif %}">{{ block.settings.text_11 | escape }} <span aria-hidden="true">→</span></a>
    {% else %}
      <p class="iq-mesh-feature__kicker">{{ block.settings.text_12 | escape }}</p>
      <h2>{{ block.settings.text_13 | escape }}<br>{{ block.settings.text_14 | escape }}</h2>
      <p>{{ block.settings.text_15 | escape }}</p>
      <a class="iq-mesh-feature__button" href="{% if request.locale.iso_code == 'en' %}{{ block.settings.link_4 }}{% else %}{{ block.settings.link_3 }}{% endif %}">{{ block.settings.text_16 | escape }} <span aria-hidden="true">→</span></a>
    {% endif %}
  </div>
</div>
<style>
.iq-mesh-feature,.iq-mesh-feature *{box-sizing:border-box}
.iq-mesh-feature{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);align-items:center;background:#FFFFFF;border-radius:0;width:100%;color:#171717}
.iq-mesh-feature__photo{min-width:0}
.iq-mesh-feature__photo img{display:block;width:100%;height:auto;border-radius:0}
.iq-mesh-feature__copy{min-width:0;padding:36px clamp(24px,4vw,64px);font:400 15px/1.6 Archivo,sans-serif}
.iq-mesh-feature .iq-mesh-feature__kicker{margin:0 0 14px;font:700 11px/1.5 Archivo,sans-serif;letter-spacing:.12em;color:#A51D1B}
.iq-mesh-feature h2{margin:0 0 22px;font-family:Montserrat,sans-serif;font-weight:800;font-style:italic;font-size:clamp(28px,3vw,46px);line-height:1.1;letter-spacing:-.035em;text-transform:uppercase;color:#171717;overflow-wrap:break-word}
.iq-mesh-feature__copy>p{margin:0 0 16px}
.iq-mesh-feature .iq-mesh-feature__models{margin:0;border-top:1px solid #DCDBD7;padding-top:14px;font-size:12px;color:#171717}
@media(max-width:749px){
.iq-mesh-feature{grid-template-columns:minmax(0,1fr)}
.iq-mesh-feature__copy{padding:25px 20px 28px;font-size:14px}
.iq-mesh-feature h2{font-size:clamp(26px,7vw,32px)}
}
.iq-mesh-feature .iq-mesh-feature__button{display:inline-flex;align-items:center;gap:12px;min-height:44px;color:#A51D1B;font:700 14px/1.5 Archivo,sans-serif;text-decoration:underline;text-underline-offset:5px;background:transparent;border:0;border-radius:0;padding:0;margin-top:8px}
.iq-mesh-feature__button:focus-visible{outline:2px solid #171717;outline-offset:4px}
</style>