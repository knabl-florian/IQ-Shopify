<section
  id="{{ section_id }}"
  class="iq-spin-win-section color-{{ section.settings.color_scheme }}"
  data-hide-footer-newsletter="{{ section.settings.hide_footer_newsletter }}"
>
  <div class="page-width">
    <div class="iqw-customer-header" data-customer-only>
      <p class="text-subheading">{{ section.settings.campaign_label | default: tx_campaign_label }}</p>
      <h1 class="h2">{{ tx_title }}</h1>
      <p>{{ tx_intro }}</p>

      <div class="iqw-deadline">
        <strong>{{ tx_deadline }}</strong>
      </div>
    </div>

    <div class="iqw-expired" data-expired-view hidden>
      <span class="iqw-icon iqw-icon--large" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <circle cx="12" cy="13" r="8"></circle>
          <path d="M12 9v4l3 2"></path>
          <path d="M9 2h6"></path>
          <path d="M12 5V2"></path>
        </svg>
      </span>
      <h2 class="h2">{{ tx_expired_title }}</h2>
      <p>{{ tx_expired_text }}</p>
    </div>

    <div class="iqw-panel" data-customer-app>
      <div class="iqw-progress">
        <span class="is-active" data-progress="register">1 · {{ tx_step_register }}</span>
        <span data-progress="spin">2 · {{ tx_step_spin }}</span>
        <span data-progress="claim">3 · {{ tx_step_result }}</span>
      </div>

      <div class="iqw-message" data-message hidden></div>

      <div class="iqw-view is-active" data-view="register">
        <div class="iqw-register-layout">
          <div class="iqw-register-copy">
            <p class="text-subheading">{{ section.settings.campaign_label | default: tx_campaign_label }}</p>
            <h2 class="h3">{{ tx_step_register }}</h2>
            <p>{{ tx_intro }}</p>

            <ul class="iqw-rules list-unstyled">
              <li><span>1</span>{{ tx_rule_1 }}</li>
              <li><span>2</span>{{ tx_rule_2 }}</li>
              <li><span>3</span>{{ tx_rule_3 }}</li>
            </ul>
          </div>

          <form class="iqw-form" data-register-form novalidate>
            <div class="form-field">
              <label class="form-label" for="iqw-name-{{ section.id }}">
                {{ tx_first_name }}
              </label>

              <input
                id="iqw-name-{{ section.id }}"
                class="form-control"
                name="firstName"
                type="text"
                autocomplete="given-name"
                maxlength="80"
                required
              >
            </div>

            <div class="form-field">
              <label class="form-label" for="iqw-email-{{ section.id }}">
                {{ tx_email }}
              </label>

              <input
                id="iqw-email-{{ section.id }}"
                class="form-control"
                name="email"
                type="email"
                autocomplete="email"
                maxlength="180"
                required
              >
            </div>

            {% if section.settings.show_newsletter %}
              <label class="iqw-consent">
                <input
                  type="checkbox"
                  name="newsletterConsent"
                  value="true"
                >

                <span>
                  {{ tx_newsletter }}

                  {% if section.settings.privacy_url != blank %}
                    <a
                      href="{{ section.settings.privacy_url }}"
                      target="_blank"
                      rel="noopener"
                    >
                      {{ tx_privacy }}
                    </a>
                  {% endif %}
                </span>
              </label>
            {% endif %}

            <button
              class="btn btn--primary iqw-full"
              type="submit"
              data-register-button
            >
              <span data-button-text>{{ tx_start }}</span>
              <span class="iqw-button-loader" hidden></span>
            </button>
          </form>
        </div>

        <details class="iqw-restore">
          <summary>{{ tx_restore }}</summary>

          <form data-restore-form>
            <div class="form-field">
              <label class="form-label" for="iqw-restore-{{ section.id }}">
                {{ tx_claim_code }}
              </label>

              <input
                id="iqw-restore-{{ section.id }}"
                class="form-control"
                name="claimCode"
                type="text"
                maxlength="120"
                autocomplete="off"
              >
            </div>

            <button class="btn btn--secondary" type="submit">
              {{ tx_open_claim }}
            </button>
          </form>
        </details>
      </div>

      <div class="iqw-view" data-view="spin">
        <div class="iqw-spin-layout">
          <div class="iqw-wheel-stage">
            <div class="iqw-pointer" aria-hidden="true"></div>

            <div
              class="iqw-wheel"
              data-wheel
              data-spin-trigger
              role="button"
              tabindex="0"
              aria-label="{{ tx_tap_spin }}"
            >
              <svg viewBox="0 0 400 400" role="img" aria-label="{{ tx_spin_button }}">
                <g class="iqw-wheel__segments">
                  <path class="iqw-segment iqw-segment--1" d="M200 200 L141.9 21.2 A188 188 0 0 1 258.1 21.2 Z"/>
                  <path class="iqw-segment iqw-segment--2" d="M200 200 L258.1 21.2 A188 188 0 0 1 352.1 89.5 Z"/>
                  <path class="iqw-segment iqw-segment--3" d="M200 200 L352.1 89.5 A188 188 0 0 1 388 200 Z"/>
                  <path class="iqw-segment iqw-segment--4" d="M200 200 L388 200 A188 188 0 0 1 352.1 310.5 Z"/>
                  <path class="iqw-segment iqw-segment--5" d="M200 200 L352.1 310.5 A188 188 0 0 1 258.1 378.8 Z"/>
                  <path class="iqw-segment iqw-segment--6" d="M200 200 L258.1 378.8 A188 188 0 0 1 141.9 378.8 Z"/>
                  <path class="iqw-segment iqw-segment--7" d="M200 200 L141.9 378.8 A188 188 0 0 1 47.9 310.5 Z"/>
                  <path class="iqw-segment iqw-segment--8" d="M200 200 L47.9 310.5 A188 188 0 0 1 12 200 Z"/>
                  <path class="iqw-segment iqw-segment--9" d="M200 200 L12 200 A188 188 0 0 1 47.9 89.5 Z"/>
                  <path class="iqw-segment iqw-segment--10 iqw-segment--missed" d="M200 200 L47.9 89.5 A188 188 0 0 1 141.9 21.2 Z"/>
                </g>

                <g class="iqw-wheel__labels">
                  <text x="200" y="65">1</text>
                  <text x="280" y="90">2</text>
                  <text x="338" y="157">3</text>
                  <text x="338" y="243">4</text>
                  <text x="280" y="310">5</text>
                  <text x="200" y="338">6</text>
                  <text x="120" y="310">7</text>
                  <text x="62" y="243">8</text>
                  <text x="62" y="157">9</text>
                  <text x="120" y="90">10</text>
                </g>

                <circle class="iqw-wheel__hub" cx="200" cy="200" r="47"/>
                <circle class="iqw-wheel__hub-ring" cx="200" cy="200" r="47"/>
              </svg>

              <button
                class="iqw-wheel-tap"
                type="button"
                data-spin-trigger
                aria-label="{{ tx_tap_spin }}"
              >
                <span class="iqw-icon iqw-icon--spin" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M20 11a8 8 0 1 0-2.3 5.7"></path>
                    <path d="M20 4v7h-7"></path>
                  </svg>
                </span>
                <strong>{{ tx_tap_spin }}</strong>
              </button>

              <div class="iqw-wheel-loading" data-wheel-loading hidden>
                <span></span>
                <strong>{{ tx_determining }}</strong>
              </div>
            </div>

            <details class="iqw-wheel-legend-details">
              <summary>{{ tx_show_prizes }}</summary>

              <div class="iqw-wheel-legend">
                {% if is_de %}
                  {% assign wheel_legend = 'Sticker Rot|Sticker Weiß|Sticker Schwarz|Ringclicker Weiß|Sticker Rot|Sticker Weiß|Sticker Schwarz|Ringclicker Weiß|Sticker Rot|Leider daneben' | split: '|' %}
                {% else %}
                  {% assign wheel_legend = 'Red sticker|White sticker|Black sticker|White Ringclicker|Red sticker|White sticker|Black sticker|White Ringclicker|Red sticker|Missed it' | split: '|' %}
                {% endif %}

                {% for item in wheel_legend %}
                  <span class="{% if forloop.index == 10 %}is-missed{% endif %}">
                    <b>{{ forloop.index }}</b>
                    {{ item }}
                  </span>
                {% endfor %}
              </div>
            </details>
          </div>

          <div class="iqw-spin-copy">
            <p class="text-subheading">{{ tx_spin_title }}</p>

            <h2 class="h2">
              {{ tx_good_luck }}<span data-customer-name></span>
            </h2>

            <p>{{ tx_spin_text }}</p>

            <div class="iqw-deadline iqw-deadline--small">
              <strong>{{ tx_deadline }}</strong>
            </div>

            <ul class="iqw-rules list-unstyled">
              <li><span>1</span>{{ tx_rule_1 }}</li>
              <li><span>2</span>{{ tx_rule_2 }}</li>
              <li><span>3</span>{{ tx_rule_3 }}</li>
            </ul>

            <button
              class="btn btn--primary iqw-full iqw-desktop-spin-button"
              type="button"
              data-spin-trigger
            >
              <span data-button-text>{{ tx_spin_button }}</span>
              <span class="iqw-button-loader" hidden></span>
            </button>
          </div>
        </div>
      </div>

      <div class="iqw-view" data-view="claim">
        <div class="iqw-result">
          <div data-winning-result>
            <p class="text-subheading">
              {{ tx_congrats }}, <span data-claim-name></span>
            </p>

            <p class="iqw-won-label">{{ tx_you_won }}</p>
            <h2 class="h2" data-prize-name></h2>

            <div class="iqw-code-card">
              <small>{{ tx_prize_code }}</small>
              <strong data-discount-code></strong>

              <button
                class="btn btn--secondary"
                type="button"
                data-copy-discount
              >
                {{ tx_copy_code }}
              </button>
            </div>

            <div class="iqw-product-instructions">
              <span class="iqw-product-instructions__icon iqw-icon iqw-icon--large" aria-hidden="true">
                <svg viewBox="0 0 24 24" focusable="false">
                  <path d="M4 7.5 12 3l8 4.5v9L12 21l-8-4.5z"></path>
                  <path d="m4 7.5 8 4.5 8-4.5"></path>
                  <path d="M12 12v9"></path>
                </svg>
              </span>

              <h3 class="h4">{{ tx_product_steps_title }}</h3>

              <ol>
                <li>{{ tx_product_step_1 }}</li>
                <li>{{ tx_product_step_2 }} <strong data-variant-instruction></strong></li>
                <li>{{ tx_product_step_3 }}</li>
                <li>{{ tx_product_step_4 }} <strong data-discount-code-inline></strong></li>
              </ol>

              <p class="iqw-product-instructions__warning">
                <strong>{{ tx_product_warning }}</strong>
              </p>

              <a
                class="btn btn--primary iqw-full"
                href="#"
                data-product-link
                target="_blank"
                rel="noopener"
                hidden
              >
                <span class="iqw-button-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M14 5h5v5"></path>
                    <path d="m10 14 9-9"></path>
                    <path d="M19 13v6H5V5h6"></path>
                  </svg>
                </span>
                {{ tx_shop_now }}
              </a>
            </div>

            <div class="iqw-redemption-grid">
              <div class="iqw-redemption-card">
                <span class="iqw-icon iqw-icon--large" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.6L20 8H7"></path>
                    <circle cx="10" cy="19" r="1.5"></circle>
                    <circle cx="17" cy="19" r="1.5"></circle>
                  </svg>
                </span>
                <h3 class="h4">{{ tx_online_title }}</h3>
                <p>{{ tx_online_text }}</p>
              </div>

              <div class="iqw-redemption-card">
                <span class="iqw-icon iqw-icon--large" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <path d="M4 20V10l8-6 8 6v10"></path>
                    <path d="M2 20h20"></path>
                    <path d="M8 20v-6h8v6"></path>
                    <path d="M6 10h12"></path>
                  </svg>
                </span>
                <h3 class="h4">{{ tx_onsite_title }}</h3>
                <p>{{ tx_onsite_text }}</p>
              </div>
            </div>

            <div class="iqw-claim-grid">
              <div>
                <small>{{ tx_claim_code }}</small>
                <strong data-claim-code></strong>
              </div>

              <div>
                <small>{{ tx_status }}</small>
                <strong data-claim-status>{{ tx_reserved }}</strong>
              </div>
            </div>

            <div class="iqw-important">
              <strong>{{ tx_important }}</strong>
              <p>{{ tx_important_text }}</p>
              <p><strong>{{ tx_deadline }}</strong></p>
            </div>

            <div class="iqw-team-note">
              <small>{{ tx_team }}</small>
              <strong data-instruction></strong>
            </div>
          </div>

          <div class="iqw-missed" data-missed-result hidden>
            <span class="iqw-icon iqw-icon--large" aria-hidden="true">
              <svg viewBox="0 0 24 24" focusable="false">
                <circle cx="12" cy="12" r="9"></circle>
                <path d="m9 9 6 6"></path>
                <path d="m15 9-6 6"></path>
              </svg>
            </span>
            <h2 class="h2">{{ tx_missed_title }}</h2>
            <p>{{ tx_missed_text }}</p>
          </div>
        </div>
      </div>
    </div>

    <div class="iqw-staff" data-staff-app hidden>
      <div class="text-center">
        <p class="text-subheading">{{ section.settings.campaign_label | default: tx_campaign_label }}</p>
        <h1 class="h2">{{ tx_staff_title }}</h1>
