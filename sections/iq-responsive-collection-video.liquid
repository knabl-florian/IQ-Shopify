{%- if section.settings.only_collection != blank and section.settings.only_collection.handle == collection.handle -%}
{%- liquid
  assign language = request.locale.iso_code | slice: 0, 2
  assign button_url = section.settings.button_url
  assign first_char = button_url | slice: 0
  assign locale_prefix = routes.root_url | append: '/'
  unless routes.root_url == '/' or button_url contains locale_prefix
    if first_char == '/'
      assign button_url = routes.root_url | append: button_url
    endif
  endunless
  assign desktop_video = section.settings.video_desktop_en
  assign mobile_video = section.settings.video_mobile_en
  assign desktop_poster = section.settings.poster_desktop_en
  assign mobile_poster = section.settings.poster_mobile_en
  assign heading = section.settings.heading_en
  assign intro = section.settings.intro_en
  assign benefits = section.settings.benefits_en
  assign button_label = section.settings.button_en
  if language == 'de'
    assign desktop_video = section.settings.video_desktop_de
    assign mobile_video = section.settings.video_mobile_de
    assign desktop_poster = section.settings.poster_desktop_de
    assign mobile_poster = section.settings.poster_mobile_de
    assign heading = section.settings.heading_de
    assign intro = section.settings.intro_de
    assign benefits = section.settings.benefits_de
    assign button_label = section.settings.button_de
  endif
  assign mobile_video = mobile_video | default: desktop_video
  assign desktop_video = desktop_video | default: mobile_video
  assign desktop_poster = desktop_poster | default: desktop_video.preview_image
  assign mobile_poster = mobile_poster | default: mobile_video.preview_image | default: desktop_poster
-%}
{%- if desktop_video != blank -%}
{%- capture mobile_sources -%}[{%- for source in mobile_video.sources -%}{"url":{{ source.url | json }},"mime_type":{{ source.mime_type | json }},"width":{{ source.width | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]{%- endcapture -%}
{%- capture desktop_sources -%}[{%- for source in desktop_video.sources -%}{"url":{{ source.url | json }},"mime_type":{{ source.mime_type | json }},"width":{{ source.width | json }}}{% unless forloop.last %},{% endunless %}{%- endfor -%}]{%- endcapture -%}
<section class="iq-collection-video iq-collection-container" aria-labelledby="IQVideoHeading-{{ section.id }}">
  <iq-collection-video class="iq-collection-video__player" data-mobile-sources="{{ mobile_sources | escape }}" data-desktop-sources="{{ desktop_sources | escape }}">
    <div class="iq-collection-video__frame">
      {%- if desktop_poster != blank -%}
      <picture class="iq-collection-video__poster">
        {%- if mobile_poster != blank -%}<source media="(max-width:749px)" srcset="{{ mobile_poster | image_url: width: 750 }}">{%- endif -%}
        {{ desktop_poster | image_url: width: 1440 | image_tag: widths: '480,750,1000,1440', sizes: '(min-width:750px) 55vw, 100vw', loading: 'lazy' }}
      </picture>
      {%- endif -%}
      <video class="iq-collection-video__film" playsinline controls preload="none" tabindex="-1" aria-label="{{ 'iq_video.film_label' | t | escape }}" hidden></video>
      <button class="iq-collection-video__play" type="button"><span aria-hidden="true">▶</span> {{ 'iq_video.play' | t }}</button>
      <noscript><a class="iq-collection-video__direct" href="{{ desktop_video.sources.first.url }}">{{ 'iq_video.play' | t }}</a></noscript>
    </div>
    <p class="iq-collection-video__error" role="status" hidden>{{ 'iq_video.error' | t }}</p>
  </iq-collection-video>
  <div class="iq-collection-video__copy">
    <p class="iq-collection-video__eyebrow">IQ PERFORMANCE PRO</p>
    <h2 id="IQVideoHeading-{{ section.id }}">{{ heading | escape }}</h2>
    <div class="iq-collection-video__intro rte">{{ intro }}</div>
    <div class="iq-collection-video__benefits rte">{{ benefits }}</div>
    {%- if section.settings.button_url != blank and button_label != blank -%}<a class="iq-collection-video__link" href="{{ button_url }}">{{ button_label | escape }}</a>{%- endif -%}
  </div>
</section>
{%- elsif request.design_mode -%}<p class="iq-collection-container">Bitte Desktop- und Mobilvideos für DE und EN auswählen.</p>{%- endif -%}
{%- endif -%}

{% stylesheet %}
.iq-collection-video{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:40px;align-items:center;margin:48px auto;color:#171717}.iq-collection-video *{box-sizing:border-box}.iq-collection-video__player{display:block;min-width:0}.iq-collection-video__frame{position:relative;aspect-ratio:16/9;background:#171717;overflow:hidden}.iq-collection-video__poster,.iq-collection-video__poster img,.iq-collection-video__film{display:block;width:100%;height:100%;object-fit:contain}.iq-collection-video__poster,.iq-collection-video__film{position:absolute;inset:0}.iq-collection-video__film[hidden],.iq-collection-video [hidden]{display:none}.iq-collection-video__play{position:absolute;inset:0;margin:auto;width:max-content;max-width:90%;height:max-content;padding:14px 20px;background:#fff;color:#171717;border:1px solid #DCDBD7;border-radius:var(--buttons-radius,2px);font:700 16px/1.4 Archivo,sans-serif;cursor:pointer}.iq-collection-video__play span{margin-right:8px}.iq-collection-video__eyebrow{font:700 12px/1.4 Archivo,sans-serif;letter-spacing:.06em;margin:0 0 12px}.iq-collection-video h2{font:italic 800 clamp(26px,2.4vw,38px)/1.12 Montserrat,sans-serif;text-transform:uppercase;letter-spacing:-.02em;margin:0 0 20px;overflow-wrap:break-word}.iq-collection-video__copy{min-width:0;font:400 16px/1.55 Archivo,sans-serif}.iq-collection-video__benefits ul{padding-left:20px}.iq-collection-video__benefits li{margin-bottom:8px}.iq-collection-video__link{display:inline-block;padding:12px 0;color:#A51D1B;font-weight:700;text-decoration:underline;text-underline-offset:4px}.iq-collection-video__play:focus-visible,.iq-collection-video__link:focus-visible{outline:3px solid #A51D1B;outline-offset:4px}.iq-collection-video__direct{position:absolute;inset:auto 0 0;background:#fff;color:#171717;padding:12px}.iq-collection-video__error{font:400 14px/1.5 Archivo,sans-serif}@media(max-width:749px){.iq-collection-video{grid-template-columns:minmax(0,1fr);gap:24px;margin:32px auto}.iq-collection-video__frame{aspect-ratio:9/16}.iq-collection-video__copy{font-size:15px}.iq-collection-video h2{font-size:28px}}
{% endstylesheet %}

{% javascript %}
if (!customElements.get('iq-collection-video')) {
  customElements.define('iq-collection-video', class extends HTMLElement {
    connectedCallback() {
      if (this.ready) return;
      this.ready = true;
      this.button = this.querySelector('button');
      this.video = this.querySelector('video');
      this.media = window.matchMedia('(max-width:749px)');
      this.button.addEventListener('click', () => this.play());
      this.onResize = () => {
        if (!this.video.currentSrc) return;
        this.video.pause();
        this.video.removeAttribute('src');
        this.video.load();
        this.video.hidden = true;
        this.video.tabIndex = -1;
        this.button.hidden = false;
        this.querySelector('picture')?.removeAttribute('hidden');
      };
      this.media.addEventListener('change', this.onResize);
    }
    disconnectedCallback() { this.media?.removeEventListener('change', this.onResize); }
    async play() {
      const sources = JSON.parse(this.media.matches ? this.dataset.mobileSources : this.dataset.desktopSources).filter(s => s.mime_type === 'video/mp4').sort((a,b) => a.width - b.width);
      const width = Math.min(this.video.parentElement.clientWidth * Math.min(devicePixelRatio,2),1280);
      const source = sources.find(s => s.width >= width) || sources.at(-1);
      if (!source) return;
      this.querySelector('[role="status"]').hidden = true;
      this.video.src = source.url;
      this.video.hidden = false;
      this.video.tabIndex = 0;
      this.button.hidden = true;
      this.querySelector('picture')?.setAttribute('hidden','');
      this.video.focus({preventScroll:true});
      try { await this.video.play(); }
      catch { this.querySelector('[role="status"]').hidden = false; }
    }
  });
}
{% endjavascript %}

