      }

      #{{ section_id }} .iqw-redemption-grid,
      #{{ section_id }} .iqw-claim-grid,
      #{{ section_id }} .iqw-restore form,
      #{{ section_id }} .iqw-staff-form {
        grid-template-columns: 1fr;
      }

      #{{ section_id }} .iqw-staff-result dl > div {
        grid-template-columns: 1fr;
      }

      #{{ section_id }} {
        overflow-x: hidden;
        padding-top: 2rem;
        padding-bottom: 2rem;
      }

      #{{ section_id }} .page-width {
        padding-right: 1rem;
        padding-left: 1rem;
      }

      #{{ section_id }} .iqw-panel {
        border-radius: 1rem;
      }

      #{{ section_id }} .iqw-wheel-stage {
        width: 100%;
        padding-right: 0;
        padding-left: 0;
      }

      #{{ section_id }} .iqw-wheel {
        width: min(92vw, 36rem);
        max-width: 100%;
      }

      #{{ section_id }} .iqw-wheel-tap {
        width: 7.8rem;
        height: 7.8rem;
        padding: .7rem;
      }

      #{{ section_id }} .iqw-wheel-tap strong {
        max-width: 6.2rem;
        font-size: .78rem;
      }

      #{{ section_id }} .iqw-pointer {
        top: .8rem;
        border-right-width: 1.4rem;
        border-left-width: 1.4rem;
        border-top-width: 2.8rem;
      }

      #{{ section_id }} .iqw-product-instructions,
      #{{ section_id }} .iqw-redemption-card,
      #{{ section_id }} .iqw-code-card,
      #{{ section_id }} .iqw-important,
      #{{ section_id }} .iqw-team-note {
        padding: 1.6rem;
      }

      #{{ section_id }} .iqw-product-instructions ol {
        padding-left: 2rem;
      }

      #{{ section_id }} .btn {
        min-height: 4.8rem;
        white-space: normal;
        text-align: center;
      }
    }
  </style>

  <script>
    (() => {
      const root = document.getElementById({{ section_id | json }});

      if (!root || root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';

      const configElement = root.querySelector('[data-iqw-config]');
      if (!configElement) return;

      const cfg = JSON.parse(configElement.textContent);
      const text = cfg.texts;

      const apiUrl = String(cfg.apiUrl || '')
        .trim()
        .replace(/\/dev(?:\?.*)?$/, '/exec');

      const urlParams = new URLSearchParams(window.location.search);
      const staffMode = urlParams.get('staff') === '1';

      const customerOnly = root.querySelector('[data-customer-only]');
      const customerApp = root.querySelector('[data-customer-app]');
      const staffApp = root.querySelector('[data-staff-app]');
      const expiredView = root.querySelector('[data-expired-view]');

      const campaignEnd = new Date(cfg.campaignEnd);
      const campaignExpired =
        Number.isFinite(campaignEnd.getTime()) &&
        new Date().getTime() > campaignEnd.getTime();

      if (staffMode) {
        if (customerOnly) customerOnly.hidden = true;
        if (customerApp) customerApp.hidden = true;
        if (expiredView) expiredView.hidden = true;
        if (staffApp) staffApp.hidden = false;
      } else if (campaignExpired) {
        if (customerOnly) customerOnly.hidden = true;
        if (customerApp) customerApp.hidden = true;
        if (staffApp) staffApp.hidden = true;
        if (expiredView) expiredView.hidden = false;
      }

      const customerMessage = root.querySelector('[data-message]');
      const staffMessage = root.querySelector('[data-staff-message]');

      const prizeConfiguration = {
        'IQD-EPD-LAK': {
          discountCode: 'VDHRED2026',
          productUrl: 'https://iq-dogsport.de/products/iq-dogsport-aufkleber',
          variantDe: '8,5x9cm – Rot',
          variantEn: '8.5x9cm – Red'
        },

        'IQG-EPD-LAK': {
          discountCode: 'VDHRED2026',
          productUrl: 'https://iq-dogsport.de/products/iq-dogsport-aufkleber',
          variantDe: '8,5x9cm – Rot',
          variantEn: '8.5x9cm – Red'
        },

        'IQD-EPD-LAK.WEISS': {
          discountCode: 'VDHWHITE2026',
          productUrl: 'https://iq-dogsport.de/products/iq-dogsport-aufkleber',
          variantDe: 'weiß – 8,5x9cm',
          variantEn: 'White – 8.5x9cm'
        },

        'IQD-EPD-LAK.SCHWARZ': {
          discountCode: 'VDHBLACK2026',
          productUrl: 'https://iq-dogsport.de/products/iq-dogsport-aufkleber',
          variantDe: 'schwarz – 8,5x9cm',
          variantEn: 'Black – 8.5x9cm'
        },

        'IQD-ZBU-PCF.WH': {
          discountCode: 'VDHCLICKWHITE2026',
          productUrl: 'https://iq-dogsport.de/products/ring-clicker-finger-mounted-igp-training',
          variantDe: 'Weiß',
          variantEn: 'White'
        },

        'IQD-ZBU-PCF.WHITE': {
          discountCode: 'VDHCLICKWHITE2026',
          productUrl: 'https://iq-dogsport.de/products/ring-clicker-finger-mounted-igp-training',
          variantDe: 'Weiß',
          variantEn: 'White'
        },

        'IQD-ZBU-PCF.BK': {
          discountCode: 'VDHCLICKBLACK2026',
          productUrl: 'https://iq-dogsport.de/products/ring-clicker-finger-mounted-igp-training',
          variantDe: 'Schwarz',
          variantEn: 'Black'
        },

        'IQD-ZBU-PCF.BL': {
          discountCode: 'VDHCLICKBLACK2026',
          productUrl: 'https://iq-dogsport.de/products/ring-clicker-finger-mounted-igp-training',
          variantDe: 'Schwarz',
          variantEn: 'Black'
        },

        'IQD-ZBU-PCF.SCHWARZ': {
          discountCode: 'VDHCLICKBLACK2026',
          productUrl: 'https://iq-dogsport.de/products/ring-clicker-finger-mounted-igp-training',
          variantDe: 'Schwarz',
          variantEn: 'Black'
        }
      };

      const getPrizeCode = (prize) => {
        return String(
          prize?.code ||
          prize?.prizeCode ||
          prize?.productCode ||
          ''
        ).trim();
      };

      const getPrizeConfiguration = (prize) => {
        const code = getPrizeCode(prize).toUpperCase();
        const exactMatch = prizeConfiguration[code];

        if (exactMatch) return exactMatch;

        const name = String(prize?.name || '').toLowerCase();
        const isRingclicker =
          name.includes('ringclicker') ||
          name.includes('ring clicker');

        if (isRingclicker && (name.includes('schwarz') || name.includes('black'))) {
          return {
            discountCode: 'VDHCLICKBLACK2026',
            productUrl: 'https://iq-dogsport.de/products/ring-clicker-finger-mounted-igp-training',
            variantDe: 'Schwarz',
            variantEn: 'Black'
          };
        }

        if (isRingclicker && (name.includes('weiß') || name.includes('weiss') || name.includes('white'))) {
          return {
            discountCode: 'VDHCLICKWHITE2026',
            productUrl: 'https://iq-dogsport.de/products/ring-clicker-finger-mounted-igp-training',
            variantDe: 'Weiß',
            variantEn: 'White'
          };
        }

        return null;
      };

      const getDiscountCode = (prize) => {
        return getPrizeConfiguration(prize)?.discountCode || '';
      };

      const buildDiscountProductUrl = (configuration) => {
        if (!configuration?.discountCode || !configuration?.productUrl) {
          return '';
        }

        const productUrl = new URL(configuration.productUrl);
        const redirectPath = productUrl.pathname + productUrl.search;

        return (
          productUrl.origin +
          '/discount/' +
          encodeURIComponent(configuration.discountCode) +
          '?redirect=' +
          encodeURIComponent(redirectPath)
        );
      };

      const isMissedPrize = (prize) => {
        const slot = Number(prize?.slot || 0);
        const code = getPrizeCode(prize).toUpperCase();
        const name = String(prize?.name || '').toLowerCase();

        return (
          slot === 10 ||
          code === 'MISSED' ||
          name.includes('leider daneben') ||
          name.includes('missed it')
        );
      };

      const showMessage = (element, value, type = '') => {
        if (!element) return;

        element.hidden = !value;
        element.textContent = value || '';
        element.classList.toggle('is-error', type === 'error');
        element.classList.toggle('is-success', type === 'success');
      };

      const setButtonLoading = (
        button,
        loading,
        loadingText,
        normalText
      ) => {
        if (!button) return;

        const label = button.querySelector('[data-button-text]');
        const loader = button.querySelector('.iqw-button-loader');

        button.disabled = loading;

        if (label) {
          label.textContent = loading ? loadingText : normalText;
        }

        if (loader) {
          loader.hidden = !loading;
        }
      };

      const jsonp = (payload) => {
        return new Promise((resolve, reject) => {
          if (!apiUrl.includes('script.google.com/macros/s/')) {
            reject(new Error('Apps Script URL missing.'));
            return;
          }

          const callbackName =
            'iqw_' +
            Date.now() +
            '_' +
            Math.random().toString(36).slice(2);

          const script = document.createElement('script');
          const requestUrl = new URL(apiUrl);

          Object.entries(payload).forEach(([key, value]) => {
            requestUrl.searchParams.set(
              key,
              String(value ?? '')
            );
          });

          requestUrl.searchParams.set('callback', callbackName);

          const cleanup = () => {
            delete window[callbackName];
            script.remove();
          };

          const timeout = window.setTimeout(() => {
            cleanup();
            reject(new Error(text.connectionError));
          }, 15000);

          window[callbackName] = (data) => {
            window.clearTimeout(timeout);
            cleanup();
            resolve(data);
          };

          script.onerror = () => {
            window.clearTimeout(timeout);
            cleanup();
            reject(new Error(text.connectionError));
          };

          script.src = requestUrl.toString();
          document.head.appendChild(script);
        });
      };

      const views = [...root.querySelectorAll('[data-view]')];
      const progressItems = [
        ...root.querySelectorAll('[data-progress]')
      ];

      const steps = ['register', 'spin', 'claim'];

      const showView = (name) => {
        views.forEach((view) => {
          view.classList.toggle(
            'is-active',
            view.dataset.view === name
          );
        });

        const currentIndex = steps.indexOf(name);

        progressItems.forEach((item, index) => {
          item.classList.toggle(
            'is-active',
            index === currentIndex
          );

          item.classList.toggle(
            'is-done',
            index < currentIndex
          );
        });

        if (customerApp) {
          const top =
            customerApp.getBoundingClientRect().top +
            window.scrollY -
            105;

          window.scrollTo({
            top: Math.max(0, top),
            behavior: 'smooth'
          });
        }
      };

      const customerState = {
        participantId: '',
        firstName: '',
        email: '',
        claimCode: '',
        prize: null,
        rotation: 0,
        spinning: false
      };

      const saveCustomerState = () => {
        try {
          localStorage.setItem(
            cfg.storageKey,
            JSON.stringify({
              participantId: customerState.participantId,
              firstName: customerState.firstName,
              email: customerState.email,
              claimCode: customerState.claimCode
            })
          );
        } catch (error) {}
      };

      const showClaim = (data) => {
        customerState.participantId =
          data.participantId ||
          customerState.participantId;

        customerState.firstName =
          data.firstName ||
          customerState.firstName;

        customerState.email =
          data.email ||
          customerState.email;

        customerState.claimCode =
          data.claimCode ||
          customerState.claimCode;

        customerState.prize =
          data.prize ||
          customerState.prize;

        const missed = isMissedPrize(customerState.prize);
        const winningResult =
          root.querySelector('[data-winning-result]');
        const missedResult =
          root.querySelector('[data-missed-result]');

        if (winningResult) {
          winningResult.hidden = missed;
        }

        if (missedResult) {
          missedResult.hidden = !missed;
        }

        if (!missed) {
          const configuration =
            getPrizeConfiguration(customerState.prize);

          const discountCode =
            configuration?.discountCode || '';

          const productUrl =
            buildDiscountProductUrl(configuration);

          const variantInstruction =
            document.documentElement.lang
              .toLowerCase()
              .startsWith('de')
              ? configuration?.variantDe || ''
              : configuration?.variantEn || '';

          root.querySelector(
            '[data-claim-name]'
          ).textContent =
            customerState.firstName;

          root.querySelector(
            '[data-prize-name]'
          ).textContent =
            customerState.prize?.name || '';

          root.querySelector(
            '[data-discount-code]'
          ).textContent =
            discountCode;

          const inlineDiscountCode =
            root.querySelector('[data-discount-code-inline]');

          if (inlineDiscountCode) {
            inlineDiscountCode.textContent = discountCode;
          }

          root.querySelector(
            '[data-variant-instruction]'
          ).textContent =
            variantInstruction;

          const productLink =
            root.querySelector('[data-product-link]');

          if (productLink) {
            productLink.href = productUrl || '#';
            productLink.hidden = !productUrl;
          }

          root.querySelector(
            '[data-claim-code]'
          ).textContent =
            customerState.claimCode;

          root.querySelector(
            '[data-claim-status]'
          ).textContent =
            data.status === 'REDEEMED'
              ? text.redeemed
              : text.reserved;

          root.querySelector(
            '[data-instruction]'
          ).textContent =
            customerState.prize?.instruction || '';
        }

        saveCustomerState();
        showView('claim');
      };

      const restoreClaim = async (claimCode) => {
        const data = await jsonp({
          action: 'claim',
          claimCode
        });

        if (!data.success) {
          throw new Error(
            data.message || 'Claim not found.'
          );
        }

        showClaim(data);
      };

      const registerForm =
        root.querySelector('[data-register-form]');

      registerForm?.addEventListener(
        'submit',
        async (event) => {
          event.preventDefault();

          if (campaignExpired) return;

          showMessage(customerMessage, '');

          const formData = new FormData(registerForm);

          const firstName = String(
            formData.get('firstName') || ''
          ).trim();

          const email = String(
            formData.get('email') || ''
          ).trim().toLowerCase();

          const newsletterConsent =
            formData.get('newsletterConsent') === 'true';

          const button =
            root.querySelector('[data-register-button]');

          if (!firstName) {
            showMessage(
              customerMessage,
              text.missingName,
              'error'
            );
            return;
          }

          if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            showMessage(
              customerMessage,
              text.missingEmail,
              'error'
            );
            return;
          }

          setButtonLoading(
            button,
            true,
            text.loading,
            text.start
          );

          try {
            const data = await jsonp({
              action: 'register',
              firstName,
              email,
              newsletterConsent
            });

            if (!data.success) {
              if (data.claimCode) {
                await restoreClaim(data.claimCode);
                return;
              }

              throw new Error(
                data.message || 'Registration failed.'
              );
            }

            customerState.participantId =
              data.participantId;

            customerState.firstName =
              data.firstName || firstName;

            customerState.email =
              data.email || email;

            saveCustomerState();

            root.querySelector(
              '[data-customer-name]'
            ).textContent =
              ', ' + customerState.firstName + '!';

            showView('spin');
          } catch (error) {
            showMessage(
              customerMessage,
              error.message,
              'error'
            );
          } finally {
            setButtonLoading(
              button,
              false,
              text.loading,
              text.start
            );
          }
        }
      );

      root
        .querySelector('[data-restore-form]')
        ?.addEventListener('submit', async (event) => {
          event.preventDefault();

          const claimCode = String(
            new FormData(event.currentTarget)
              .get('claimCode') || ''
          ).trim();

          if (!claimCode) {
            showMessage(
              customerMessage,
              text.missingClaim,
              'error'
            );
            return;
          }

          try {
            await restoreClaim(claimCode);
          } catch (error) {
            showMessage(
              customerMessage,
              error.message,
              'error'
            );
          }
        });

      const wheel = root.querySelector('[data-wheel]');
      const wheelLoading =
        root.querySelector('[data-wheel-loading]');
      const wheelTap =
        root.querySelector('.iqw-wheel-tap');

      const spinTriggers = [
        ...root.querySelectorAll('[data-spin-trigger]')
      ];

      const setSpinLoading = (loading) => {
        spinTriggers.forEach((trigger) => {
          trigger.disabled = loading;

          if (trigger.matches('.btn')) {
            setButtonLoading(
              trigger,
              loading,
              text.determining,
              text.spin
            );
          }
        });

        wheel?.classList.toggle(
          'is-spinning',
          loading
        );

        wheelTap?.classList.toggle(
          'is-hidden',
          loading
        );
      };

      const startSpin = async () => {
        if (
          campaignExpired ||
          customerState.spinning ||
          !customerState.participantId
        ) {
          return;
        }

        customerState.spinning = true;
        showMessage(customerMessage, '');

        if (wheelLoading) {
          wheelLoading.hidden = false;
        }

        setSpinLoading(true);

        try {
          const data = await jsonp({
            action: 'spin',
            participantId: customerState.participantId
          });

          if (!data.success) {
            if (data.claimCode) {
              if (wheelLoading) {
                wheelLoading.hidden = true;
              }

              await restoreClaim(data.claimCode);
              return;
            }

            throw new Error(
              data.message || 'Spin failed.'
            );
          }

          if (wheelLoading) {
            wheelLoading.hidden = true;
          }

          const slot = Math.min(
            10,
            Math.max(
              1,
              Number(data.prize?.slot || 1)
            )
          );

          const segmentAngle = 360 / 10;
          const segmentCenter =
            ((slot - 1) * segmentAngle) +
            (segmentAngle / 2);

          const additionalTurns = 2160;

          const targetRotation =
            customerState.rotation +
            additionalTurns +
            (360 - segmentCenter);

          customerState.rotation = targetRotation;

          if (wheel) {
            wheel.style.transform =
              'rotate(' +
              targetRotation +
              'deg)';
          }

          window.setTimeout(() => {
            customerState.claimCode =
              data.claimCode || '';

            customerState.prize =
              data.prize || null;

            customerState.spinning = false;
            setSpinLoading(false);
            showClaim(data);
          }, Number(cfg.animationMs || 5200));
        } catch (error) {
          if (wheelLoading) {
            wheelLoading.hidden = true;
          }

          customerState.spinning = false;
          setSpinLoading(false);

          showMessage(
            customerMessage,
            error.message,
            'error'
          );
        }
      };

      spinTriggers.forEach((trigger) => {
        trigger.addEventListener(
          'click',
          startSpin
        );

        if (trigger.matches('[role="button"]')) {
          trigger.addEventListener(
            'keydown',
            (event) => {
              if (
                event.key === 'Enter' ||
                event.key === ' '
              ) {
                event.preventDefault();
                startSpin();
              }
            }
          );
        }
      });

      root
        .querySelector('[data-copy-discount]')
        ?.addEventListener(
          'click',
          async (event) => {
            const button = event.currentTarget;

            const code = String(
              root.querySelector(
                '[data-discount-code]'
              )?.textContent || ''
            ).trim();

            if (!code) return;

            try {
              await navigator.clipboard.writeText(code);
            } catch (error) {
              const textarea =
                document.createElement('textarea');

              textarea.value = code;
              document.body.appendChild(textarea);
              textarea.select();
              document.execCommand('copy');
              textarea.remove();
            }

            button.textContent = text.copied;

            window.setTimeout(() => {
              button.textContent = text.copyCode;
            }, 1600);
          }
        );

      try {
        const saved = JSON.parse(
          localStorage.getItem(
            cfg.storageKey
          ) || '{}'
        );

        if (
          saved.claimCode &&
          !staffMode
        ) {
          restoreClaim(saved.claimCode).catch(() => {
            localStorage.removeItem(cfg.storageKey);
          });
        } else if (saved.participantId) {
          customerState.participantId =
            saved.participantId;

          customerState.firstName =
            saved.firstName || '';

          customerState.email =
            saved.email || '';
        }
      } catch (error) {}

      const staffLogin =
        root.querySelector('[data-staff-login]');
      const staffWorkspace =
        root.querySelector('[data-staff-workspace]');
      const staffSearch =
        root.querySelector('[data-staff-search]');
      const staffResult =
        root.querySelector('[data-staff-result]');
      const staffSuccess =
        root.querySelector('[data-staff-success]');
      const staffRedeem =
        root.querySelector('[data-staff-redeem]');

      let staffPin =
        sessionStorage.getItem('iqwStaffPin') || '';

      let activeClaim = null;

      const openStaffWorkspace = () => {
        if (staffLogin) {
          staffLogin.hidden = true;
        }

        if (staffWorkspace) {
          staffWorkspace.hidden = false;
        }

        root
          .querySelector('[data-staff-code]')
          ?.focus();
      };

      if (staffMode && staffPin) {
        openStaffWorkspace();
      }

      staffLogin?.addEventListener(
        'submit',
        (event) => {
          event.preventDefault();

          const value = String(
            new FormData(staffLogin)
              .get('staffPin') || ''
          ).trim();

          if (!value) {
            showMessage(
              staffMessage,
              text.missingPin,
              'error'
            );
            return;
          }

          staffPin = value;
          sessionStorage.setItem(
            'iqwStaffPin',
            staffPin
          );

          showMessage(staffMessage, '');
          openStaffWorkspace();
        }
      );

      staffSearch?.addEventListener(
        'submit',
        async (event) => {
          event.preventDefault();
          showMessage(staffMessage, '');

          const claimCode = String(
            new FormData(staffSearch)
              .get('claimCode') || ''
          ).trim();

          if (!claimCode) {
            showMessage(
              staffMessage,
              text.missingClaim,
              'error'
            );
            return;
          }

          try {
            const data = await jsonp({
              action: 'claim',
              claimCode
            });

            if (!data.success) {
              throw new Error(
                data.message || 'Claim not found.'
              );
            }

            activeClaim = data;

            const missed =
              isMissedPrize(data.prize);

            if (staffSuccess) {
              staffSuccess.hidden = true;
            }

            if (staffResult) {
              staffResult.hidden = false;
            }

            root.querySelector(
              '[data-staff-customer]'
            ).textContent =
              data.firstName || '—';

            root.querySelector(
              '[data-staff-prize]'
            ).textContent =
              data.prize?.name || '—';

            root.querySelector(
              '[data-staff-discount]'
            ).textContent =
              missed
                ? '—'
                : getDiscountCode(data.prize);

            root.querySelector(
              '[data-staff-status]'
            ).textContent =
              data.status === 'REDEEMED'
                ? text.redeemed
                : text.reserved;

            if (
              missed ||
              data.status === 'REDEEMED'
            ) {
              staffRedeem.disabled = true;
            } else {
              staffRedeem.disabled = false;
            }
          } catch (error) {
            if (staffResult) {
              staffResult.hidden = true;
            }

            showMessage(
              staffMessage,
              error.message,
              'error'
            );
          }
        }
      );

      staffRedeem?.addEventListener(
        'click',
        async () => {
          if (
            !activeClaim ||
            activeClaim.status === 'REDEEMED' ||
            isMissedPrize(activeClaim.prize)
          ) {
            return;
          }

          const orderNumber = String(
            root.querySelector(
              '[data-staff-order]'
            )?.value || ''
          ).trim();

          setButtonLoading(
            staffRedeem,
            true,
            text.loading,
            text.issue
          );

          try {
            const data = await jsonp({
              action: 'redeem',
              claimCode: activeClaim.claimCode,
              orderNumber,
              staffPin,
              redeemedBy: 'Kasse'
            });

            if (!data.success) {
              throw new Error(
                data.message ||
                'Redemption failed.'
              );
            }

            if (staffResult) {
              staffResult.hidden = true;
            }

            if (staffSuccess) {
              staffSuccess.hidden = false;
            }

            showMessage(staffMessage, '');
          } catch (error) {
            showMessage(
              staffMessage,
              error.message,
              'error'
            );
          } finally {
            setButtonLoading(
              staffRedeem,
              false,
              text.loading,
              text.issue
            );
          }
        }
      );

      root
        .querySelector('[data-staff-next]')
        ?.addEventListener('click', () => {
          activeClaim = null;

          if (staffSuccess) {
            staffSuccess.hidden = true;
          }

          if (staffResult) {
            staffResult.hidden = true;
          }

          staffSearch?.reset();

          const orderInput =
            root.querySelector(
              '[data-staff-order]'
            );

          if (orderInput) {
            orderInput.value = '';
          }

          showMessage(staffMessage, '');

          root
            .querySelector('[data-staff-code]')
            ?.focus();
        });

      if (
        root.dataset.hideFooterNewsletter === 'true'
      ) {
        const hideFooterNewsletter = () => {
          document
            .querySelectorAll(
              '.shopify-section-group-footer-group .shopify-section'
            )
            .forEach((footerSection) => {
              if (
                footerSection.querySelector(
                  'input[type="email"]'
                )
              ) {
                footerSection.style.display = 'none';
              }
            });
        };

        hideFooterNewsletter();
        window.setTimeout(hideFooterNewsletter, 500);
        window.setTimeout(hideFooterNewsletter, 1500);
      }
    })();
  </script>
</section>

