{% doc %}
  Editor-managed content preserving the existing collection layout.
  @param {block} block - Content block.
{% enddoc %}
{%- liquid
  assign iq_en = false
  if request.locale.iso_code == 'en'
    assign iq_en = true
  endif
  assign iq_photo = block.settings.bild_1
  if iq_en
    assign iq_alt = block.settings.text_2
  else
    assign iq_alt = block.settings.text_3
  endif
-%}
<section class="iq-hs-3">
<div class="copy">{% if iq_en %}<p class="kicker">{{ block.settings.text_4 | escape }}</p><h2 class="title">{{ block.settings.text_5 | escape }}<br><span>{{ block.settings.text_6 | escape }}</span></h2><p>{{ block.settings.text_7 | escape }}</p>{% else %}<p class="kicker">{{ block.settings.text_8 | escape }}</p><h2 class="title">{{ block.settings.text_9 | escape }}<br><span>{{ block.settings.text_10 | escape }}</span></h2><p>{{ block.settings.text_11 | escape }}</p>{% endif %}</div>
<div class="photo">
{% if iq_photo != blank %}
{{ iq_photo | image_url: width: 1000 | image_tag: widths: '360, 480, 640, 800, 1000', sizes: '(min-width: 1200px) 600px, (min-width: 750px) 50vw, 100vw', loading: 'lazy', decoding: 'async', alt: iq_alt }}
{% endif %}
</div></section>
<style>.iq-hs-3{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);align-items:center;width:100%;max-width:1600px;min-width:0;gap:0;margin:24px auto;padding:0;box-sizing:border-box;background:transparent;color:#18191b}
.iq-hs-3 .copy{min-width:0;box-sizing:border-box;padding:28px clamp(20px,4vw,64px);overflow-wrap:anywhere}
.iq-hs-3 .kicker{font:700 11px/1.5 Archivo,Arial,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:#a51d1b;margin:0 0 12px}
.iq-hs-3 .title{font-family:Montserrat,Arial,sans-serif;font-size:clamp(28px,3vw,42px);font-weight:800;font-style:italic;text-transform:uppercase;line-height:1.1;letter-spacing:-.03em;margin:0 0 16px}
.iq-hs-3 .title span{color:#a51d1b}
.iq-hs-3 .copy p:not(.kicker){font:400 15px/1.5 Archivo,Arial,sans-serif;margin:0;max-width:510px}
.iq-hs-3 .photo{min-width:0;width:100%;max-width:600px;justify-self:center}
.iq-hs-3 img{display:block;width:100%;height:auto;max-width:100%;border-radius:0}
.collection__content:has(.iq-hs-3)>.flex,#ProductGridContainer:has(.iq-hs-3),#ProductsList:has(.iq-hs-3),.collection-inline-block:has(.iq-hs-3){min-width:0;max-width:100%;box-sizing:border-box}
.collection-inline-block--full:has(.iq-hs-3){grid-column:1/-1;width:100%}
@media(max-width:749px){.iq-hs-3{display:flex;flex-direction:column;margin:20px 0;gap:0}.iq-hs-3 .photo{order:-1;max-width:none}.iq-hs-3 .copy{padding:18px 16px 22px;width:100%}.iq-hs-3 .title{font-size:26px;margin-bottom:12px}.iq-hs-3 .kicker{font-size:10px}.iq-hs-3 .copy p:not(.kicker){font-size:14px;line-height:1.5}}</style>