{{ 'iq-home-refresh.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign en = false
  if request.locale.iso_code == 'en'
    assign en = true
  endif
-%}
{% liquid
  assign media_image = section.settings.image
  if section.settings.video != blank and media_image == blank
    assign media_image = section.settings.video.preview_image
  endif
  assign image_alt = section.settings.alt
  if en and section.settings.alt_en != blank
    assign image_alt = section.settings.alt_en
  endif
%}
<section class="iqh iqh-wrap iqh-feature-wrap">
<div class="iqh-feature iqh-feature--{{ section.settings.style }}">
{% if section.settings.style == 'founders' and section.settings.background_image != blank %}<div class="iqh-founder-background" aria-hidden="true">{{ section.settings.background_image | image_url: width: 1600 | image_tag: loading: 'lazy', alt: '' }}</div>{% endif %}<div class="iqh-feature-media">
{% if section.settings.video != blank %}
{% assign poster_url = media_image | image_url: width: 1000 %}
{{ section.settings.video | video_tag: image_size: '1000x', controls: true, autoplay: false, loop: false, preload: 'none', poster: poster_url, class: 'iqh-feature-video' }}
{% elsif media_image != blank %}
{{ media_image | image_url: width: 2000 | image_tag: widths: '360,400,540,600,720,750,800,1000,1200,1400,1600,2000', sizes: '(min-width: 1280px) 641px, (min-width: 750px) 50vw, calc(100vw - 40px)', loading: 'lazy', alt: image_alt }}
{% endif %}
</div><div class="iqh-feature-copy"><p class="iqh-eyebrow">{% if en and section.settings.eyebrow_en != blank %}{{ section.settings.eyebrow_en | escape }}{% else %}{{ section.settings.eyebrow | escape }}{% endif %}</p><h2 class="iqh-heading">{% if en and section.settings.heading_en != blank %}{{ section.settings.heading_en | escape }}{% else %}{{ section.settings.heading | escape }}{% endif %}</h2><div class="iqh-body">{% if en and section.settings.body_en != blank %}{{ section.settings.body_en }}{% else %}{{ section.settings.body }}{% endif %}</div><p class="iqh-detail">{% if en and section.settings.detail_en != blank %}{{ section.settings.detail_en | escape }}{% else %}{{ section.settings.detail | escape }}{% endif %}</p>{% if section.settings.link != blank %}<a class="iqh-pill" href="{% if en and section.settings.link_en != blank %}{{ section.settings.link_en }}{% else %}{{ section.settings.link }}{% endif %}">{% if en and section.settings.cta_en != blank %}{{ section.settings.cta_en | escape }}{% else %}{{ section.settings.cta | escape }}{% endif %} <span aria-hidden="true">→</span></a>{% endif %}</div></div></section>
{% stylesheet %}
.iqh .iqh-feature--coat{grid-template-columns:minmax(0,48%) minmax(0,52%)}.iqh .iqh-feature--coat .iqh-feature-media{grid-column:2;grid-row:1;height:auto;aspect-ratio:1}.iqh .iqh-feature--coat .iqh-feature-copy{grid-column:1;grid-row:1}.iqh .iqh-feature--coat .iqh-feature-media>img{height:100%;object-fit:contain}.iqh .iqh-feature--coat .iqh-pill{padding:10px 18px;min-height:44px}@media(max-width:749px){.iqh .iqh-feature--coat{display:flex;flex-direction:column}.iqh .iqh-feature--coat .iqh-feature-media{width:100%;max-height:none;aspect-ratio:1}.iqh .iqh-feature--coat .iqh-feature-copy{width:100%}}
{% endstylesheet %}
{% schema %}
{
  "name": "IQ Start · Fokus",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Darstellung",
      "options": [
        {
          "value": "coat",
          "label": "Produkt – hell"
        },
        {
          "value": "founders",
          "label": "Gründer – Text auf Foto"
        }
      ],
      "default": "coat"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Foto"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Gründer: Hintergrund links (Desktop)",
      "info": "Nur die linke Hälfte wird gezeigt. Das Originalfoto rechts bleibt unverändert."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Optionales Video",
      "info": "Ohne Video wird nur das Foto gezeigt. Das Foto dient bei Video als Startbild. Kein Autoplay."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Bildbeschreibung · DE"
    },
    {
      "type": "text",
      "id": "alt_en",
      "label": "Bildbeschreibung · EN"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Dachzeile · DE"
    },
    {
      "type": "text",
      "id": "eyebrow_en",
      "label": "Dachzeile · EN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift · DE"
    },
    {
      "type": "text",
      "id": "heading_en",
      "label": "Überschrift · EN"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Kurztext · DE"
    },
    {
      "type": "richtext",
      "id": "body_en",
      "label": "Kurztext · EN"
    },
    {
      "type": "text",
      "id": "detail",
      "label": "Kurze Vorteile / Namen · DE"
    },
    {
      "type": "text",
      "id": "detail_en",
      "label": "Kurze Vorteile / Namen · EN"
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Button · DE"
    },
    {
      "type": "text",
      "id": "cta_en",
      "label": "Button · EN"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link · DE"
    },
    {
      "type": "url",
      "id": "link_en",
      "label": "Link · EN"
    }
  ],
  "presets": [
    {
      "name": "IQ Start · Fokus"
    }
  ]
}
{% endschema %}

