    "iq_training_details": {
      "type": "iq-collection-story",
      "blocks": {
        "magnet": {
          "type": "feature",
          "settings": {
            "layout": "split",
            "image": "shopify://shop_images/IQ-Magnetizer-Rueckseite.jpg",
            "product": "iq-magnetizer",
            "heading_de": "Befestigen. Positionieren. Bestätigen.",
            "heading_en": "Attach. Position. Reward.",
            "body_de": "<p>Befestige den Adapter mit Kabelbindern am geeigneten Spielzeug und kombiniere ihn mit einem passenden Magnetsystem, beispielsweise Top-Matic. Normal ist für Sucharbeit und Detection gedacht, Extra für größere Spielzeuge und dynamische Arbeit.</p>",
            "body_en": "<p>Attach the adapter to a suitable toy using cable ties and combine it with a compatible magnetic system, such as Top-Matic. Normal is intended for scent work and detection; Extra for larger toys and dynamic training.</p>",
            "eyebrow_de": "IQ Magnetizer · Unterordnung & Sucharbeit",
            "eyebrow_en": "IQ training equipment",
            "alt_de": "IQ Magnetizer · Unterordnung & Sucharbeit",
            "alt_en": "Your toy. Magnetically positioned.",
            "link_label_de": "Produkt ansehen",
            "link_label_en": "View product",
            "reverse": false,
            "focal_x": 50,
            "focal_y": 50
          }
        },
        "trainer": {
          "type": "feature",
          "settings": {
            "layout": "split",
            "image": "shopify://shop_images/Gegenstandstrainer-2.0-Funktion_web.jpg",
            "product": "iq-gegenstandstrainer",
            "heading_de": "Die Bestätigung kommt am Gegenstand.",
            "heading_en": "Reward at the article.",
            "body_de": "<p>Befestige den Fährtengegenstand auf dem Trainer und lege Futter darunter. Zum Bestätigen hebst Du den Trainer an. Die Metallspitzen sind für weichen Boden einschraubbar und für den Einsatz drinnen abnehmbar.</p>",
            "body_en": "<p>Attach the tracking article to the trainer and place food underneath. Lift the trainer to release the reward. Screw in the metal spikes for soft ground and remove them for indoor use.</p>",
            "eyebrow_de": "IQ Gegenstandstrainer 2.0 · Fährte",
            "eyebrow_en": "IQ training equipment",
            "alt_de": "IQ Gegenstandstrainer 2.0 · Fährte",
            "alt_en": "Stay at the article. Reward with purpose.",
            "link_label_de": "Produkt ansehen",
            "link_label_en": "View product",
            "reverse": true,
            "focal_x": 50,
            "focal_y": 50
          }
        }
      },
      "block_order": [
        "magnet",
        "trainer"
      ],
      "settings": {
        "only_collection": "hundesport-trainingszubehoer"
      }
    },
    "iq_food_details": {
      "type": "iq-collection-story",
      "blocks": {
        "sticks": {
          "type": "feature",
          "settings": {
            "layout": "split",
            "image": "shopify://shop_images/iq-sticks-pferd-10cm.jpg",
            "product": "iq-sticks-pferd",
            "heading_de": "Für die Fährte. Für zwischendurch.",
            "heading_en": "For tracking. For everyday rewards.",
            "body_de": "<p>Die IQ Sticks Pferd enthalten 71 % Pferd. Ihre feste Konsistenz lässt sich portionieren – für die Fährtenarbeit oder als vorbereitete Belohnung aus der IQ Balltasche.</p>",
            "body_en": "<p>IQ horse sticks contain 71% horse. Their firm texture can be portioned for tracking or prepared as rewards in the IQ ball pocket.</p>",
            "alt_de": "Für die Fährte. Für zwischendurch.",
            "alt_en": "For tracking. For everyday rewards.",
            "link_label_de": "Produkt ansehen",
            "link_label_en": "View product",
