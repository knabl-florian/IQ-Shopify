{{ 'iq-home-refresh.css' | asset_url | stylesheet_tag }}
{% liquid
 assign en = false
 if request.locale.iso_code == 'en'
 assign en = true
 endif
%}
<section class="iqh iqh-categories"><iq-category-navigation><div class="iqh-wrap"><div class="iqh-category-head">{% if section.settings.heading != blank or section.settings.heading_en != blank %}<h2 class="iqh-heading">{% if en and section.settings.heading_en != blank %}{{ section.settings.heading_en | escape }}{% else %}{{ section.settings.heading | escape }}{% endif %}</h2>{% endif %}<div class="iqh-category-controls"><button type="button" data-category-prev aria-controls="IQCategoryGrid-{{ section.id }}" aria-label="{% if en %}Previous categories{% else %}Vorherige Kategorien{% endif %}" disabled>←</button><button type="button" data-category-next aria-controls="IQCategoryGrid-{{ section.id }}" aria-label="{% if en %}More categories{% else %}Weitere Kategorien{% endif %}">→</button></div></div><div id="IQCategoryGrid-{{ section.id }}" class="iqh-category-grid">{% for block in section.blocks %}{% assign category = block.settings.collection %}{% if category != blank %}<a class="iqh-category" style="--iqh-category-desktop-y:{{ block.settings.position_y | default: 0 }}%;--iqh-category-mobile-y:{{ block.settings.mobile_position_y | default: 0 }}%" href="{{ category.url }}" {{ block.shopify_attributes }}>{% assign photo = block.settings.image | default: category.image %}{% if photo != blank %}<picture>{% if block.settings.mobile_image != blank %}<source media="(max-width:749px)" srcset="{{ block.settings.mobile_image | image_url: width: 540 }}">{% endif %}{% assign alt = block.settings.alt %}{% if en and block.settings.alt_en != blank %}{% assign alt = block.settings.alt_en %}{% endif %}{{ photo | image_url: width: 1000 | image_tag: widths: '240,360,540,720,1000', sizes: '(min-width:1440px) 16vw, (min-width:990px) 23vw, (min-width:750px) 30vw, 44vw', loading: 'lazy', alt: alt, style: 'object-position:50% var(--iqh-category-current-y,0%)' }}</picture>{% endif %}<span class="iqh-category-label"><span>{% if en and block.settings.title_en != blank %}{{ block.settings.title_en | escape }}{% else %}{{ block.settings.title | escape }}{% endif %}</span><span class="iqh-category-arrow" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false" style="display:block"><path d="M5 19 19 5M5 5h14v14"/></svg></span></span></a>{% endif %}{% endfor %}</div></div></iq-category-navigation></section>
{% javascript %}
if (!customElements.get('iq-category-navigation')) {
  customElements.define('iq-category-navigation', class extends HTMLElement {
    connectedCallback() {
      if (this.grid) return;
      this.grid = this.querySelector('.iqh-category-grid');
      this.previous = this.querySelector('[data-category-prev]');
      this.next = this.querySelector('[data-category-next]');
      if (!this.grid || !this.previous || !this.next) return;
      this.update = () => {
        const max = this.grid.scrollWidth - this.grid.clientWidth;
        const left = Math.max(0, this.grid.scrollLeft);
        this.classList.toggle('has-overflow', max > 2);
        this.previous.disabled = left < 2;
        this.next.disabled = left >= max - 2;
      };
      this.back = () => this.move(-1);
      this.forward = () => this.move(1);
      this.previous.addEventListener('click', this.back);
      this.next.addEventListener('click', this.forward);
      this.grid.addEventListener('scroll', this.update, {passive:true});
      this.observer = new ResizeObserver(this.update);
      this.observer.observe(this.grid);
      this.update();
    }
    move(direction) {
      this.grid.scrollBy({
        left: direction * this.grid.clientWidth * 0.8,
        behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'
      });
    }
    disconnectedCallback() {
      this.observer?.disconnect();
      this.grid?.removeEventListener('scroll', this.update);
      this.previous?.removeEventListener('click', this.back);
      this.next?.removeEventListener('click', this.forward);
      this.grid = null;
    }
  });
}
{% endjavascript %}

{% schema %}
{
  "name": "IQ Start · Kategorien",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift · DE"
    },
    {
      "type": "text",
      "id": "heading_en",
      "label": "Überschrift · EN"
    }
  ],
  "max_blocks": 8,
  "blocks": [
    {
      "type": "category",
      "name": "Kategorie",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Kollektion"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobilfoto (optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel · DE"
        },
        {
          "type": "text",
          "id": "title_en",
          "label": "Titel · EN"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Bildbeschreibung · DE"
        },
        {
          "type": "text",
          "id": "alt_en",
          "label": "Bildbeschreibung · EN"
        },
        {
          "type": "range",
          "id": "position_y",
          "label": "Bildausschnitt vertikal · Desktop",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 0,
          "info": "0 = oben, 50 = mittig, 100 = unten. Köpfe und Ohren sichtbar halten."
        },
        {
          "type": "range",
          "id": "mobile_position_y",
          "label": "Bildausschnitt vertikal · Mobil",
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "IQ Start · Kategorien"
    }
  ]
}
{% endschema %}
