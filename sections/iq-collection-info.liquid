{% liquid
  assign heading = section.settings.heading_de
  assign body = section.settings.text_de
  if request.locale.iso_code == 'en'
    assign heading = section.settings.heading_en
    assign body = section.settings.text_en
  endif
  if section.settings.use_description
    assign body = collection.description
  endif
%}
{% if section.settings.only_collection == blank or section.settings.only_collection.handle == collection.handle %}
{% if body != blank or section.blocks.size > 0 %}
<section class="iqci">
  {% if heading != blank %}<h2>{{ heading | escape }}</h2>{% endif %}
  {% if body != blank %}<div class="iqci__text rte">{{ body }}</div>{% endif %}
  {% if section.blocks.size > 0 %}
  <ul class="iqci__links" role="list">
  {% for block in section.blocks %}
    {% liquid
      assign label = block.settings.label_de
      assign target = block.settings.url_de
      if request.locale.iso_code == 'en'
        assign label = block.settings.label_en | default: label
        assign target = block.settings.url_en | default: target
      endif
    %}
    {% if label != blank and target != blank %}<li {{ block.shopify_attributes }}><a href="{{ target | escape }}">{{ label | escape }}</a></li>{% endif %}
  {% endfor %}
  </ul>
  {% endif %}
</section>
{% endif %}
{% endif %}
{% stylesheet %}
.iqci{box-sizing:border-box;width:100%;max-width:1440px;margin:0 auto;padding:40px 50px;color:#171717;background:#fff;text-align:left}
.iqci h2{font:700 24px/1.3 Archivo,sans-serif;text-transform:none;letter-spacing:0;margin:0 0 20px;color:#171717}
.iqci__text{max-width:900px;font:400 15px/1.6 Archivo,sans-serif}
.iqci__text p{margin:0 0 14px;font:inherit}
.iqci a{color:#A51D1B;text-decoration:underline;text-underline-offset:3px}
.iqci a:focus-visible{outline:2px solid #A51D1B;outline-offset:4px}
.iqci__links{list-style:none;margin:20px 0 0;padding:0;display:flex;flex-wrap:wrap;gap:8px 24px}
.iqci__links a{display:inline-flex;align-items:center;min-height:44px;font:700 15px/1.4 Archivo,sans-serif}
@media(max-width:749px){.iqci{padding:28px 20px}.iqci h2{font-size:21px}.iqci__text,.iqci__links a{font-size:14px}}
{% endstylesheet %}
{% schema %}
{
 "name":"IQ Collection Infos",
 "enabled_on":{"templates":["collection"]},
 "max_blocks":6,
 "settings":[
 {"type":"collection","id":"only_collection","label":"Nur für diese Collection","info":"Leer = alle Collections mit dieser Vorlage."},
 {"type":"text","id":"heading_de","label":"Überschrift Deutsch","default":"Wissen fürs Training"},
 {"type":"text","id":"heading_en","label":"Überschrift Englisch","default":"Training guides"},
 {"type":"checkbox","id":"use_description","label":"Collection-Beschreibung übernehmen","default":true,"info":"Übernimmt den vorhandenen Text einschließlich Links und Shop-Übersetzungen. Eigene Texte unten werden dann nicht angezeigt."},
 {"type":"richtext","id":"text_de","label":"Eigener Text Deutsch"},
 {"type":"richtext","id":"text_en","label":"Eigener Text Englisch"}
 ],
 "blocks":[{"type":"guide","name":"Ratgeber-Link","settings":[
 {"type":"text","id":"label_de","label":"Beschriftung Deutsch"},
 {"type":"text","id":"label_en","label":"Beschriftung Englisch"},
 {"type":"url","id":"url_de","label":"Linkziel Deutsch"},
 {"type":"url","id":"url_en","label":"Linkziel Englisch"}
 ]}],
 "presets":[{"name":"IQ Collection Infos"}]
}
{% endschema %}
