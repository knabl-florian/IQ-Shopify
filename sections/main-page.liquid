<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
</style>

<div class="page-width page-width--narrow section--padding">
  {% unless page.id == 165915459848 %}
  <h1 class="main-page-title page-title h1 text-center">
    <motion-element class="inline-flex" data-motion="fade-up">
      {{ page.title | escape }}
    </motion-element>
  </h1>
  {% endunless %}
  <div class="page__content rte">
    {% if page.id == 165915459848 and request.locale.iso_code == 'de' %}
      {% assign iq_terms_heading = 'iq_igp.terms_heading' | t %}
      {% assign iq_terms_sentence = 'iq_igp.terms_sentence' | t %}
      {{ page.content | replace_first: 'IPO, VPG, Schutzhund oder IGP – was ist der Unterschied?', iq_terms_heading | replace_first: 'Wer heute auf Begriffe wie „IPO-Hundesport“ oder „Schutzhundsport“ stößt, meint in der Regel den heutigen IGP-Sport.', iq_terms_sentence }}
    {% else %}
      {{ page.content }}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 50
    }
  ]
}
{% endschema %}
