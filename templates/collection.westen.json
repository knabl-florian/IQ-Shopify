    "custom_liquid_ezLGxq": {
      "type": "iq-release-section-20",
      "blocks": {
        "part1": {
          "type": "part1",
          "settings": {
            "link_1": "/en/products/iq-hundesportweste-3-0-unisex",
            "link_2": "/collections/hundesport-jacken",
            "link_3": "/en/collections/hundesport-jacken",
            "link_4": "/collections/hundesport-hosen",
            "link_5": "/en/collections/hundesport-hosen",
            "link_6": "/collections/hundesport-zubehoer-damen",
            "link_7": "/en/collections/hundesport-zubehoer-damen",
            "link_8": "/en/pages/igp-hundesport",
            "link_9": "/products/iq-hundesportweste-3-0-unisex",
            "link_10": "/pages/igp-hundesport",
            "text_11": "KNOWLEDGE & FEATURES",
            "text_12": "MORE ABOUT",
            "text_13": "IQ VESTS.",
            "text_14": "WISSEN & AUSSTATTUNG",
            "text_15": "MEHR ÜBER",
            "text_16": "IQ WESTEN.",
            "text_17": "Dog sport vests, training vests and handler vests",
            "text_18": "A dog sport vest is more than clothing. It is a training tool for the training field, everyday use and competition. IQ Dogsport dog sport vests and handler vests are developed for active dog sport handlers, trainers, dog handlers and K9 teams.",
            "text_19": "The focus is on freedom of movement, robust materials and a smart pocket system for efficient dog training. Developed by a multiple IGP World Champion and tested under real training conditions.",
            "text_20": "Dog sport vests with large back pocket"
          }
        },
        "part2": {
          "type": "part2",
          "settings": {
            "text_21": "The large, full-width back pocket is one of the key features of IQ dog sport vests. It offers space for toys, leashes and training accessories and allows quick access during training.",
            "text_22": "For women and men, a vest with a back pocket is especially practical when equipment needs to be stored securely but remain quickly accessible. In obedience, protection work and daily dog training, the back pocket supports clear routines on the training field.",
            "text_23": "Patented training solutions for precise timing",
            "text_24": "The",
            "text_25": "IQ Dog Sport Vest 3.0",
            "text_26": "features patented chest pockets for centered reinforcement without visible body help. The system is complemented by the IQ magnetic pocket for hidden reinforcement in heelwork and modular food pockets for flexible training.",
            "text_27": "This creates more than a classic training vest: the IQ dog sport vest is a modular training system for handlers, trainers and ambitious dog sport athletes.",
            "text_28": "Training vests for IGP, protection work and dog training",
            "text_29": "Whether IGP, working dog sport, protection work or professional dog training – a good training vest has to organize equipment, allow freedom of movement and make fast reinforcement possible. IQ dog sport vests are developed to make training more efficient, precise and repeatable.",
            "text_30": "Robust materials, bartack-reinforced stress points and durable zippers ensure that the vests perform reliably during regular use on the training field, at seminars and in competition.",
            "text_31": "Matching categories:",
            "text_32": "dog sport jackets",
            "text_33": "training pants",
            "text_34": "and",
            "text_35": "accessories for dog sport",
            "text_36": "Want to know what IGP is?",
            "text_37": "What is IGP",
            "text_38": "Hundesportwesten, Trainingswesten und Hundeführerwesten",
            "text_39": "Eine Hundesportweste ist mehr als Bekleidung. Sie ist ein Trainingswerkzeug für Hundeplatz, Alltag und Wettkampf. Die Hundesportwesten und Hundeführerwesten von IQ Dogsport wurden für aktive Hundesportler, Hundetrainer, Hundeführer und K9-Teams entwickelt.",
            "text_40": "Im Mittelpunkt stehen Bewegungsfreiheit, robuste Materialien und ein durchdachtes Taschensystem für effizientes Hundetraining. Entwickelt von einem mehrfachen IGP-Weltmeister und unter realen Trainingsbedingungen getestet."
          }
        },
        "part3": {
          "type": "part3",
          "settings": {
            "text_41": "Hundesportwesten mit großer Rückentasche",
            "text_42": "Die große, durchgängige Rückentasche gehört zu den wichtigsten Merkmalen der IQ Hundesportwesten. Sie bietet Platz für Spielzeug, Leinen und Trainingszubehör und ermöglicht schnellen Zugriff während des Trainings.",
            "text_43": "Für Damen und Herren ist eine Weste mit Rückentasche besonders praktisch, wenn Ausrüstung sicher verstaut, aber trotzdem schnell erreichbar sein muss. In Unterordnung, Schutzdienst und täglichem Hundetraining sorgt die Rückentasche für klare Abläufe auf dem Hundeplatz.",
            "text_44": "Patentierte Trainingslösungen für präzises Timing",
            "text_45": "Die",
            "text_46": "IQ Hundesportweste 3.0",
            "text_47": "verfügt über patentierte Brusttaschen für eine mittige Bestätigung ohne sichtbare Körperhilfen. Ergänzt wird das System durch die IQ Magnettasche für verdeckte Bestätigung beim Fußlaufen sowie modulare Futtertaschen für flexibles Training.",
            "text_48": "Dadurch entsteht mehr als eine klassische Trainingsweste: Die IQ Hundesportweste ist ein modulares Trainingssystem für Hundeführer, Hundetrainer und ambitionierte Hundesportler.",
            "text_49": "Trainingswesten für IGP, Schutzdienst und Hundeausbildung",
            "text_50": "Ob IGP, Gebrauchshundesport, Schutzdienst oder professionelle Hundeausbildung – eine gute Trainingsweste muss Ausrüstung organisieren, Bewegungsfreiheit bieten und schnelle Bestätigung ermöglichen. Die IQ Hundesportwesten wurden entwickelt, um Training effizienter, präziser und reproduzierbarer zu machen.",
            "text_51": "Robuste Materialien, bartack-verstärkte Belastungspunkte und langlebige Reißverschlüsse sorgen dafür, dass die Westen auch bei regelmäßigem Einsatz auf dem Hundeplatz, bei Seminaren und im Wettkampf zuverlässig funktionieren.",
            "text_52": "Passend dazu:",
            "text_53": "Hundesportjacken",
            "text_54": "und",
            "text_55": "Trainingshosen",
            "text_56": "Ergänzend findest du",
            "text_57": "passendes Bekleidungszubehör",
            "text_58": "wie Futtertaschen, Magnettaschen und Loops für dein Training.",
            "text_59": "Wer wissen will, was IGP ist:",
            "text_60": "Was ist IGP"
          }
        }
      },
      "block_order": [
        "part1",
        "part2",
        "part3"
      ],
      "name": "SEO akkordeon",
      "settings": {
        "fit_advice_de": "<p><strong>Welche Hundesportweste passt Damen?</strong></p><p>Unsere Hundesportweste 3.0 und Sommerweste 3.0 sind Unisex-Modelle für Damen und Herren. Die Sommerweste fällt etwas kleiner aus als die reguläre Hundesportweste 3.0. Vergleiche deshalb die Größentabelle Deines Wunschmodells mit einer Weste, die Dir gut passt. Angegeben sind die Außenmaße der Weste, nicht Deine Körpermaße. Plane auch Platz für Kleidung darunter ein.</p><p><a href=\"/products/iq-hundesportweste-3-0-unisex\">Hundesportweste 3.0 – Modell und Größentabelle</a><br><a href=\"/products/iq-sommerweste-3-0-unisex\">Sommerweste 3.0 – Modell und Größentabelle</a></p>",
        "fit_advice_en": "<p><strong>Which dog training vest fits women?</strong></p><p>Our Dog Sport Vest 3.0 and Summer Vest 3.0 are unisex styles for women and men. The Summer Vest has a slightly smaller fit than the regular Dog Sport Vest 3.0. Compare your chosen model’s size chart with a vest that fits you well. The chart shows the garment’s outer measurements, not your body measurements. Allow room for the layers you plan to wear underneath.</p><p><a href=\"/en/products/dog-sport-vest-3-0-patented-pocket-system\">Dog Sport Vest 3.0 – model and size chart</a><br><a href=\"/en/products/dog-sport-summer-vest-3-0-patented-pockets\">Summer Vest 3.0 – model and size chart</a></p>"
      }
    }
