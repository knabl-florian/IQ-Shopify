<script>
(() => {
  const section = document.getElementById('iq-reservation-{{ section.id }}');
  if (!section || section.dataset.initialized === 'true') return;
  section.dataset.initialized = 'true';

  const configNode = document.getElementById('iq-reservation-config-{{ section.id }}');
  if (!configNode) return;
  const config = JSON.parse(configNode.textContent || '{}');
  const t = config.texts || {};

  const cards = Array.from(section.querySelectorAll('[data-product-card]'));
  const searchInput = section.querySelector('[data-product-search]');
  const loadMoreButton = section.querySelector('[data-load-more]');
  const loadMoreWrap = section.querySelector('[data-load-more-wrap]');
  const showingText = section.querySelector('[data-showing]');
  const emptySearch = section.querySelector('[data-empty-search]');
  const sticky = section.querySelector('[data-sticky]');
  const stickyCount = section.querySelector('[data-sticky-count]');
  const stickyPreview = section.querySelector('[data-sticky-preview]');
  const toolbarCount = section.querySelector('[data-toolbar-count]');
  const drawer = section.querySelector('[data-drawer]');
  const form = section.querySelector('#iq-reservation-form-{{ section.id }}');
  const itemsContainer = section.querySelector('[data-items]');
  const selectionEmpty = section.querySelector('[data-selection-empty]');
  const submitButton = section.querySelector('[data-submit]');
  const submitLabel = section.querySelector('[data-submit-label]');
  const submitLoader = section.querySelector('[data-submit-loader]');
  const message = section.querySelector('[data-message]');
  const successOverlay = section.querySelector('[data-success-overlay]');
  const successText = section.querySelector('[data-success-text]');
  const successItems = section.querySelector('[data-success-items]');
  const successClose = section.querySelector('[data-success-close]');

  const pageSize = Math.max(8, Number(config.pageSize) || 24);
  const maxItems = 10;
  let visibleLimit = pageSize;
  const selected = new Map();

  const normalizedQuery = () => (searchInput?.value || '').trim().toLowerCase();
  const matchingCards = () => {
    const query = normalizedQuery();
    return cards.filter(card => !query || (card.dataset.productTitle || '').includes(query));
  };

  function updateCatalog() {
    const matches = matchingCards();
    cards.forEach(card => { card.hidden = true; });
    matches.slice(0, visibleLimit).forEach(card => { card.hidden = false; });

    const shown = Math.min(visibleLimit, matches.length);
    if (showingText) showingText.textContent = `${t.showing} ${shown} ${t.of} ${matches.length} ${t.products}`;
    if (emptySearch) emptySearch.hidden = matches.length !== 0;
    if (loadMoreWrap) loadMoreWrap.hidden = matches.length === 0;
    if (loadMoreButton) loadMoreButton.hidden = shown >= matches.length;
  }

  function openDrawer() {
    drawer?.classList.add('is-open');
    drawer?.setAttribute('aria-hidden', 'false');
    document.body.classList.add('iq-reservation-drawer-open');
  }

  function closeDrawer() {
    drawer?.classList.remove('is-open');
    drawer?.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('iq-reservation-drawer-open');
  }

  function setSubmitting(active) {
    if (!submitButton) return;
    submitButton.disabled = active;
    if (submitLoader) submitLoader.hidden = !active;
    if (submitLabel) submitLabel.textContent = active ? t.sending : {{ tx_submit | json }};
  }

  function showSuccess(itemCount) {
    if (successText) successText.textContent = t.success;
    if (successItems) {
      successItems.textContent = config.locale === 'en'
        ? `${itemCount} ${itemCount === 1 ? 'item' : 'items'} reserved for Sunday collection.`
        : `${itemCount} ${itemCount === 1 ? 'Artikel wurde' : 'Artikel wurden'} für die Abholung am Sonntag reserviert.`;
    }
    if (successOverlay) successOverlay.hidden = false;
    document.body.classList.add('iq-reservation-drawer-open');
  }

  function hideSuccess() {
    if (successOverlay) successOverlay.hidden = true;
    document.body.classList.remove('iq-reservation-drawer-open');
  }

  function setFeedback(card, text, success = false) {
    const node = card.querySelector('[data-card-feedback]');
    if (!node) return;
    node.textContent = text;
    node.style.color = success ? '#087b2f' : '#e30613';
  }

  function updateSelection() {
    const values = Array.from(selected.values());
    if (selectionEmpty) selectionEmpty.hidden = values.length > 0;

    itemsContainer.querySelectorAll('[data-selected-row]').forEach(node => node.remove());
    values.forEach(item => {
      const row = document.createElement('div');
      row.className = 'iq-selected-item';
      row.dataset.selectedRow = item.variant_id;
      row.innerHTML = `
        <div>
          <strong>${escapeHtml(item.product_title)}</strong>
          <small>${escapeHtml(item.variant_title)}${item.sku ? ` · ${escapeHtml(item.sku)}` : ''}</small>
        </div>
        <input type="number" min="1" max="10" value="${item.quantity}" aria-label="${escapeHtml(t.item)}" data-selected-qty="${item.variant_id}">
        <button type="button" data-remove="${item.variant_id}">${escapeHtml(t.remove)}</button>
      `;
      itemsContainer.appendChild(row);
    });

    const totalQty = values.reduce((sum, item) => sum + Number(item.quantity || 0), 0);
    if (sticky) sticky.hidden = values.length === 0;
    if (stickyCount) stickyCount.textContent = `${totalQty} ${totalQty === 1 ? t.item : t.items}`;
    if (toolbarCount) toolbarCount.textContent = String(totalQty);
    if (stickyPreview) stickyPreview.textContent = values.map(item => `${item.product_title} (${item.variant_title})`).join(' · ');
  }

  function escapeHtml(value) {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');
  }

  cards.forEach(card => {
    const addButton = card.querySelector('[data-card-add]');
    addButton?.addEventListener('click', () => {
      const select = card.querySelector('[data-card-variant]');
      const qtyInput = card.querySelector('[data-card-quantity]');
      const option = select?.selectedOptions?.[0];
      if (!option || !option.value) {
        setFeedback(card, t.chooseVariant);
        select?.focus();
        return;
      }

      const variantId = String(option.value);
      const quantity = Math.min(10, Math.max(1, Number(qtyInput?.value) || 1));
      if (!selected.has(variantId) && selected.size >= maxItems) {
        setFeedback(card, t.maxError);
        return;
      }

      const existing = selected.get(variantId);
      selected.set(variantId, {
        product_id: String(option.dataset.productId || ''),
        variant_id: variantId,
        product_title: option.dataset.productTitle || '',
        variant_title: option.dataset.variantTitle || '',
        sku: option.dataset.sku || '',
        quantity: Math.min(10, (existing?.quantity || 0) + quantity)
      });
      setFeedback(card, t.added, true);
      updateSelection();
    });
  });

  itemsContainer?.addEventListener('input', event => {
    const input = event.target.closest('[data-selected-qty]');
    if (!input) return;
    const id = String(input.dataset.selectedQty);
    const item = selected.get(id);
    if (!item) return;
    item.quantity = Math.min(10, Math.max(1, Number(input.value) || 1));
    selected.set(id, item);
    updateSelection();
  });

  itemsContainer?.addEventListener('click', event => {
    const button = event.target.closest('[data-remove]');
    if (!button) return;
    selected.delete(String(button.dataset.remove));
    updateSelection();
  });

  searchInput?.addEventListener('input', () => {
    visibleLimit = pageSize;
    updateCatalog();
  });

  loadMoreButton?.addEventListener('click', () => {
    visibleLimit += pageSize;
    updateCatalog();
  });

  section.querySelectorAll('[data-open-drawer]').forEach(button => button.addEventListener('click', openDrawer));
  section.querySelectorAll('[data-close-drawer]').forEach(button => button.addEventListener('click', closeDrawer));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') {
      closeDrawer();
      hideSuccess();
    }
  });
  successClose?.addEventListener('click', hideSuccess);
  successOverlay?.addEventListener('click', event => {
    if (event.target === successOverlay) hideSuccess();
  });

  form?.addEventListener('submit', async event => {
    event.preventDefault();
    message.textContent = '';
    message.className = 'iq-reservation__message';

    if (selected.size === 0) {
      message.textContent = t.emptyError;
      message.classList.add('is-error');
      return;
    }
    if (!form.checkValidity()) {
      form.reportValidity();
      message.textContent = t.requiredError;
      message.classList.add('is-error');
      return;
    }
    if (!config.endpoint) {
      message.textContent = t.endpointError;
      message.classList.add('is-error');
      return;
    }
    if (config.deadlineIso && new Date() > new Date(config.deadlineIso)) {
      message.textContent = t.deadlineError;
      message.classList.add('is-error');
      return;
    }

    const formData = new FormData(form);
    const reservedItemCount = Array.from(selected.values()).reduce(
      (sum, item) => sum + Number(item.quantity || 0),
      0
    );

    const payload = {
      event_name: config.eventName || 'VDH DM Petersaurach 2026',
      first_name: String(formData.get('first_name') || '').trim(),
      last_name: String(formData.get('last_name') || '').trim(),
      email: String(formData.get('email') || '').trim(),
      phone: String(formData.get('phone') || '').trim(),
      note: String(formData.get('note') || '').trim(),
      website: String(formData.get('website') || ''),
      consent: Boolean(form.querySelector('[name="consent"]')?.checked),
      page_url: window.location.href,
      items: Array.from(selected.values())
    };

    setSubmitting(true);

    try {
      await fetch(config.endpoint, {
        method: 'POST',
        mode: 'no-cors',
        headers: {
          'Content-Type': 'text/plain;charset=utf-8'
        },
        body: JSON.stringify(payload),
        keepalive: true
      });

      selected.clear();
      form.reset();
      updateSelection();
      closeDrawer();
      showSuccess(reservedItemCount);
    } catch (error) {
      console.error('Reservation submission failed:', error);
      message.textContent = t.sendError;
      message.classList.add('is-error');
    } finally {
      setSubmitting(false);
    }
  });

  updateCatalog();
  updateSelection();
})();
</script>

