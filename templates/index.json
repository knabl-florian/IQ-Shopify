    "custom_liquid_7HrBhV": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "Jacken Collections",
      "settings": {
        "custom_liquid": "{%- comment -%}\n==================================================================\nIQ Startseite – Jackenbereich v6 · Mobile First\n\nTypografie:\n- Montserrat: Headline, Produktname, Feature-Titel\n- Archivo: Body, Preis, Bewertung, Feature-Subline, CTA\n- Mobile Feature-Subline 11.5px\n- v6-Layout unveraendert; einzige Aenderung ggue. der Vorlage:\n  CTA nicht mehr als Pills, sondern als unterstrichene Text-Links,\n  per space-between nach links/rechts an die Blockkanten (Damen links, Unisex rechts).\n==================================================================\n{%- endcomment -%}\n\n{%- assign en = false -%}\n{%- if request.locale.iso_code == 'en' -%}\n  {%- assign en = true -%}\n{%- endif -%}\n\n<style>\n  .iqjack {\n    background: rgb(var(--color-background));\n    color: rgb(var(--color-foreground));\n    font-family: Archivo, Arial, sans-serif;\n    border-radius: 0 !important;\n    box-shadow: none !important;\n  }\n\n  /* =========================================================\n     SECTION INTRO\n     ========================================================= */\n\n  .iqjack__head {\n    padding: 18px 20px 0;\n    box-sizing: border-box;\n  }\n\n  .iqjack__eyebrow {\n    margin: 0;\n    font-family: Archivo, Arial, sans-serif;\n    font-size: 11px;\n    line-height: 1.2;\n    letter-spacing: 3px;\n    text-transform: uppercase;\n    font-weight: 700;\n    color: rgba(var(--color-foreground), .58);\n  }\n\n  .iqjack__heading {\n    margin: 8px 0 0;\n    font-family: Montserrat, Arial, sans-serif;\n    font-style: italic;\n    font-weight: 800;\n    text-transform: uppercase;\n    font-size: clamp(30px, 8vw, 54px);\n    line-height: .98;\n    letter-spacing: -.4px;\n  }\n\n  .iqjack__heading-red {\n    color: #A51D1B;\n  }\n\n  .iqjack__intro {\n    margin: 14px 0 0;\n    max-width: 620px;\n    font-family: Archivo, Arial, sans-serif;\n    font-size: 16px;\n    line-height: 1.42;\n    font-weight: 400;\n    color: rgba(var(--color-foreground), .78);\n  }\n\n  .iqjack__products {\n    padding: 28px 0 58px;\n  }\n\n  /* =========================================================\n     PRODUCT\n     ========================================================= */\n\n  .iqjack__product {\n    display: flex;\n    flex-direction: column;\n    background: transparent;\n    border: 0;\n    border-radius: 0 !important;\n    box-shadow: none !important;\n  }\n\n  .iqjack__product--mfj {\n    order: 1;\n  }\n\n  .iqjack__product--tj {\n    order: 2;\n  }\n\n  .iqjack__product + .iqjack__product {\n    margin-top: 58px;\n  }\n\n  /* =========================================================\n     FULL-BLEED 4:5 IMAGE\n     ========================================================= */\n\n  .iqjack__media {\n    position: relative;\n    width: 100%;\n    aspect-ratio: 4 / 5;\n    overflow: hidden;\n    background: #111;\n    border-radius: 0 !important;\n  }\n\n  .iqjack__media img {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    display: block;\n    object-fit: cover;\n    border-radius: 0 !important;\n  }\n\n  .iqjack__product--mfj .iqjack__media img {\n    object-position: 50% 50%;\n  }\n\n  .iqjack__product--tj .iqjack__media img {\n    object-position: 50% 50%;\n  }\n\n  .iqjack__scrim {\n    position: absolute;\n    inset: 0;\n    pointer-events: none;\n    background:\n      linear-gradient(\n        to top,\n        rgba(0,0,0,.72) 0%,\n        rgba(0,0,0,.42) 24%,\n        rgba(0,0,0,.10) 44%,\n        rgba(0,0,0,0) 58%\n      );\n  }\n\n  /* =========================================================\n     PRODUCT INFO ON IMAGE\n     ========================================================= */\n\n  .iqjack__overlay {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 0;\n    padding: 18px 20px 18px;\n    color: #fff;\n    text-shadow: 0 1px 3px rgba(0,0,0,.55);\n  }\n\n  .iqjack__product-kicker {\n    margin: 0;\n    font-family: Archivo, Arial, sans-serif;\n    font-size: 11px;\n    line-height: 1.2;\n    letter-spacing: 2.7px;\n    text-transform: uppercase;\n    font-weight: 700;\n    color: rgba(255,255,255,.88);\n  }\n\n  .iqjack__product-name {\n    margin: 5px 0 5px;\n    font-family: Montserrat, Arial, sans-serif;\n    font-style: italic;\n    font-weight: 800;\n    text-transform: uppercase;\n    font-size: clamp(22px, 6vw, 30px);\n    line-height: 1.02;\n    overflow-wrap: anywhere;\n  }\n\n  .iqjack__meta {\n    display: flex;\n    align-items: center;\n    flex-wrap: wrap;\n    gap: 5px;\n    font-family: Archivo, Arial, sans-serif;\n    font-size: 13.5px;\n    line-height: 1.3;\n    font-weight: 400;\n  }\n\n  .iqjack__price {\n    font-weight: 700;\n  }\n\n  .iqjack__stars {\n    color: #FFB400;\n    letter-spacing: .7px;\n  }\n\n  /* =========================================================\n     FEATURE BAND\n     ========================================================= */\n\n  .iqjack__content {\n    padding: 22px 20px 0;\n    background: transparent;\n    border: 0;\n    border-radius: 0 !important;\n    box-shadow: none !important;\n  }\n\n  .iqjack__features {\n    display: grid;\n    grid-template-columns: repeat(3, minmax(0,1fr));\n    gap: 0;\n    align-items: start;\n  }\n\n  .iqjack__feature {\n    min-width: 0;\n    padding: 0 10px;\n    text-align: left;\n  }\n\n  .iqjack__feature:first-child {\n    padding-left: 0;\n  }\n\n  .iqjack__feature:last-child {\n    padding-right: 0;\n  }\n\n  .iqjack__feature + .iqjack__feature {\n    border-left: 1px solid rgba(var(--color-foreground), .14);\n  }\n\n  .iqjack__icon {\n    width: 26px;\n    height: 26px;\n    display: block;\n    margin: 0 0 7px;\n    color: rgb(var(--color-foreground));\n  }\n\n  .iqjack__feature-title {\n    font-family: Montserrat, Arial, sans-serif;\n    font-size: 11px;\n    line-height: 1.18;\n    font-weight: 800;\n    text-transform: uppercase;\n    letter-spacing: .2px;\n    overflow-wrap: anywhere;\n  }\n\n  .iqjack__feature-sub {\n    margin-top: 4px;\n    font-family: Archivo, Arial, sans-serif;\n    font-size: 11.5px;\n    line-height: 1.3;\n    font-weight: 400;\n    text-transform: none;\n    color: rgba(var(--color-foreground), .66);\n  }\n\n  /* =========================================================\n     SHORT BENEFIT COPY\n     ========================================================= */\n\n  .iqjack__benefit-copy {\n    margin: 20px 0 0;\n    font-family: Archivo, Arial, sans-serif;\n    font-size: 15px;\n    line-height: 1.45;\n    font-weight: 400;\n    color: rgba(var(--color-foreground), .78);\n  }\n\n  /* =========================================================\n     CTA – unterstrichene Text-Links, links/rechts an den Blockkanten\n     ========================================================= */\n\n  .iqjack__cta {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    flex-wrap: wrap;\n    padding-top: 22px;\n  }\n\n  .iqjack__cta-label {\n    font-family: Archivo, Arial, sans-serif;\n    font-size: 11px;\n    font-weight: 700;\n    letter-spacing: 2px;\n    text-transform: uppercase;\n    color: rgba(var(--color-foreground), .5);\n  }\n\n  .iqjack__choice {\n    font-family: Archivo, Arial, sans-serif;\n    font-weight: 700;\n    font-size: 14px;\n    letter-spacing: .5px;\n    text-transform: uppercase;\n    color: rgb(var(--color-foreground));\n    text-decoration: none;\n    border-bottom: 2px solid transparent;\n    padding-bottom: 2px;\n    transition: color .2s ease, border-color .2s ease;\n  }\n\n  .iqjack__choice:hover {\n    color: #A51D1B;\n    border-color: #A51D1B;\n  }\n\n  .iqjack__choice:focus-visible {\n    outline: 3px solid #A51D1B;\n    outline-offset: 3px;\n  }\n\n  .iqjack__sep {\n    color: rgba(var(--color-foreground), .3);\n  }\n\n  /* =========================================================\n     TABLET / DESKTOP\n     ========================================================= */\n\n  @media (min-width: 750px) {\n\n    .iqjack__head {\n      max-width: 1360px;\n      margin-inline: auto;\n      padding: 22px 32px 0;\n      box-sizing: border-box;\n    }\n\n    .iqjack__products {\n      max-width: 1360px;\n      margin-inline: auto;\n      padding: 32px 32px 56px;\n      box-sizing: border-box;\n\n      display: grid;\n      grid-template-columns: repeat(2, minmax(0,1fr));\n      gap: 28px;\n    }\n\n    .iqjack__product,\n    .iqjack__product--mfj,\n    .iqjack__product--tj {\n      order: 0;\n    }\n\n    .iqjack__product + .iqjack__product {\n      margin-top: 0;\n    }\n\n    .iqjack__media {\n      aspect-ratio: 4 / 5;\n    }\n\n    .iqjack__product--mfj .iqjack__media img {\n      object-position: 50% 48%;\n    }\n\n    .iqjack__product--tj .iqjack__media img {\n      object-position: 50% 47%;\n    }\n\n    .iqjack__content {\n      padding: 24px 0 0;\n    }\n\n    .iqjack__feature-title {\n      font-size: 12px;\n    }\n\n    .iqjack__feature-sub {\n      font-size: 12px;\n    }\n\n    .iqjack__benefit-copy {\n      font-size: 15.5px;\n    }\n  }\n\n  @media (min-width: 1100px) {\n\n    .iqjack__heading {\n      max-width: 900px;\n    }\n\n    .iqjack__product-name {\n      font-size: 30px;\n    }\n\n    .iqjack__feature {\n      padding-inline: 14px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .iqjack__choice {\n      transition: none;\n    }\n  }\n</style>\n\n\n<section class=\"iqjack color-scheme-2\">\n\n  <div class=\"iqjack__head\">\n\n    <p class=\"iqjack__eyebrow\">\n      {% if en %}\n        IQ Dog Sport Jackets\n      {% else %}\n        IQ Hundesportjacken\n      {% endif %}\n    </p>\n\n    <h2 class=\"iqjack__heading\">\n      {% if en %}\n        Built for training.\n        <span class=\"iqjack__heading-red\">In any weather.</span>\n      {% else %}\n        Gemacht fürs Training.\n        <span class=\"iqjack__heading-red\">Bei jedem Wetter.</span>\n      {% endif %}\n    </h2>\n\n    <p class=\"iqjack__intro\">\n      {% if en %}\n        Big dogs, wet fields, muddy paws. Your jacket has to keep up.\n      {% else %}\n        Große Hunde, nasse Wiesen, dreckige Pfoten. Deine Jacke muss mitmachen.\n      {% endif %}\n    </p>\n\n  </div>\n\n  <div class=\"iqjack__products\">\n\n    <!-- =====================================================\n         MULTIFUNKTIONSJACKE 3.0\n         ===================================================== -->\n\n    <article class=\"iqjack__product iqjack__product--mfj\">\n\n      <div class=\"iqjack__media\">\n\n        {%- assign foto_mfj =\n          'mfjblauunisex_13770bc4-ac49-44b7-b88a-c6dffb3454e9.jpg'\n        -%}\n\n        <img\n          src=\"{{ foto_mfj | file_url }}&width=1200\"\n          width=\"1200\"\n          height=\"1500\"\n          loading=\"lazy\"\n          alt=\"{% if en %}Man with Malinois wearing IQ Multifunction Jacket 3.0{% else %}Mann mit Malinois in IQ Multifunktionsjacke 3.0{% endif %}\"\n        >\n\n        <div class=\"iqjack__scrim\" aria-hidden=\"true\"></div>\n\n        <div class=\"iqjack__overlay\">\n\n          <p class=\"iqjack__product-kicker\">\n            {% if en %}\n              The original since 2011\n            {% else %}\n              Das Original seit 2011\n            {% endif %}\n          </p>\n\n          <div class=\"iqjack__product-name\">\n            {% if en %}\n              Multifunction Jacket 3.0\n            {% else %}\n              Multifunktionsjacke 3.0\n            {% endif %}\n          </div>\n\n          <div class=\"iqjack__meta\">\n\n            <span class=\"iqjack__price\">\n              279,90 €\n            </span>\n\n            <span>·</span>\n\n            <span class=\"iqjack__stars\" aria-label=\"4,9 von 5 Sternen\">\n              ★★★★★\n            </span>\n\n            <span>4,9</span>\n\n            <span>·</span>\n\n            <span>\n              {% if en %}\n                300+\n              {% else %}\n                über 300\n              {% endif %}\n            </span>\n\n          </div>\n\n        </div>\n\n      </div>\n\n      <div class=\"iqjack__content\">\n\n        <div class=\"iqjack__features\">\n\n          <div class=\"iqjack__feature\">\n\n            <svg\n              class=\"iqjack__icon\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.6\"\n              aria-hidden=\"true\">\n              <path d=\"M12 2.8S6 9.1 6 14a6 6 0 0 0 12 0c0-4.9-6-11.2-6-11.2Z\"/>\n            </svg>\n\n            <div class=\"iqjack__feature-title\">\n              20.000 mm\n            </div>\n\n            <div class=\"iqjack__feature-sub\">\n              {% if en %}\n                Water column\n              {% else %}\n                Wassersäule\n              {% endif %}\n            </div>\n\n          </div>\n\n          <div class=\"iqjack__feature\">\n\n            <svg\n              class=\"iqjack__icon\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.6\"\n              aria-hidden=\"true\">\n              <path d=\"M3 8h10c2.3 0 3.5-1.2 3.5-3 0-1.5-1-2.5-2.4-2.5-1.1 0-2 .6-2.4 1.5\"/>\n              <path d=\"M3 12h15c2 0 3 1.1 3 2.7 0 1.7-1.2 2.8-2.8 2.8-1.3 0-2.2-.6-2.6-1.6\"/>\n              <path d=\"M3 16h7\"/>\n            </svg>\n\n            <div class=\"iqjack__feature-title\">\n              {% if en %}\n                Windproof\n              {% else %}\n                Winddicht\n              {% endif %}\n            </div>\n\n            <div class=\"iqjack__feature-sub\">\n              {% if en %}\n                In bad weather\n              {% else %}\n                Bei jedem Wetter\n              {% endif %}\n            </div>\n\n          </div>\n\n          <div class=\"iqjack__feature\">\n\n            <svg\n              class=\"iqjack__icon\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.6\"\n              aria-hidden=\"true\">\n              <path d=\"M6 7h12l1 13H5L6 7Z\"/>\n              <path d=\"M9 7V5a3 3 0 0 1 6 0v2\"/>\n              <path d=\"M9 12h6\"/>\n            </svg>\n\n            <div class=\"iqjack__feature-title\">\n              {% if en %}\n                Lots of storage\n              {% else %}\n                Viel Stauraum\n              {% endif %}\n            </div>\n\n            <div class=\"iqjack__feature-sub\">\n              {% if en %}\n                For training\n              {% else %}\n                Fürs Training\n              {% endif %}\n            </div>\n\n          </div>\n\n        </div>\n\n        <p class=\"iqjack__benefit-copy\">\n          {% if en %}\n            Warm-lined and made for training in bad weather.\n          {% else %}\n            Warm gefüttert. Gemacht für Training bei schlechtem Wetter.\n          {% endif %}\n        </p>\n\n        <div class=\"iqjack__cta\">\n\n          <span class=\"iqjack__cta-label\">{% if en %}Fit{% else %}Schnitt{% endif %}</span>\n\n          {%- assign mfj_blue_damen = all_products['iq-multifunktionsjacke-3-0-damen-blau-limited-edition'] -%}\n          {%- assign mfj_blue_unisex = all_products['iq-multifunktionsjacke-3-0-unisex-blau-limited-edition'] -%}\n          {%- if en -%}\n            <a class=\"iqjack__choice\" href=\"{{ mfj_blue_damen.url }}\">Women</a>\n            <span class=\"iqjack__sep\" aria-hidden=\"true\">·</span>\n            <a class=\"iqjack__choice\" href=\"{{ mfj_blue_unisex.url }}\">Unisex</a>\n          {%- else -%}\n            <a class=\"iqjack__choice\" href=\"{{ mfj_blue_damen.url }}\">Damen</a>\n            <span class=\"iqjack__sep\" aria-hidden=\"true\">·</span>\n            <a class=\"iqjack__choice\" href=\"{{ mfj_blue_unisex.url }}\">Unisex</a>\n          {%- endif -%}\n\n        </div>\n\n      </div>\n\n    </article>\n\n\n    <!-- =====================================================\n         TRAININGSJACKE 2.0\n         ===================================================== -->\n\n    <article class=\"iqjack__product iqjack__product--tj\">\n\n      <div class=\"iqjack__media\">\n\n        {%- assign foto_tj =\n          'Frau-mit-schaeferhund-mit-hundesport-jacke-im-training_8da9a273-dc28-41cb-9f8f-80305f27c8fc.jpg'\n        -%}\n\n        <img\n          src=\"{{ foto_tj | file_url }}&width=1200\"\n          width=\"1200\"\n          height=\"1500\"\n          loading=\"lazy\"\n          alt=\"{% if en %}Woman with shepherd wearing IQ Training Jacket 2.0{% else %}Frau mit Schäferhund in IQ Trainingsjacke 2.0{% endif %}\"\n        >\n\n        <div class=\"iqjack__scrim\" aria-hidden=\"true\"></div>\n\n        <div class=\"iqjack__overlay\">\n\n          <p class=\"iqjack__product-kicker\">\n            {% if en %}\n              The full training system\n            {% else %}\n              Das volle Trainingssystem\n            {% endif %}\n          </p>\n\n          <div class=\"iqjack__product-name\">\n            {% if en %}\n              Training Jacket 2.0\n            {% else %}\n              Trainingsjacke 2.0\n            {% endif %}\n          </div>\n\n          <div class=\"iqjack__meta\">\n\n            <span class=\"iqjack__price\">\n              269,00 €\n            </span>\n\n            <span>·</span>\n\n            <span class=\"iqjack__stars\" aria-label=\"4,9 von 5 Sternen\">\n              ★★★★★\n            </span>\n\n            <span>4,9</span>\n\n            <span>·</span>\n\n            <span>\n              {% if en %}\n                70+\n              {% else %}\n                über 70\n              {% endif %}\n            </span>\n\n          </div>\n\n        </div>\n\n      </div>\n\n      <div class=\"iqjack__content\">\n\n        <div class=\"iqjack__features\">\n\n          <div class=\"iqjack__feature\">\n\n            <svg\n              class=\"iqjack__icon\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.6\"\n              aria-hidden=\"true\">\n              <path d=\"M7 3h7v5h5v12H5V3h2Z\"/>\n              <path d=\"M7 8h7V3\"/>\n              <path d=\"M10 12h5\"/>\n              <path d=\"M12.5 9.5V15\"/>\n            </svg>\n\n            <div class=\"iqjack__feature-title\">\n              {% if en %}\n                Chest pocket\n              {% else %}\n                Brusttasche\n              {% endif %}\n            </div>\n\n            <div class=\"iqjack__feature-sub\">\n              {% if en %}\n                Fast reward\n              {% else %}\n                Schnelle Bestätigung\n              {% endif %}\n            </div>\n\n          </div>\n\n          <div class=\"iqjack__feature\">\n\n            <svg\n              class=\"iqjack__icon\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.6\"\n              aria-hidden=\"true\">\n              <circle cx=\"12\" cy=\"12\" r=\"8\"/>\n              <circle cx=\"12\" cy=\"12\" r=\"3\"/>\n              <path d=\"M12 4v5M20 12h-5M12 20v-5M4 12h5\"/>\n            </svg>\n\n            <div class=\"iqjack__feature-title\">\n              Hidden Reward\n            </div>\n\n            <div class=\"iqjack__feature-sub\">\n              {% if en %}\n                Ball-pouch compatible\n              {% else %}\n                Balltaschen-kompatibel\n              {% endif %}\n            </div>\n\n          </div>\n\n          <div class=\"iqjack__feature\">\n\n            <svg\n              class=\"iqjack__icon\"\n              viewBox=\"0 0 24 24\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"1.6\"\n              aria-hidden=\"true\">\n              <path d=\"m12 3 8 4-8 4-8-4 8-4Z\"/>\n              <path d=\"m4 11 8 4 8-4\"/>\n              <path d=\"m4 15 8 4 8-4\"/>\n            </svg>\n\n            <div class=\"iqjack__feature-title\">\n              {% if en %}\n                Vest features\n              {% else %}\n                Westen-Funktionen\n              {% endif %}\n            </div>\n\n            <div class=\"iqjack__feature-sub\">\n              {% if en %}\n                In one jacket\n              {% else %}\n                In einer Jacke\n              {% endif %}\n            </div>\n\n          </div>\n\n        </div>\n\n        <p class=\"iqjack__benefit-copy\">\n          {% if en %}\n            For fast rewarding and precise work during training.\n          {% else %}\n            Für schnelle Bestätigung und präzises Arbeiten im Training.\n          {% endif %}\n        </p>\n\n        <div class=\"iqjack__cta\">\n\n          <span class=\"iqjack__cta-label\">{% if en %}Fit{% else %}Schnitt{% endif %}</span>\n\n          {%- if en -%}\n            <a class=\"iqjack__choice\" href=\"/en/products/dog-sport-training-jacket-2-0-women-patented-pockets\">Women</a>\n            <span class=\"iqjack__sep\" aria-hidden=\"true\">·</span>\n            <a class=\"iqjack__choice\" href=\"/en/products/dog-sport-training-jacket-2-0-patented-pockets\">Unisex</a>\n          {%- else -%}\n            <a class=\"iqjack__choice\" href=\"/products/iq-trainingsjacke-2-0-damen\">Damen</a>\n            <span class=\"iqjack__sep\" aria-hidden=\"true\">·</span>\n            <a class=\"iqjack__choice\" href=\"/products/iq-trainingsjacke-2-0-unisex\">Unisex</a>\n          {%- endif -%}\n\n        </div>\n\n      </div>\n\n    </article>\n\n  </div>\n\n</section>",
        "color_scheme": "scheme-2",
