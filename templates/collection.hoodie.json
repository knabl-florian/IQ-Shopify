        "inline_custom_liquid_V9rLVc": {
          "type": "inline_custom_liquid",
          "disabled": true,
          "settings": {
            "position": 6,
            "position_mobile": 5,
            "width": "full",
            "custom_liquid": "<style>\n  .iq-hood{background:#FFFFFF;border:1px solid #DCDBD7;display:grid;\n           grid-template-columns:minmax(0,44%) 1fr;align-items:center;}\n  .iq-hood__frame{aspect-ratio:1/1;overflow:hidden;background:#E4E3DF;height:100%;}\n  .iq-hood__img{display:block;width:100%;height:100%;object-fit:cover;}\n  .iq-hood__body{padding:clamp(22px,3vw,40px);}\n  .iq-hood__k{margin:0 0 6px;font-size:12px;font-weight:700;letter-spacing:.2em;\n              text-transform:uppercase;color:#A51D1B;}\n  .iq-hood__h{margin:0 0 18px;font-size:clamp(19px,2vw,26px);line-height:1.2;\n              font-weight:700;text-transform:uppercase;color:#171717;}\n  .iq-hood__row{display:flex;gap:12px;align-items:flex-start;margin:0 0 14px;}\n  .iq-hood__row:last-child{margin-bottom:0;}\n  .iq-hood__row svg{width:24px;height:24px;color:#A51D1B;flex:0 0 auto;margin-top:1px;}\n  .iq-hood__t{margin:0;font-size:15px;font-weight:700;line-height:1.3;color:#171717;}\n  .iq-hood__s{margin:2px 0 0;font-size:13.5px;line-height:1.5;color:#171717;opacity:.65;}\n\n  @media (max-width:749px){\n    .iq-hood{grid-template-columns:1fr;}\n    .iq-hood__frame{height:auto;}\n    .iq-hood__body{padding:18px 16px 20px;}\n    .iq-hood__row{margin-bottom:12px;}\n  }\n</style>\n\n<div class=\"iq-hood\">\n\n  <div class=\"iq-hood__frame\">\n    {%- if request.locale.iso_code == 'en' -%}\n    <img class=\"iq-hood__img\" src=\"{{ 'Train-hard-hoodie-olive-Mann-mit-malinois.jpg' | file_url }}&width=800\"\n         srcset=\"{{ 'Train-hard-hoodie-olive-Mann-mit-malinois.jpg' | file_url }}&width=500 500w, {{ 'Train-hard-hoodie-olive-Mann-mit-malinois.jpg' | file_url }}&width=800 800w\"\n         sizes=\"(max-width: 749px) 100vw, 44vw\"\n         alt=\"Handler in an IQ training hoodie rewarding his Malinois on the training field\"\n         width=\"800\" height=\"800\" loading=\"lazy\" decoding=\"async\">\n    {%- else -%}\n    <img class=\"iq-hood__img\" src=\"{{ 'Train-hard-hoodie-olive-Mann-mit-malinois.jpg' | file_url }}&width=800\"\n         srcset=\"{{ 'Train-hard-hoodie-olive-Mann-mit-malinois.jpg' | file_url }}&width=500 500w, {{ 'Train-hard-hoodie-olive-Mann-mit-malinois.jpg' | file_url }}&width=800 800w\"\n         sizes=\"(max-width: 749px) 100vw, 44vw\"\n         alt=\"Hundef&uuml;hrer im IQ Trainingshoodie belohnt seinen Malinois auf dem Hundeplatz\"\n         width=\"800\" height=\"800\" loading=\"lazy\" decoding=\"async\">\n    {%- endif -%}\n  </div>\n\n  <div class=\"iq-hood__body\">\n\n{%- if request.locale.iso_code == 'en' -%}\n    <p class=\"iq-hood__k\">Training gear, not merch</p>\n    <p class=\"iq-hood__h\">IQ Hoodie and IQ Zip Hoodie: both built for training</p>\n\n    <div class=\"iq-hood__row\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"5\" y=\"7\" width=\"14\" height=\"13\" rx=\"2\"/><path d=\"M9 7V5a3 3 0 0 1 6 0v2M8 12h8\"/></svg>\n      <div>\n        <p class=\"iq-hood__t\">Large back pocket</p>\n        <p class=\"iq-hood__s\">Space for leash, ball or tug &ndash; hands stay free.</p>\n      </div>\n    </div>\n\n    <div class=\"iq-hood__row\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 9h12l-1.2 10a2 2 0 0 1-2 1.8H9.2a2 2 0 0 1-2-1.8z\"/><path d=\"M9 9V7a3 3 0 0 1 6 0v2\"/></svg>\n      <div>\n        <p class=\"iq-hood__t\">Hidden treat pockets</p>\n        <p class=\"iq-hood__s\">Wipeable &ndash; no grease, no crumbs in your hoodie.</p>\n      </div>\n    </div>\n\n    <div class=\"iq-hood__row\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 15 15 9M8.5 12.5 6 15a3.5 3.5 0 0 0 5 5l2.5-2.5M15.5 11.5 18 9a3.5 3.5 0 0 0-5-5l-2.5 2.5\"/></svg>\n      <div>\n        <p class=\"iq-hood__t\">Loops for the IQ Modular Treat Pouch</p>\n        <p class=\"iq-hood__s\">One pouch, works across hoodie, vest, jacket and belt.</p>\n      </div>\n    </div>\n\n{%- else -%}\n    <p class=\"iq-hood__k\">Trainingsteil, kein Merch</p>\n    <p class=\"iq-hood__h\">IQ Hoodie und IQ Zip Hoodie: beide f&uuml;rs Training gebaut</p>\n\n    <div class=\"iq-hood__row\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"5\" y=\"7\" width=\"14\" height=\"13\" rx=\"2\"/><path d=\"M9 7V5a3 3 0 0 1 6 0v2M8 12h8\"/></svg>\n      <div>\n        <p class=\"iq-hood__t\">Gro&szlig;e R&uuml;ckentasche</p>\n        <p class=\"iq-hood__s\">Platz f&uuml;r Leine, Ball oder Bei&szlig;wurst &ndash; die H&auml;nde bleiben frei.</p>\n      </div>\n    </div>\n\n    <div class=\"iq-hood__row\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M6 9h12l-1.2 10a2 2 0 0 1-2 1.8H9.2a2 2 0 0 1-2-1.8z\"/><path d=\"M9 9V7a3 3 0 0 1 6 0v2\"/></svg>\n      <div>\n        <p class=\"iq-hood__t\">Versteckte Futtertaschen</p>\n        <p class=\"iq-hood__s\">Abwischbar &ndash; kein Fett, keine Kr&uuml;mel im Hoodie.</p>\n      </div>\n    </div>\n\n    <div class=\"iq-hood__row\">\n      <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 15 15 9M8.5 12.5 6 15a3.5 3.5 0 0 0 5 5l2.5-2.5M15.5 11.5 18 9a3.5 3.5 0 0 0-5-5l-2.5 2.5\"/></svg>\n      <div>\n        <p class=\"iq-hood__t\">Loops f&uuml;r die IQ Modulare Futtertasche</p>\n        <p class=\"iq-hood__s\">Eine Tasche &ndash; passt an Hoodie, Weste, Jacke und G&uuml;rtel.</p>\n      </div>\n    </div>\n\n{%- endif -%}\n\n  </div>\n</div>"
