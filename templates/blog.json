{ blog.url }}/tagged/sonstiges\" \n{% if current_tags contains 'Sonstiges' %}aria-current=\"page\"\n{% endif %}>\n{% assign iq_image = images[iq_file_08] %}\n\n{% if iq_image != blank %}\n<img src=\"{{ iq_image | image_url: width: 600 }}\" srcset=\"{{ iq_image | image_url: width: 300 }} 300w, {{ iq_image | image_url: width: 600 }} 600w\" sizes=\"(max-width:600px) 42vw, (max-width:1000px) 24vw, 210px\" width=\"{{ iq_image.width }}\" height=\"{{ iq_image.height }}\" loading=\"lazy\" decoding=\"async\" alt=\"\">\n\n{% elsif request.design_mode %}<small>Bild fehlt: {{ iq_file_08 | escape }}</small>\n{% endif %}<span>Sonstiges</span>\n</a>\n</nav>\n<div class=\"iq-arrows\" hidden aria-label=\"Kategorien verschieben\">\n<button type=\"button\" class=\"iq-arrow\" data-iq-prev aria-label=\"Kategorien nach links\" aria-controls=\"iq-category-rail\"><svg viewBox=\"0 0 30 20\" aria-hidden=\"true\"><path d=\"M29 10H2M10 2l-8 8 8 8\"/></svg></button>\n<button type=\"button\" class=\"iq-arrow\" data-iq-next aria-label=\"Kategorien nach rechts\" aria-controls=\"iq-category-rail\"><svg viewBox=\"0 0 30 20\" aria-hidden=\"true\"><path d=\"M1 10h27M20 2l8 8-8 8\"/></svg></button>\n</div>\n<div class=\"iq-filter-row\"><span class=\"iq-filter-label\" id=\"iq-filter-label\">Filter:</span><nav class=\"iq-pills\" aria-labelledby=\"iq-filter-label\">\n<a class=\"iq-pill\" href=\"{{ blog.url }}\" \n{% if current_tags == blank %}aria-current=\"page\"\n{% endif %}>Alle Artikel</a>\n<a class=\"iq-pill\" href=\"{{ blog.url }}/tagged/agility\" \n{% if current_tags contains 'Agility' %}aria-current=\"page\"\n{% endif %}>Agility</a>\n<a class=\"iq-pill\" href=\"{{ blog.url }}/tagged/igp\" \n{% if current_tags contains 'IGP' %}aria-current=\"page\"\n{% endif %}>IGP</a>\n<a class=\"iq-pill\" href=\"{{ blog.url }}/tagged/hundesport\" \n{% if current_tags contains 'Hundesport' %}aria-current=\"page\"\n{% endif %}>Hundesport</a>\n<a class=\"iq-pill\" href=\"{{ blog.url }}/tagged/produkte\" \n{% if current_tags contains 'Produkte' %}aria-current=\"page\"\n{% endif %}>Produkte</a>\n<a class=\"iq-pill\" href=\"{{ blog.url }}/tagged/wettkampf-interview-und-community\" \n{% if current_tags contains 'Wettkampf-Interview und Community' %}aria-current=\"page\"\n{% endif %}>Wettkampf-Interview und Community</a>\n<a class=\"iq-pill\" href=\"{{ blog.url }}/tagged/k9-und-diensthunde\" \n{% if current_tags contains 'K9 und Diensthunde' %}aria-current=\"page\"\n{% endif %}>K9 und Diensthunde</a>\n<a class=\"iq-pill\" href=\"{{ blog.url }}/tagged/gesundheit-und-pflege\" \n{% if current_tags contains 'Gesundheit und Pflege' %}aria-current=\"page\"\n{% endif %}>Gesundheit und Pflege</a>\n<a class=\"iq-pill\" href=\"{{ blog.url }}/tagged/sonstiges\" \n{% if current_tags contains 'Sonstiges' %}aria-current=\"page\"\n{% endif %}>Sonstiges</a>\n</nav></div>\n{% paginate blog.articles by 12 %}<div class=\"iq-results\">\n{% for article in blog.articles %}\n{% if forloop.first %}<h2 class=\"iq-section-title\" style=\"grid-column:1/-1;margin:20px 0 0\">\n{% if paginate.current_page == 1 %}Neuester Beitrag\n{% if current_tags != blank %} zum Thema\n{% endif %}\n{% else %}Weitere Beiträge\n{% endif %}</h2>\n{% elsif forloop.index == 2 and paginate.current_page == 1 %}<h2 class=\"iq-section-title\" style=\"grid-column:1/-1;margin:20px 0 0\" data-iq-further>Weitere Beiträge</h2>\n{% endif %}<article class=\"iq-card \n{% if forloop.first and paginate.current_page == 1 %}iq-feature\n{% endif %}\">\n<a class=\"iq-media\" href=\"{{ article.url }}\" aria-label=\"{{ article.title | escape }}\">\n{% if article.image %}<img src=\"{{ article.image | image_url: width: 1000 }}\" srcset=\"{{ article.image | image_url: width: 360 }} 360w, {{ article.image | image_url: width: 600 }} 600w, {{ article.image | image_url: width: 1000 }} 1000w\" sizes=\"\n{% if forloop.first and paginate.current_page == 1 %}(max-width:600px) 92vw, 600px\n{% else %}(max-width:600px) 92vw, (max-width:1000px) 46vw, 410px\n{% endif %}\" width=\"900\" height=\"600\" alt=\"{{ article.image.alt | escape }}\" \nloading=\"lazy\" decoding=\"async\">\n{% endif %}</a>\n<div class=\"iq-copy\">\n<p class=\"iq-date\">{{ article.published_at | date: '%d.%m.%Y' }}</p>\n<h3>\n<a href=\"{{ article.url }}\">{{ article.title | escape }}</a>\n</h3>\n<p class=\"iq-excerpt\">{{ article.excerpt_or_content | strip_html | truncate: 180 | escape }}</p>\n<a class=\"iq-more\" href=\"{{ article.url }}\">Weiterlesen<span class=\"iq-radio\">: {{ article.title | escape }}</span>\n</a>\n</div>\n</article>\n{% else %}<p class=\"iq-empty\">In dieser Kategorie sind noch keine Beiträge veröffentlicht.</p>\n{% endfor %}</div>\n<div class=\"iq-load-wrap\">\n{% if paginate.next %}<a class=\"iq-load\" data-iq-load href=\"{{ paginate.next.url }}\">Mehr laden</a>{% endif %}\n<p class=\"iq-load-status\" data-iq-status role=\"status\" aria-live=\"polite\" tabindex=\"-1\"></p>\n</div>\n{% endpaginate %}\n{% else %}<p>Bitte diesen Abschnitt in der Blog-Vorlage verwenden.</p>\n{% endif %}</section>\n<script>\n(function () {\n  function init(root) {\n    if (!root || root.dataset.iqReady === 'true') return;\n    root.dataset.iqReady = 'true';\n    const rail = root.querySelector('.iq-rail');\n    const controls = root.querySelector('.iq-arrows');\n    if (rail && controls) {\n      controls.hidden = false;\n      const left = controls.querySelector('[data-iq-prev]');\n      const right = controls.querySelector('[data-iq-next]');\n      const update = () => {\n        left.disabled = rail.scrollLeft <= 2;\n        right.disabled = rail.scrollLeft >= rail.scrollWidth - rail.clientWidth - 2;\n      };\n      const move = direction => rail.scrollBy({left: direction * Math.max(rail.clientWidth * .8, 150), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth'});\n      left.addEventListener('click', () => move(-1));\n      right.addEventListener('click', () => move(1));\n      rail.addEventListener('scroll', update, {passive: true});\n      if ('ResizeObserver' in window) {\n        const observer = new ResizeObserver(update);\n        observer.observe(rail);\n        root.addEventListener('iq:cleanup', () => observer.disconnect(), {once:true});\n      }\n      update();\n    }\n    initFilters(root);\n    initLoad(root);\n  }\n  function initLoad(root) {\n    const link = root.querySelector('[data-iq-load]');\n    const grid = root.querySelector('.iq-results');\n    const status = root.querySelector('[data-iq-status]');\n    if (!link || !grid || !status) return;\n    let busy = false;\n    link.addEventListener('click', async event => {\n      // Modified clicks retain normal link behavior.\n      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;\n      event.preventDefault();\n      if (busy || root.dataset.iqFetching === 'true') return;\n      root.dataset.iqFetching = 'true';\n      busy = true;\n      const controller = new AbortController();\n      const timer = setTimeout(() => controller.abort(), 15000);\n      link.setAttribute('aria-disabled', 'true');\n      grid.setAttribute('aria-busy', 'true');\n      link.textContent = 'Wird geladen …';\n      status.textContent = '';\n      try {\n        const url = new URL(link.href, location.href);\n        if (url.origin !== location.origin) throw new Error('origin');\n        // Keep the unpublished theme preview when following pagination.\n        for (const key of ['preview_theme_id', 'preview_key']) {\n          const value = new URL(location.href).searchParams.get(key);\n          if (value && !url.searchParams.has(key)) url.searchParams.set(key, value);\n        }\n        const response = await fetch(url.href, {credentials:'same-origin', signal:controller.signal});\n        if (!response.ok) throw new Error('http');\n        const doc = new DOMParser().parseFromString(await response.text(), 'text/html');\n        const incoming = doc.querySelector('#iq-blog .iq-results');\n        if (!incoming) throw new Error('missing');\n        const known = new Set([...grid.querySelectorAll('.iq-card .iq-media')].map(a => a.getAttribute('href')));\n        const cards = [...incoming.querySelectorAll('.iq-card')].filter(card => {\n          const href = card.querySelector('.iq-media')?.getAttribute('href');\n          if (!href || known.has(href)) return false;\n          known.add(href); return true;\n        });\n        if (!cards.length) throw new Error('empty');\n        const next = doc.querySelector('#iq-blog [data-iq-load]');\n        const nextURL = next ? new URL(next.getAttribute('href'), url) : null;\n        if (nextURL && (nextURL.origin !== location.origin || nextURL.href === url.href)) throw new Error('next');\n        const fragment = document.createDocumentFragment();\n        if (!grid.querySelector('[data-iq-further]') && grid.querySelector('.iq-feature')) {\n          const heading = document.createElement('h2');\n          heading.className = 'iq-section-title iq-further';\n          heading.dataset.iqFurther = '';\n          heading.textContent = 'Weitere Beiträge';\n          fragment.append(heading);\n        }\n        cards.forEach(card => {\n          card.classList.remove('iq-feature');\n          card.querySelectorAll('script').forEach(s => s.remove());\n          card.querySelectorAll('img').forEach(img => {img.loading = 'lazy'; img.removeAttribute('fetchpriority');});\n          fragment.append(card);\n        });\n        grid.append(fragment);\n        if (nextURL) {\n          link.href = nextURL.href;\n          link.textContent = 'Mehr laden';\n          status.textContent = cards.length + ' weitere Beiträge geladen.';\n        } else {\n          link.hidden = true;\n          status.textContent = 'Alle Beiträge geladen.';\n          status.focus({preventScroll:true});\n        }\n      } catch (error) {\n        link.textContent = 'Erneut versuchen';\n        status.textContent = 'Laden nicht möglich. Bitte erneut versuchen oder den Link in einem neuen Tab öffnen.';\n      } finally {\n        clearTimeout(timer);\n        busy = false;\n        root.dataset.iqFetching = 'false';\n        link.removeAttribute('aria-disabled');\n        grid.removeAttribute('aria-busy');\n      }\n    });\n  }\n  function initFilters(root) {\n    if (!root.querySelector('.iq-results')) return;\n    const notice = document.createElement('p');\n    notice.className = 'iq-sr'; notice.setAttribute('role', 'status');\n    root.querySelector('.iq-filter-row').append(notice);\n    async function filter(url, push) {\n      if (root.dataset.iqFetching === 'true') return;\n      root.dataset.iqFetching = 'true';\n      const controller = new AbortController();\n      const timer = setTimeout(() => controller.abort(), 15000);\n      const grid = root.querySelector('.iq-results');\n      grid.setAttribute('aria-busy', 'true'); notice.textContent = 'Beiträge werden geladen …';\n      try {\n        const target = new URL(url, location.href);\n        if (target.origin !== location.origin) throw new Error('origin');\n        for (const key of ['preview_theme_id','preview_key']) {\n          const val = new URL(location.href).searchParams.get(key);\n          if (val && !target.searchParams.has(key)) target.searchParams.set(key,val);\n        }\n        const response = await fetch(target.href, {credentials:'same-origin', signal:controller.signal});\n        if (!response.ok) throw new Error('http');\n        const doc = new DOMParser().parseFromString(await response.text(), 'text/html');\n        const incoming = doc.querySelector('#iq-blog');\n        const nextGrid = incoming?.querySelector('.iq-results');\n        const nextLoad = incoming?.querySelector('.iq-load-wrap');\n        if (!nextGrid || !nextLoad) throw new Error('missing');\n        nextGrid.querySelectorAll('script').forEach(el => el.remove());\n        nextLoad.querySelectorAll('script').forEach(el => el.remove());\n        nextGrid.querySelectorAll('img').forEach(img => {img.loading='lazy';img.removeAttribute('fetchpriority');});\n        // Keep header, category rail, filters and their horizontal scroll untouched.\n        const y = window.scrollY;\n        const x = window.scrollX;\n        const minHeight = Math.max(0, y + window.innerHeight - root.getBoundingClientRect().top - y);\n        root.style.minHeight = minHeight + 'px';\n        grid.replaceWith(nextGrid);\n        root.querySelector('.iq-load-wrap').replaceWith(nextLoad);\n        const active = new Set([...incoming.querySelectorAll('.iq-pill[aria-current],.iq-tile[aria-current]')].map(a => new URL(a.getAttribute('href'),target).pathname));\n        root.querySelectorAll('.iq-pill,.iq-tile').forEach(a => {\n          if (active.has(new URL(a.href).pathname)) a.setAttribute('aria-current','page');\n          else a.removeAttribute('aria-current');\n        });\n        if (push) history.pushState({iqBlog:true},'',target.href);\n        if (doc.title) document.title=doc.title;\n        window.scrollTo({top:y,left:x,behavior:'instant'});\n        initLoad(root);\n        notice.textContent = 'Filter angewendet. ' + nextGrid.querySelectorAll('.iq-card').length + ' Beiträge angezeigt.';\n      } catch (error) {\n        notice.className = 'iq-filter-error';\n        notice.textContent = 'Filter konnte nicht geladen werden. Bitte erneut klicken oder den Filter-Link in einem neuen Tab öffnen.';\n      } finally {\n        clearTimeout(timer); root.dataset.iqFetching = 'false';\n        root.querySelector('.iq-results')?.removeAttribute('aria-busy');\n      }\n    }\n    root.addEventListener('click', event => {\n      const a = event.target.closest('.iq-pill,.iq-tile');\n      if (!a || !root.contains(a) || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || event.button !== 0) return;\n      event.preventDefault(); notice.className='iq-sr'; filter(a.href,true);\n    });\n    const back = () => {\n      if (root.isConnected) filter(location.href,false);\n    };\n    window.addEventListener('popstate',back);\n    root.addEventListener('iq:cleanup',()=>window.removeEventListener('popstate',back),{once:true});\n  }\n\n  document.querySelectorAll('#iq-blog').forEach(init);\n  if (!window.iqBlogSectionEvents) {\n    window.iqBlogSectionEvents = true;\n    document.addEventListener('shopify:section:load', event => event.target.querySelectorAll('#iq-blog').forEach(init));\n    document.addEventListener('shopify:section:unload', event => event.target.querySelectorAll('#iq-blog').forEach(root => root.dispatchEvent(new Event('iq:cleanup'))));\n  }\n})();\n\n</script>",
