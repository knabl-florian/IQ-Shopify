    assign tx_row_waerme = 'Warmth'
    assign tx_row_feat = 'Top features'
    assign tx_row_price = 'Price'
    assign tx_zur = 'View jacket'
    assign tx_ideal_label = 'Ideal for:'
    assign tx_wetter_label = 'Weather protection:'
    assign tx_waerme_label = 'Warmth:'
    assign tx_feat_label = 'Top features:'
    assign tx_footer1 = 'MFJ 3.0, Training Jacket 2.0, Allround Jacket and MFJ K9 Pro are also available in a women’s fit.'
    assign tx_footer2_pre = 'With the '
    assign tx_footer2_post = ' the Training Jacket 2.0 becomes a winter jacket.'
  endif

  # Produkte aus dem product_list-Setting. Leer lassen = Standard (5 IQ Jacken).
  assign iq_jv_picked = ''
  for iq_jv_prod in section.settings.iq_jv_products
    if iq_jv_picked != blank
      assign iq_jv_picked = iq_jv_picked | append: ','
    endif
    assign iq_jv_picked = iq_jv_picked | append: iq_jv_prod.handle
  endfor
  assign iq_jv_default = 'iq-multifunktionsjacke-3-0-unisex,iq-trainingsjacke-2-0-unisex,iq-allround-jacke-unisex,iq-softshelljacke-2-0-unisex,iq-multifunktionsjacke-k9-pro-unisex-schwarz'
  assign iq_jv_handle_str = iq_jv_default
  if iq_jv_picked != blank
    assign iq_jv_handle_str = iq_jv_picked
  endif
-%}
    {%- comment -%} IQ Jacken-Vergleich – serverseitig gerendert, Bilder laden verzögert. {%- endcomment -%}
    {%- liquid
      assign handles = iq_jv_handle_str | split: ','
      assign card_count = 0
      assign cards_html = ''
      assign mobile_html = ''
      assign thead_html = ''
      assign row_wetter = ''
      assign row_waerme = ''
      assign row_features = ''
      assign row_price = ''
      assign is_first = true
    -%}
    {%- for handle in handles -%}
      {%- assign p = all_products[handle] -%}
      {%- unless p == empty -%}
        {%- liquid
          assign card_count = card_count | plus: 1
          # Nach fixem Eingabe-Handle matchen (nicht p.handle), damit es auch auf /en/ mit lokalisierten Handles greift
