              assign notfor = 'For agencies and professional duty. For regular dog sport: the standard MFJ 3.0.'
              assign link_label = 'View K9 Pro'
              assign w1 = '20,000 mm'
              assign w2 = 'windproof'
              assign w3 = 'sealed seams'
              assign heat_label = 'warmly lined'
              assign f1 = 'Patch areas'
              assign f2 = 'Bodycam loops'
              assign f3 = 'Holster access'
              assign ideal = 'Dog handlers and agencies.'
            endif
          elsif hh contains 'trainingsjacke'
            assign short_title = 'Trainingsjacke 2.0'
            assign use = 'Funktionen fürs Training'
            assign desc = 'Die Funktionen der Hundesportweste als Jacke: patentierte Brusttasche, optional mit IQ Balltasche und wärmendem Zip-In.'
            assign notfor = 'Ungefüttert, mit Zip-In wintertauglich.'
            assign link_label = 'Trainingsjacke ansehen'
            assign search_q = 'Trainingsjacke 2.0'
            assign w1 = '20.000 mm'
            assign w2 = 'winddicht'
            assign w3 = 'getapte Nähte'
            assign heat_dots = '●●○○'
            assign heat_label = 'ungefüttert · zusätzliche Wärme mit optionalem Zip-In'
            assign f1 = 'Patentierte Brusttasche'
            assign f2 = 'Kompatibel mit optionaler IQ Balltasche'
            assign f3 = 'Loops für die IQ modulare Futtertasche'
            assign ideal = 'Gezieltes Hundetraining mit den Funktionen der Hundesportweste.'
            if lang == 'en'
              # EN: offizielle Übersetzung (translationsRegister) hier eintragen
              assign short_title = 'Training Jacket 2.0'
              assign use = 'Built for training'
              assign search_q = 'Training Jacket 2.0'
              assign desc = 'Your training vest’s features in a jacket: a patented chest pocket, compatibility with the optional IQ ball pocket and a Zip-In for extra warmth.'
              assign notfor = 'Unlined; winter-ready with the Zip-In.'
              assign link_label = 'View Training Jacket'
