ball-feature,.iq-ball-feature *{box-sizing:border-box}\n.iq-ball-feature{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);align-items:center;background:#FFFFFF;border-radius:0;width:100%;color:#171717}\n.iq-ball-feature__photo{min-width:0}\n.iq-ball-feature__photo img{display:block;width:100%;height:auto;border-radius:0}\n.iq-ball-feature__copy{min-width:0;padding:36px clamp(24px,4vw,64px);font:400 15px/1.6 Archivo,sans-serif}\n.iq-ball-feature .iq-ball-feature__kicker{margin:0 0 14px;font:700 11px/1.5 Archivo,sans-serif;letter-spacing:.12em;color:#A51D1B}\n.iq-ball-feature h2{margin:0 0 22px;font-family:Montserrat,sans-serif;font-weight:800;font-style:italic;font-size:clamp(28px,3vw,46px);line-height:1.1;letter-spacing:-.035em;text-transform:uppercase;color:#171717;overflow-wrap:break-word}\n.iq-ball-feature__copy>p{margin:0 0 16px}\n.iq-ball-feature .iq-ball-feature__models{margin:0;border-top:1px solid #DCDBD7;padding-top:14px;font-size:12px;color:#171717}\n@media(max-width:749px){\n.iq-ball-feature{grid-template-columns:minmax(0,1fr)}\n.iq-ball-feature__copy{padding:25px 20px 28px;font-size:14px}\n.iq-ball-feature h2{font-size:clamp(26px,7vw,32px)}\n}\n.iq-ball-feature .iq-ball-feature__button{display:inline-flex;align-items:center;gap:12px;min-height:44px;color:#A51D1B;font:700 14px/1.5 Archivo,sans-serif;text-decoration:underline;text-underline-offset:5px;background:transparent;border:0;border-radius:0;padding:0;margin-top:8px}\n.iq-ball-feature__button:focus-visible{outline:2px solid #171717;outline-offset:4px}\n</style>"
