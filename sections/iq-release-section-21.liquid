{% assign iq_part_1 = section.blocks | where: 'type', 'part1' | first %}
{%- comment -%}
{{ iq_part_1.settings.text_1 | escape }}
{%- endcomment -%}

<style>
#shopify-section-{{ section.id }}{background:#FFFFFF;padding-block:0!important}
#shopify-section-{{ section.id }} .iq-trust-wrap{background:#FFFFFF;border-bottom:1px solid #DCDBD7}
#shopify-section-{{ section.id }} .iq-trust{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));max-width:1360px;margin:0 auto;padding:20px 32px;color:#171717;gap:0}
#shopify-section-{{ section.id }} .iq-trust__i{display:flex;align-items:center;justify-content:center;gap:10px;padding:0 16px;text-align:center;font:700 14px/1.35 Archivo,sans-serif}
#shopify-section-{{ section.id }} .iq-trust__i~.iq-trust__i{border-left:1px solid #DCDBD7}
#shopify-section-{{ section.id }} .iq-trust__i svg{width:22px;height:22px;flex:none;color:#A51D1B}
#shopify-section-{{ section.id }} .iq-trust__d{display:none}
@media(max-width:749px){
#shopify-section-{{ section.id }} .iq-trust{padding:16px 12px;max-width:100%}
#shopify-section-{{ section.id }} .iq-trust__i{flex-direction:column;padding:0 8px;gap:8px;font-size:12px;line-height:1.35;white-space:normal}
#shopify-section-{{ section.id }} .iq-trust__i svg{width:21px;height:21px}
}
</style>

<div class="iq-trust-wrap">
  <div class="iq-trust">
{%- if request.locale.iso_code == 'en' -%}
    <div class="iq-trust__i iq-trust__i--wm">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="M9 14.5 8 22l4-2.4 4 2.4-1-7.5"/></svg>
      <span>{{ iq_part_1.settings.text_2 | escape }}</span>
    </div>
    <span class="iq-trust__d iq-trust__d--wm"></span>
    <div class="iq-trust__i">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 2.5 15.4 0 18C9.5 18.4 9.5 5.6 12 3z"/></svg>
      <span>{{ iq_part_1.settings.text_3 | escape }}</span>
    </div>
    <span class="iq-trust__d"></span>
    <div class="iq-trust__i">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.6-5.9"/><path d="M20 4v4h-4"/></svg>
      <span>{{ iq_part_1.settings.text_4 | escape }}</span>
    </div>
{%- else -%}
    <div class="iq-trust__i iq-trust__i--wm">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="6"/><path d="M9 14.5 8 22l4-2.4 4 2.4-1-7.5"/></svg>
      <span>{{ iq_part_1.settings.text_5 | escape }}</span>
    </div>
    <span class="iq-trust__d iq-trust__d--wm"></span>
    <div class="iq-trust__i">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 7h11v9H2z"/><path d="M13 10h4.5l3 3.2V16H13z"/><circle cx="6.5" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
      <span>{{ iq_part_1.settings.text_6 | escape }}</span>
    </div>
    <span class="iq-trust__d"></span>
    <div class="iq-trust__i">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.6-5.9"/><path d="M20 4v4h-4"/></svg>
      <span>{{ iq_part_1.settings.text_7 | escape }}</span>
    </div>
{%- endif -%}
  </div>
</div>
