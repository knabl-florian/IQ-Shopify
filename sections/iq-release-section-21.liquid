{% assign iq_part_1 = section.blocks | where: 'type', 'part1' | first %}
{%- comment -%}
{{ iq_part_1.settings.text_1 | escape }}
{%- endcomment -%}

<style>
  /* ganze Section hell + ohne Eigen-Abstand (Höhe steuert die Bar selbst) */
  #shopify-section-{{ section.id }}{ background:#F3F3F1 !important; padding-top:0 !important; padding-bottom:0 !important; }

  .iq-trust-wrap{ border:0; background:#F3F3F1; }

  /* DESKTOP: Raster, drei Angaben je mittig im Drittel */
  .iq-trust{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;
            align-items:center;gap:0;color:#171717;
            max-width:1180px;margin:0 auto;padding:13px 24px;}
  .iq-trust__i{display:flex;align-items:center;justify-content:center;gap:8px;
               white-space:nowrap;flex:0 0 auto;
               font-size:13.5px;line-height:1;letter-spacing:.01em;font-weight:600;}
  .iq-trust__i svg{width:17px;height:17px;flex:0 0 auto;opacity:.55;}
  .iq-trust__i--star svg{opacity:1;color:#FFB400;fill:#FFB400;}
  .iq-trust__d{flex:0 0 auto;width:1px;height:16px;background:#DCDBD7;opacity:1;}

  /* MOBIL: eine Zeile, horizontal wischbar, kompakt ~52px */
  @media (max-width:749px){
    .iq-trust{display:flex;flex-wrap:nowrap;justify-content:flex-start;
              gap:14px;max-width:none;
              width:100vw;margin-left:50%;transform:translateX(-50%);
              padding:18px 16px;
              overflow-x:auto;-webkit-overflow-scrolling:touch;
              scrollbar-width:none;}
    .iq-trust::-webkit-scrollbar{display:none;}
    .iq-trust__i{font-size:12px;gap:5px;}
    .iq-trust__i svg{width:14px;height:14px;}
  }

  /* ==========================================================
     BEWERTUNGSZEILE IM HERO — gelbe Sterne unter dem Button
     (unverändert)
     ========================================================== */
  .section--slideshow .slideshow__text{display:flex;flex-direction:column;}
  .section--slideshow .slideshow__title{order:1;}
  .section--slideshow .slideshow__description{order:2;}
  .section--slideshow .slideshow__buttons{order:3;}
  .section--slideshow .slideshow__subtitle{order:4;margin:14px 0 0;
        font-size:15px;line-height:1.45;letter-spacing:0;text-transform:none;
        opacity:1;}
  .section--slideshow .slideshow__subtitle > *::before{
        content:"\2605\2605\2605\2605\2605\00A0";
        color:#FFB400;letter-spacing:1px;
        white-space:nowrap;}

  @media (max-width:749px){
    .section--slideshow .slideshow__subtitle{font-size:13px;margin-top:12px;}
    .section--slideshow .slideshow__content{align-items:flex-start !important;}
    .section--slideshow .slideshow__text{text-align:left !important;
          margin-left:0 !important;margin-right:auto !important;}
    .section--slideshow .slideshow__buttons{justify-content:flex-start !important;}
  }
</style>

