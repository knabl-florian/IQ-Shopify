  assign tx_cmp_heading = 'Alle Unterschiede auf einen Blick'
  assign tx_cmp_sub = 'Vergleiche Wetterschutz, Wärme, Ausstattung und Preis.'
  assign tx_row_wetter = 'Wetterschutz'
  assign tx_row_waerme = 'Wärme'
  assign tx_row_feat = 'Top-Features'
  assign tx_row_price = 'Preis'
  assign tx_zur = 'Zur Jacke'
  assign tx_ideal_label = 'Ideal für:'
  assign tx_wetter_label = 'Wetterschutz:'
  assign tx_waerme_label = 'Wärme:'
  assign tx_feat_label = 'Top-Features:'
