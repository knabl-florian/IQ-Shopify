    "custom_liquid_a9rfkH": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{%- assign iq_en = false -%}\n{%- if request.locale.iso_code == 'en' -%}\n  {%- assign iq_en = true -%}\n{%- endif -%}\n\n<style>\n.iq-insider,.iq-insider *{box-sizing:border-box}\n.iq-insider{background:#FFFFFF;color:#171717;font-family:Archivo,Arial,sans-serif}\n.iq-insider .iq-insider__inner.page-width{width:100%;max-width:1360px;margin:0 auto;padding:40px 20px;display:grid;gap:28px}\n.iq-insider .iq-insider__eyebrow{margin:0 0 12px;color:#A51D1B;font:700 12px/1.4 Archivo,Arial,sans-serif;letter-spacing:.2em;text-transform:uppercase}\n.iq-insider .iq-insider__heading{margin:0;font-family:Montserrat,Arial,sans-serif;font-style:italic;font-weight:800;font-size:clamp(26px,3vw,32px);line-height:1.15;letter-spacing:-.03em;text-transform:uppercase;color:#171717}\n.iq-insider .iq-insider__heading span{color:#A51D1B}\n.iq-insider .iq-insider__intro{max-width:48ch;margin:16px 0 0;font-size:15px;line-height:1.6;color:#52524F}\n.iq-insider .iq-insider__benefits{list-style:none;margin:20px 0 0;padding:0;display:grid;gap:10px}\n.iq-insider .iq-insider__benefits li{position:relative;margin:0;padding-left:26px;font-size:15px;line-height:1.5}\n.iq-insider .iq-insider__benefits li::before{content:\"→\";position:absolute;left:0;top:0;width:18px;color:#A51D1B;font:700 19px/1.18 Archivo,Arial,sans-serif}\n.iq-insider .iq-insider__benefits strong{font-weight:700}\n.iq-insider .iq-insider__form-area{min-width:0;margin:0;padding:0;background:transparent;color:#171717;border:0;border-radius:0;box-shadow:none}\n.iq-insider .iq-insider__form-area .iq-insider__eyebrow{color:#A51D1B}\n.iq-insider .iq-insider__offer{margin:0 0 20px;color:#171717;font:700 24px/1.2 Archivo,Arial,sans-serif;text-transform:none;letter-spacing:0}\n.iq-insider .iq-insider__form{width:100%;margin:0}\n.iq-insider .iq-insider__form-row{display:grid;gap:12px}\n.iq-insider .iq-insider__label{display:block;margin:0 0 8px;color:#171717;font-size:13.5px;line-height:1.4}\n.iq-insider .iq-insider__input{display:block;width:100%;min-width:0;min-height:52px;padding:14px 18px;border:1px solid #DCDBD7;border-radius:40px;background:#FFF;color:#171717;font:400 16px/1.4 Archivo,Arial,sans-serif;appearance:none}\n.iq-insider .iq-insider__input::placeholder{color:#666;opacity:1}\n.iq-insider .iq-insider__submit{display:flex;align-items:center;justify-content:center;gap:12px;width:100%;min-height:52px;padding:14px 18px;border:1px solid #A51D1B;border-radius:0;background:#A51D1B;color:#FFF;cursor:pointer;font:700 13px/1.5 Archivo,Arial,sans-serif;letter-spacing:.15em;text-transform:uppercase}\n.iq-insider .iq-insider__submit:hover{background:#851715;border-color:#851715}\n.iq-insider .iq-insider__input:focus-visible,.iq-insider .iq-insider__submit:focus-visible{outline:2px solid #171717;outline-offset:3px}\n.iq-insider .iq-insider__legal{margin-top:14px;font-size:12px;line-height:1.6;color:#62625D}\n.iq-insider .iq-insider__legal p{margin:0}\n.iq-insider .iq-insider__legal a{color:inherit;text-decoration:underline;text-underline-offset:3px}\n.iq-insider .iq-insider__message{margin:14px 0 0;font-size:14px;line-height:1.5;color:#171717}\n.iq-insider .iq-insider__message--error{color:#A51D1B}\n@media(min-width:990px){\n.iq-insider .iq-insider__heading span{display:block;margin-top:4px}\n.iq-insider .iq-insider__inner.page-width{padding:56px 32px;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:clamp(32px,4vw,64px);align-items:center}\n.iq-insider .iq-insider__form-area{padding:0}\n}\n</style>\n\n<section class=\"iq-insider\">\n  <div class=\"iq-insider__inner page-width\">\n\n    <div class=\"iq-insider__copy\">\n      <p class=\"iq-insider__eyebrow\">IQ INSIDER</p>\n      <h2 class=\"iq-insider__heading rich-text__heading h2\">\n        {% if iq_en %}More knowledge. <span>One step ahead.</span>{% else %}Mehr Wissen. <span>Früher dran.</span>{% endif %}\n      </h2>\n      <p class=\"iq-insider__intro\">\n        {% if iq_en %}Training insights, an early look at new drops and benefits reserved for IQ Insiders.\n        {% else %}Trainingswissen, neue Drops vorab und Vorteile, die nur IQ Insider bekommen.{% endif %}\n      </p>\n      <ul class=\"iq-insider__benefits\">\n        {% if iq_en %}\n          <li><strong>Training knowledge</strong> from real-world experience</li>\n          <li><strong>New drops</strong> — be among the first to hear</li>\n          <li><strong>Exclusive discounts</strong> for IQ Insiders</li>\n        {% else %}\n          <li><strong>Trainingswissen</strong> aus der Praxis</li>\n          <li><strong>Neue Drops</strong> vorab entdecken</li>\n          <li><strong>Exklusive Rabatte</strong> nur für IQ Insider</li>\n        {% endif %}\n      </ul>\n    </div>\n\n    <div class=\"iq-insider__form-area\">\n      <p class=\"iq-insider__eyebrow\">{% if iq_en %}Your welcome benefit{% else %}Dein Willkommensvorteil{% endif %}</p>\n      <h3 class=\"iq-insider__offer\">{% if iq_en %}10% to get started.{% else %}10 % zum Start.{% endif %}</h3>\n      {% assign iq_form_id = 'IQInsiderForm-' | append: section.id %}\n      {% form 'customer', id: iq_form_id, class: 'iq-insider__form' %}\n        <input type=\"hidden\" name=\"contact[tags]\" value=\"newsletter,homepage\">\n\n        <label for=\"IQInsiderEmail-{{ section.id }}\" class=\"iq-insider__label\">\n            {% if iq_en %}Email address{% else %}E-Mail-Adresse{% endif %}\n        </label>\n        <div class=\"iq-insider__form-row\">\n          <input\n            id=\"IQInsiderEmail-{{ section.id }}\"\n            class=\"iq-insider__input\"\n            type=\"email\" name=\"contact[email]\"\n            value=\"{% if customer %}{{ customer.email | escape }}{% endif %}\"\n            autocorrect=\"off\" autocapitalize=\"off\" autocomplete=\"email\" required\n            {% if form.errors %}aria-invalid=\"true\" aria-describedby=\"IQInsiderError-{{ section.id }}\"{% endif %}\n            placeholder=\"{% if iq_en %}Email address{% else %}E-Mail-Adresse{% endif %}\"\n          >\n          <button class=\"iq-insider__submit\" type=\"submit\">\n            {% if iq_en %}Become an IQ Insider <span aria-hidden=\"true\">→</span>{% else %}IQ Insider werden <span aria-hidden=\"true\">→</span>{% endif %}\n          </button>\n        </div>\n\n        {% if form.posted_successfully? %}\n          <p class=\"iq-insider__message iq-insider__message--success\" role=\"status\">\n            {% if iq_en %}Thank you. You're on the list.{% else %}Danke. Du bist dabei.{% endif %}\n          </p>\n        {% endif %}\n\n        {% if form.errors %}\n          <div id=\"IQInsiderError-{{ section.id }}\" class=\"iq-insider__message iq-insider__message--error\" role=\"alert\">\n            {{ form.errors | default_errors }}\n          </div>\n        {% endif %}\n\n        <div class=\"iq-insider__legal\">\n          {% if iq_en %}\n            <p>By signing up you accept our <a href=\"/en/policies/privacy-policy\">privacy policy</a>.</p>\n          {% else %}\n            <p>Mit Deiner Anmeldung akzeptierst Du unsere <a href=\"/policies/privacy-policy\">Datenschutzbestimmungen</a>.</p>\n          {% endif %}\n        </div>\n\n      {% endform %}\n    </div>\n\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 50,
        "padding_bottom": 50,
        "custom_class": ""
      }
    }
