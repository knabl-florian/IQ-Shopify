{% assign iq_part_1 = section.blocks | where: 'type', 'part1' | first %}
{% assign iq_part_2 = section.blocks | where: 'type', 'part2' | first %}
{% if collection.handle == 'zzz-hundesport-hosen-damen' %}
{% assign pants = all_products['iq-dogsport-hose-unisex'] %}
{% assign en = false %}{% if request.locale.iso_code == 'en' %}{% assign en = true %}{% endif %}
{% if pants != blank %}
<div class="iq-pants-block iq-pants-detail"><div class="iq-pants-grid">
<img class="iq-pants-photo" src="{{ iq_part_2.settings.image_url_21 | escape }}" width="900" height="900" style="aspect-ratio:1;object-fit:contain" loading="lazy" alt="{% if en %}Removable treat pouch on the IQ Trainer Pants{% else %}Herausnehmbare Futtertasche der IQ Trainer Pants{% endif %}">
<div><p class="iq-pants-kicker">{% if en %}{{ iq_part_1.settings.text_1 | escape }}{% else %}{{ iq_part_1.settings.text_2 | escape }}{% endif %}</p>
<h2>{% if en %}{{ iq_part_1.settings.text_3 | escape }}{% else %}{{ iq_part_1.settings.text_4 | escape }}{% endif %}</h2>
<article><h3>{% if en %}{{ iq_part_1.settings.text_5 | escape }}{% else %}{{ iq_part_1.settings.text_6 | escape }}{% endif %}</h3><p>{% if en %}{{ iq_part_1.settings.text_7 | escape }}{% else %}{{ iq_part_1.settings.text_8 | escape }}{% endif %}</p></article>
<article><h3>{% if en %}{{ iq_part_1.settings.text_9 | escape }}{% else %}{{ iq_part_1.settings.text_10 | escape }}{% endif %}</h3><p>{% if en %}{{ iq_part_1.settings.text_11 | escape }}{% else %}{{ iq_part_1.settings.text_12 | escape }}{% endif %}</p></article>

<article><h3>{% if en %}{{ iq_part_1.settings.text_13 | escape }}{% else %}{{ iq_part_1.settings.text_14 | escape }}{% endif %}</h3><p>{% if en %}{{ iq_part_1.settings.text_15 | escape }} <a href="{{ routes.root_url }}{% unless routes.root_url == '/' %}/{% endunless %}products/iq-modulare-futtertasche">{{ iq_part_1.settings.text_16 | escape }}</a>{{ iq_part_1.settings.text_17 | escape }}{% else %}{{ iq_part_1.settings.text_18 | escape }} <a href="{{ routes.root_url }}{% unless routes.root_url == '/' %}/{% endunless %}products/iq-modulare-futtertasche">{{ iq_part_1.settings.text_19 | escape }}</a> {{ iq_part_1.settings.text_20 | escape }}{% endif %}</p></article>
</div></div></div>
<style>.iq-pants-block{max-width:1180px;margin:0 auto;padding:40px 24px;color:#171717;font:400 16px/1.55 Archivo,sans-serif}.iq-pants-block *{box-sizing:border-box}.iq-pants-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}.iq-pants-block h2{font:800 italic clamp(28px,3vw,42px)/1.12 Montserrat,sans-serif;text-transform:uppercase;margin:0 0 20px}.iq-pants-block h3{font:700 20px/1.3 Archivo,sans-serif;margin:0 0 8px}.iq-pants-block p{margin:0 0 18px}.iq-pants-block .iq-pants-kicker{font:700 12px/1.4 Archivo,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:#A51D1B;margin-bottom:12px}.iq-pants-photo{display:block;width:100%;height:auto}.iq-pants-product{height:480px;object-fit:contain}.iq-pants-block ul{padding-left:20px;margin:20px 0}.iq-pants-block li{margin:8px 0}.iq-pants-block .iq-pants-price{font:700 24px/1.3 Archivo,sans-serif;margin:24px 0 12px}.iq-pants-cta{display:inline-flex;align-items:center;justify-content:center;background:#171717;color:#fff!important;padding:14px 24px;min-height:48px;text-decoration:none;font-weight:700}.iq-pants-cta:focus-visible{outline:3px solid #A51D1B;outline-offset:4px}.iq-pants-block .iq-pants-small{font-size:13px;margin-top:10px}.iq-pants-block a:not(.iq-pants-cta){color:inherit;text-underline-offset:4px}.iq-pants-detail{border-top:1px solid #DCDBD7}.iq-pants-detail article+article{border-top:1px solid #DCDBD7;margin-top:22px;padding-top:22px}.iq-pants-video{display:block;width:100%;max-height:640px;background:#171717;object-fit:contain;height:auto}.iq-pants-video-wrap{max-width:850px;margin:auto}.iq-pants-video-wrap h2{font-size:clamp(26px,3vw,36px)}@media(max-width:749px){.iq-pants-block{padding:28px 20px;font-size:15px}.iq-pants-grid{grid-template-columns:1fr;gap:24px}.iq-pants-product{height:330px}.iq-pants-block h2{font-size:28px}.iq-pants-cta{width:100%}.iq-pants-video{max-height:70vh}}</style>
{% endif %}
{% endif %}
