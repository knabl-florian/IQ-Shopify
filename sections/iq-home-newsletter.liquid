{{ 'iq-home-refresh.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign en = false
  if request.locale.iso_code == 'en'
    assign en = true
  endif
-%}
<section class="iqh iqh-newsletter"><div class="iqh-wrap iqh-newsletter-inner"><div class="iqh-newsletter-message"><p class="iqh-eyebrow">IQ Insider</p><h2 class="iqh-heading">{% if en and section.settings.heading_en != blank %}{{ section.settings.heading_en | escape }}{% else %}{{ section.settings.heading | escape }}{% endif %}{% if section.settings.heading_accent != blank %}<span class="iqh-newsletter-accent">{% if en and section.settings.heading_accent_en != blank %}{{ section.settings.heading_accent_en | escape }}{% else %}{{ section.settings.heading_accent | escape }}{% endif %}</span>{% endif %}</h2><p class="iqh-intro">{% if en and section.settings.intro_en != blank %}{{ section.settings.intro_en | escape }}{% else %}{{ section.settings.intro | escape }}{% endif %}</p><div class="iqh-newsletter-benefit"><div class="iqh-offer"><span class="iqh-offer-amount">{% if en and section.settings.offer_amount_en != blank %}{{ section.settings.offer_amount_en | escape }}{% else %}{{ section.settings.offer_amount | escape }}{% endif %}</span><p class="iqh-offer-label">{% if en and section.settings.offer_en != blank %}{{ section.settings.offer_en | escape }}{% else %}{{ section.settings.offer | escape }}{% endif %}</p></div><p class="iqh-offer-conditions">{% if en and section.settings.offer_conditions_en != blank %}{{ section.settings.offer_conditions_en | escape }}{% else %}{{ section.settings.offer_conditions | escape }}{% endif %}</p></div></div><div class="iqh-newsletter-form">{% assign form_id = 'IQHomeNewsletter-' | append: section.id %}{% form 'customer', id: form_id, class: 'iqh-signup' %}<input type="hidden" name="contact[tags]" value="newsletter,homepage"><label class="iqh-sr-only" for="Email-{{ section.id }}">{% if en %}Email address{% else %}E-Mail-Adresse{% endif %}</label><div class="iqh-signup-row"><input id="Email-{{ section.id }}" type="email" name="contact[email]" value="{{ customer.email | escape }}" autocomplete="email" autocapitalize="off" required placeholder="{% if en %}Your email address{% else %}Deine E-Mail-Adresse{% endif %}" {% if form.errors %}aria-invalid="true" aria-describedby="Errors-{{ section.id }}"{% endif %}><button class="iqh-pill" type="submit">{% if en and section.settings.cta_en != blank %}{{ section.settings.cta_en | escape }}{% else %}{{ section.settings.cta | escape }}{% endif %} <span aria-hidden="true">→</span></button></div><div class="iqh-legal">{% if en and section.settings.legal_en != blank %}{{ section.settings.legal_en }}{% else %}{{ section.settings.legal }}{% endif %}</div>{% if form.posted_successfully? %}<p role="status">{% if en %}Thank you. You're on the list.{% else %}Danke. Du bist dabei.{% endif %}</p>{% endif %}{% if form.errors %}<div id="Errors-{{ section.id }}" role="alert">{{ form.errors | default_errors }}</div>{% endif %}{% endform %}</div></div></section>
{% schema %}
{
  "name": "IQ Start · Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift · DE"
    },
    {
      "type": "text",
      "id": "heading_en",
      "label": "Überschrift · EN"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Zweite Zeile, rot · DE"
    },
    {
      "type": "text",
      "id": "heading_accent_en",
      "label": "Zweite Zeile, rot · EN"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Kurztext · DE"
    },
    {
      "type": "text",
      "id": "intro_en",
      "label": "Kurztext · EN"
    },
    {
      "type": "text",
      "id": "cta",
      "label": "Button · DE"
    },
    {
      "type": "text",
      "id": "cta_en",
      "label": "Button · EN"
    },
    {
      "type": "text",
      "id": "offer_amount",
      "label": "Großer Vorteil · DE"
    },
    {
      "type": "text",
      "id": "offer_amount_en",
      "label": "Großer Vorteil · EN"
    },
    {
      "type": "textarea",
      "id": "offer",
      "label": "Text neben dem Vorteil · DE"
    },
    {
      "type": "textarea",
      "id": "offer_en",
      "label": "Text neben dem Vorteil · EN"
    },
    {
      "type": "richtext",
      "id": "legal",
      "label": "Datenschutztext · DE"
    },
    {
      "type": "richtext",
      "id": "legal_en",
      "label": "Datenschutztext · EN"
    },
    {
      "type": "text",
      "id": "offer_conditions",
      "label": "Rabattbedingungen · DE"
    },
    {
      "type": "text",
      "id": "offer_conditions_en",
      "label": "Rabattbedingungen · EN"
    }
  ],
  "presets": [
    {
      "name": "IQ Start · Newsletter"
    }
  ]
}
{% endschema %}