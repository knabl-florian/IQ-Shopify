    "custom_liquid_9jBVn8": {
      "type": "custom-liquid",
      "name": "Kategorien Final",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  IQ Kategorien - fertiger Block fuer \"Benutzerdefiniertes Liquid\"\n  Alles fest eingebaut: Bilder (aus Shopify Files), Links, Labels, Alt-Texte.\n\n  AENDERUNG:\n  - Heading visuell deutlich gewichtiger\n  - Schwarz/Rot-Akzent: nur \"Training?\" in IQ Rot\n  - H2 bleibt H2\n  - Wortlaut bleibt identisch\n  - Restlicher Kategorienblock unverändert\n{%- endcomment -%}\n\n{%- assign labels = 'iq_translation.home.categories' | t | replace: '&amp;', '&' | split: '|' -%}\n{%- assign handles = 'hundesport-westen|hundesport-jacken|hundesport-t-shirts-hoodies|hundesport-trainingszubehoer|trainingsfutter-supplemente|hundesport-spielzeug' | split: '|' -%}\n{%- assign files = 'kategorie-westen-iq-dogsport_jpg.jpg|kategorie-jacken-iq-dogsport.jpg|kategorie-shirts-hoodies-iq-dogsport.jpg|kategorie-training-iq-dogsport.jpg|kategorie-futter-iq-dogsport_jpg.jpg|kategorie-spielzeug-iq-dogsport_jpg.jpg' | split: '|' -%}\n{%- assign alts = 'iq_translation.home.category_alts' | t | split: '|' -%}\n\n<style>\n  #shopify-section-{{ section.id }} .iq-catcar {\n    box-sizing: border-box;\n  }\n\n  /* =========================================================\n     HEADING\n     ========================================================= */\n\n  #shopify-section-{{ section.id }} .iq-catcar__heading {\n    box-sizing: border-box;\n\n    margin: 0 20px 22px;\n\n    font-family: var(--font-heading-family, 'Montserrat'), sans-serif;\n    font-style: italic;\n    font-weight: 800;\n    text-transform: uppercase;\n\n    font-size: 32px;\n    line-height: 1.02;\n    letter-spacing: -0.35px;\n\n    color: rgb(var(--color-foreground, 23,23,23));\n  }\n\n  #shopify-section-{{ section.id }} .iq-catcar__heading-main {\n    color: rgb(var(--color-foreground, 23,23,23));\n  }\n\n  #shopify-section-{{ section.id }} .iq-catcar__heading-accent {\n    color: #A51D1B;\n  }\n\n  /* =========================================================\n     MOBILE: horizontaler Swipe\n     ========================================================= */\n\n  #shopify-section-{{ section.id }} .iq-catcar__scroll {\n    box-sizing: border-box;\n\n    display: grid;\n    grid-auto-flow: column;\n    grid-auto-columns: 82vw;\n\n    gap: 12px;\n\n    overflow-x: auto;\n\n    scroll-snap-type: x mandatory;\n    scroll-padding-inline: 20px;\n\n    padding-inline: 20px;\n\n    -webkit-overflow-scrolling: touch;\n    overscroll-behavior-inline: contain;\n\n    scrollbar-width: none;\n  }\n\n  #shopify-section-{{ section.id }} .iq-catcar__scroll::-webkit-scrollbar {\n    display: none;\n  }\n\n  #shopify-section-{{ section.id }} .iq-catcar__card {\n    box-sizing: border-box;\n\n    position: relative;\n    display: block;\n\n    aspect-ratio: 4 / 5;\n\n    overflow: hidden;\n\n    border-radius: 0;\n\n    scroll-snap-align: start;\n    scroll-snap-stop: normal;\n\n    text-decoration: none;\n    color: #fff;\n\n    background: #111;\n  }\n\n  #shopify-section-{{ section.id }} .iq-catcar__img {\n    position: absolute;\n    inset: 0;\n\n    width: 100%;\n    height: 100%;\n\n    object-fit: cover;\n    display: block;\n  }\n\n  #shopify-section-{{ section.id }} .iq-catcar__scrim {\n    position: absolute;\n    inset: 0;\n\n    pointer-events: none;\n\n    background:\n      linear-gradient(\n        to top,\n        rgba(0,0,0,0.62) 0%,\n        rgba(0,0,0,0.28) 35%,\n        rgba(0,0,0,0.00) 60%\n      );\n  }\n\n  #shopify-section-{{ section.id }} .iq-catcar__text {\n    position: absolute;\n\n    left: 18px;\n    right: 18px;\n    bottom: 18px;\n\n    display: flex;\n    flex-direction: column;\n\n    gap: 2px;\n  }\n\n  #shopify-section-{{ section.id }} .iq-catcar__label {\n    font-family: var(--font-heading-family, 'Montserrat'), sans-serif;\n\n    font-style: italic;\n    font-weight: 800;\n    text-transform: uppercase;\n\n    font-size: clamp(23px, 5.5vw, 26px);\n    line-height: 1.05;\n  }\n\n  #shopify-section-{{ section.id }} .iq-catcar__cta {\n    font-family: var(--font-body-family, 'Archivo'), sans-serif;\n\n    font-weight: 500;\n    font-size: 15px;\n  }\n\n  #shopify-section-{{ section.id }} .iq-catcar__arrow {\n    display: inline-block;\n\n    transition: transform .25s ease;\n  }\n\n  #shopify-section-{{ section.id }} .iq-catcar__card:focus-visible {\n    outline: 3px solid #fff;\n    outline-offset: -3px;\n  }\n\n  /* =========================================================\n     TABLET: 2 Spalten\n     ========================================================= */\n\n  @media (min-width: 750px) {\n\n    #shopify-section-{{ section.id }} .iq-catcar__heading {\n      margin-inline: 24px;\n\n      font-size: 38px;\n      margin-bottom: 24px;\n    }\n\n    #shopify-section-{{ section.id }} .iq-catcar__scroll {\n      grid-auto-flow: row;\n\n      grid-template-columns:\n        repeat(2, minmax(0, 1fr));\n\n      grid-auto-columns: auto;\n\n      gap: 18px;\n\n      overflow: visible;\n\n      scroll-snap-type: none;\n\n      padding-inline: 24px;\n    }\n\n    #shopify-section-{{ section.id }} .iq-catcar__cta {\n      font-size: 16px;\n    }\n  }\n\n  /* =========================================================\n     DESKTOP: 3 x 2\n     ========================================================= */\n\n  @media (min-width: 990px) {\n\n    #shopify-section-{{ section.id }} .iq-catcar__heading {\n      max-width: 1360px;\n\n      margin:\n        0\n        auto\n        28px;\n\n      padding-inline: 32px;\n\n      font-size: clamp(44px, 3.7vw, 50px);\n      line-height: 1.0;\n      letter-spacing: -0.6px;\n    }\n\n    #shopify-section-{{ section.id }} .iq-catcar__scroll {\n      grid-template-columns:\n        repeat(3, minmax(0, 1fr));\n\n      column-gap: 24px;\n      row-gap: 30px;\n\n      max-width: 1360px;\n\n      margin-inline: auto;\n\n      padding-inline: 32px;\n    }\n\n    #shopify-section-{{ section.id }} .iq-catcar__label {\n      font-size: clamp(26px, 2vw, 30px);\n    }\n\n    #shopify-section-{{ section.id }} .iq-catcar__img {\n      transition: transform .25s ease;\n    }\n\n    #shopify-section-{{ section.id }} .iq-catcar__card:hover .iq-catcar__img {\n      transform: scale(1.015);\n    }\n\n    #shopify-section-{{ section.id }} .iq-catcar__card:hover .iq-catcar__arrow {\n      transform: translateX(3px);\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n\n    #shopify-section-{{ section.id }} .iq-catcar__img,\n    #shopify-section-{{ section.id }} .iq-catcar__arrow {\n      transition: none !important;\n    }\n\n    #shopify-section-{{ section.id }} .iq-catcar__card:hover .iq-catcar__img {\n      transform: none !important;\n    }\n  }\n</style>\n\n\n<div class=\"iq-catcar\">\n\n  <h2 class=\"iq-catcar__heading\">\n    <span class=\"iq-catcar__heading-main\">\n      {{ 'iq_translation.home.heading_main' | t }}\n    </span>\n    <span class=\"iq-catcar__heading-accent\">\n      {{ 'iq_translation.home.heading_accent' | t }}\n    </span>\n  </h2>\n\n\n  <div class=\"iq-catcar__scroll\">\n\n    {%- for i in (0..5) -%}\n\n      {%- assign imgbase = files[i] | file_url -%}\n      {%- assign category_handle = handles[i] -%}\n      {%- assign category_collection = collections[category_handle] -%}\n\n      <a\n        class=\"iq-catcar__card\"\n        href=\"{{ category_collection.url }}\"\n      >\n\n        <img\n          class=\"iq-catcar__img\"\n\n          src=\"{{ imgbase }}&width=1000\"\n\n          srcset=\"\n            {{ imgbase }}&width=400 400w,\n            {{ imgbase }}&width=600 600w,\n            {{ imgbase }}&width=800 800w,\n            {{ imgbase }}&width=1000 1000w,\n            {{ imgbase }}&width=1200 1200w\n          \"\n\n          sizes=\"\n            (min-width: 990px) 30vw,\n            (min-width: 750px) 45vw,\n            82vw\n          \"\n\n          width=\"2000\"\n          height=\"2500\"\n\n          loading=\"lazy\"\n\n          alt=\"{{ alts[i] | escape }}\"\n        >\n\n        <span\n          class=\"iq-catcar__scrim\"\n          aria-hidden=\"true\"\n        ></span>\n\n        <span class=\"iq-catcar__text\">\n\n          <span class=\"iq-catcar__label\">\n            {{ labels[i] | escape }}\n          </span>\n\n          <span class=\"iq-catcar__cta\">\n            {{ 'iq_translation.home.discover' | t }}\n            <span\n              class=\"iq-catcar__arrow\"\n              aria-hidden=\"true\"\n            >\n              &rarr;\n            </span>\n          </span>\n\n        </span>\n\n      </a>\n\n    {%- endfor -%}\n\n  </div>\n\n</div>",
        "color_scheme": "scheme-2",
        "padding_top": 40,
        "padding_bottom": 28,
        "custom_class": ""
      }
    },
