{% assign iq_part_1 = section.blocks | where: 'type', 'part1' | first %}
{% assign iq_part_2 = section.blocks | where: 'type', 'part2' | first %}
{% assign pants = all_products['iq-dogsport-hose-unisex'] %}
{% assign en = false %}{% if request.locale.iso_code == 'en' %}{% assign en = true %}{% endif %}
{% assign film = section.settings.video | default: pants.media.first %}
{% if section.settings.video == blank %}{% assign film = pants.media | where: 'media_type', 'video' | first %}{% endif %}
{% assign poster_url = iq_part_2.settings.image_url_21 %}
{% if section.settings.poster != blank %}{% assign poster_url = section.settings.poster | image_url: width: 1200 %}{% endif %}
{% if pants != blank %}
<section class="iq-pants-feature page-width iq-collection-container"><div class="iq-pants-feature-grid">
<div class="iq-pants-feature-media">
{% if film != blank %}{% assign desktop_source = film.sources | where: 'format', 'mp4' | sort: 'height' | last %}{% assign mobile_film = pants.media | where: 'media_type', 'video' | first %}{% assign mobile_source = mobile_film.sources | where: 'format', 'mp4' | sort: 'height' | last %}
<iq-pants-feature-video>
<video id="IQPantsFeature-{{ section.id }}" controls playsinline preload="none" poster="{{ poster_url | escape }}" width="900" height="900" aria-label="{% if en %}IQ Trainer Pants product video{% else %}IQ Trainer Pants Produktvideo{% endif %}">
{% if mobile_source != blank %}<source media="(max-width:749px)" src="{{ mobile_source.url | escape }}" type="{{ mobile_source.mime_type | escape }}">{% endif %}
<source src="{{ desktop_source.url | escape }}" type="{{ desktop_source.mime_type | escape }}">
</video>
<div class="iq-pants-feature-cover" hidden><img src="{{ poster_url | escape }}" width="900" height="900" loading="lazy" alt="{% if en %}Removable treat pouch on the IQ Trainer Pants{% else %}Herausnehmbare Futtertasche der IQ Trainer Pants{% endif %}"><button type="button" aria-controls="IQPantsFeature-{{ section.id }}" aria-label="{% if en %}{{ section.settings.play_en | escape }}{% else %}{{ section.settings.play_de | escape }}{% endif %}"><svg width="28" height="28" viewBox="0 0 28 28" fill="currentColor" aria-hidden="true"><path d="M9 5L24 14L9 23Z"/></svg></button></div>
</iq-pants-feature-video>
{% else %}<img src="{{ poster_url | escape }}" width="900" height="900" loading="lazy" alt="{{ pants.title | escape }}">{% endif %}
</div>
<div class="iq-pants-feature-copy"><p class="iq-pants-kicker">{% if en %}{{ iq_part_1.settings.text_1 | escape }}{% else %}{{ iq_part_1.settings.text_2 | escape }}{% endif %}</p>
<h2>{% if en %}{{ iq_part_1.settings.text_3 | escape }}{% else %}{{ iq_part_1.settings.text_4 | escape }}{% endif %}</h2>
<article><h3>{% if en %}{{ iq_part_1.settings.text_5 | escape }}{% else %}{{ iq_part_1.settings.text_6 | escape }}{% endif %}</h3><p>{% if en %}{{ iq_part_1.settings.text_7 | escape }}{% else %}{{ iq_part_1.settings.text_8 | escape }}{% endif %}</p></article>
<article><h3>{% if en %}{{ iq_part_1.settings.text_9 | escape }}{% else %}{{ iq_part_1.settings.text_10 | escape }}{% endif %}</h3><p>{% if en %}{{ iq_part_1.settings.text_11 | escape }}{% else %}{{ iq_part_1.settings.text_12 | escape }}{% endif %}</p></article>

<article><h3>{% if en %}{{ iq_part_1.settings.text_13 | escape }}{% else %}{{ iq_part_1.settings.text_14 | escape }}{% endif %}</h3><p>{% if en %}{{ iq_part_1.settings.text_15 | escape }} <a href="{{ routes.root_url }}{% unless routes.root_url == '/' %}/{% endunless %}products/iq-modulare-futtertasche">{{ iq_part_1.settings.text_16 | escape }}</a>{{ iq_part_1.settings.text_17 | escape }}{% else %}{{ iq_part_1.settings.text_18 | escape }} <a href="{{ routes.root_url }}{% unless routes.root_url == '/' %}/{% endunless %}products/iq-modulare-futtertasche">{{ iq_part_1.settings.text_19 | escape }}</a> {{ iq_part_1.settings.text_20 | escape }}{% endif %}</p></article>
<a class="iq-pants-feature-cta" href="{{ pants.url }}">{% if en %}{{ section.settings.cta_en | escape }}{% else %}{{ section.settings.cta_de | escape }}{% endif %} →</a></div></div></section>{% endif %}
{% stylesheet %}
.iq-pants-feature{padding-top:32px;padding-bottom:40px;color:#171717;font:400 16px/1.55 Archivo,sans-serif}
.iq-pants-feature *{box-sizing:border-box}
.iq-pants-feature-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:center}
.iq-pants-feature-media{aspect-ratio:1;min-width:0;background:#171717}
iq-pants-feature-video{display:block;position:relative;width:100%;height:100%}
.iq-pants-feature-media video{display:block;width:100%;height:100%;object-fit:contain}
.iq-pants-feature-cover{position:absolute;inset:0}
.iq-pants-feature-cover[hidden]{display:none}
.iq-pants-feature-media img{display:block;width:100%;height:100%;object-fit:cover}
.iq-pants-feature-cover button{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:64px;height:64px;min-width:0;padding:0;display:flex;justify-content:center;align-items:center;border-radius:50%;border:2px solid #FFFFFF;background:#171717;color:#FFFFFF;cursor:pointer}
.iq-pants-feature-cover button svg{width:28px;height:28px;flex:0 0 28px}
.iq-pants-feature h2{font:italic 800 clamp(28px,3vw,38px)/1.12 Montserrat,sans-serif;text-transform:uppercase;margin:0 0 24px}
.iq-pants-feature h3{font:700 18px/1.3 Archivo,sans-serif;margin:0 0 6px;text-transform:none}
.iq-pants-feature p{margin:0}
.iq-pants-feature .iq-pants-kicker{font:700 12px/1.4 Archivo,sans-serif;letter-spacing:.1em;text-transform:uppercase;color:#A51D1B;margin-bottom:12px}
.iq-pants-feature article+article{margin-top:18px}
.iq-pants-feature-copy a:not(.iq-pants-feature-cta){color:inherit;text-decoration:underline;text-underline-offset:3px}
.iq-pants-feature-cta{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 24px;margin-top:24px;border:1px solid #A51D1B;border-radius:999px;background:#A51D1B;color:#FFFFFF;text-decoration:none;font:700 14px/1.4 Archivo,sans-serif}
.iq-pants-feature a:focus-visible,.iq-pants-feature button:focus-visible{outline:3px solid #A51D1B;outline-offset:4px}
@media(max-width:749px){.iq-pants-feature{padding-top:24px;padding-bottom:28px;font-size:15px}.iq-pants-feature-grid{grid-template-columns:1fr;gap:24px}.iq-pants-feature-media{aspect-ratio:4/3}.iq-pants-feature h2{font-size:28px}.iq-pants-feature-cta{width:100%}}
{% endstylesheet %}
{% javascript %}
if(!customElements.get('iq-pants-feature-video')){customElements.define('iq-pants-feature-video',class extends HTMLElement{
connectedCallback(){if(this.bound)return;this.bound=true;this.video=this.querySelector('video');this.cover=this.querySelector('.iq-pants-feature-cover');this.button=this.querySelector('button');this.media=matchMedia('(max-width:749px)');this.choose=()=>{const source=Array.from(this.video.querySelectorAll('source')).find(s=>!s.media||matchMedia(s.media).matches);if(source&&this.video.getAttribute('src')!==source.getAttribute('src')){this.video.src=source.getAttribute('src');this.video.load();}};this.onChange=()=>{this.video.pause();this.choose();this.cover.hidden=false;};this.choose();this.cover.hidden=false;this.media.addEventListener('change',this.onChange);this.button.addEventListener('click',()=>{this.choose();this.cover.hidden=true;this.video.play().catch(()=>{this.cover.hidden=false;});});this.video.addEventListener('ended',()=>{this.cover.hidden=false;});}
disconnectedCallback(){this.media?.removeEventListener('change',this.onChange);this.bound=false;}
});}
{% endjavascript %}
