              assign w2 = 'windproof'
              assign w3 = 'taped seams'
              assign heat_label = 'unlined · extra warmth with the optional Zip-In'
              assign f1 = 'Patented chest pocket'
              assign f2 = 'Compatible with the optional IQ ball pocket'
              assign f3 = 'Loops for the IQ modular treat pouch'
              assign ideal = 'Focused dog training with the features of a dog training vest.'
            endif
          elsif hh contains 'allround'
            assign short_title = 'Allround Jacke'
            assign use = 'Leichter Regenschutz'
            assign desc = 'Leichte Regenjacke mit herausnehmbaren, abwaschbaren Futtertaschen, Clicker-Fach und verstecktem Kotbeutelspender.'
            assign notfor = 'Keine Winterjacke.'
            assign link_label = 'Allround Jacke ansehen'
            assign search_q = 'Allround Jacke'
            assign w1 = 'wasserdicht'
            assign w2 = 'winddicht'
            assign w3 = 'wasserdichte Nähte'
            assign heat_dots = '●○○○'
            assign heat_label = 'ungefüttert'
            assign f1 = 'Herausnehmbare XL-Futtertaschen'
            assign f2 = 'Clicker- & Kotbeutelfach'
            assign f3 = 'Große Rückentasche'
            assign ideal = 'Aktive Zeit mit Hund bei Regen und milden Temperaturen.'
            if lang == 'en'
              # EN: offizielle Übersetzung (translationsRegister) hier eintragen
              assign short_title = 'Allround Jacket'
              assign use = 'Lightweight rain protection'
              assign search_q = 'Allround'
              assign desc = 'A lightweight rain jacket with removable, wipe-clean treat pockets, a clicker pocket and a concealed waste-bag dispenser.'
              assign notfor = 'Not a winter jacket.'
              assign link_label = 'View Allround Jacket'
              assign w1 = 'waterproof'
              assign w2 = 'windproof'
              assign w3 = 'waterproof seams'
              assign heat_label = 'unlined'
              assign f1 = 'Removable XL treat pockets'
              assign f2 = 'Clicker & poop-bag pocket'
              assign f3 = 'Large rear pocket'
              assign ideal = 'Active days with your dog in rain and mild weather.'
            endif
          elsif hh contains 'softshell'
            assign short_title = 'Softshell 2.0'
            assign use = 'Training & Verein'
            assign desc = 'Beweglich und leicht wärmend für die Übergangszeit.'
            assign notfor = 'Nicht für Dauerregen oder starke Kälte.'
            assign link_label = 'Softshell ansehen'
            assign search_q = 'Softshelljacke 2.0'
            assign w1 = 'wasserabweisend'
            assign w2 = 'winddicht'
            assign w3 = 'atmungsaktiv'
            assign heat_dots = '●●○○'
            assign heat_label = 'Innenfleece'
            assign f1 = 'Seitliche Mesh-Einsätze'
            assign f2 = 'Reflektierende Logos'
            assign f3 = 'Ideal als Teamjacke'
            assign ideal = 'Verein, Wettkampf und Übergangszeit.'
            if lang == 'en'
              # EN: offizielle Übersetzung (translationsRegister) hier eintragen
              assign use = 'Training & club'
              assign search_q = 'Softshell 2.0'
              assign desc = 'Flexible and lightly warming for the changing seasons.'
              assign notfor = 'Not for continuous rain or severe cold.'
              assign link_label = 'View Softshell'
              assign w1 = 'water-repellent'
              assign w2 = 'windproof'
              assign w3 = 'breathable'
              assign heat_label = 'inner fleece'
